KEYWORD_DIR = "/usr/local/share/hexwalk/keywords"

DOMAIN_RE = re.compile(r'^(\d+)_([a-zA-Z0-9_-]+)$')

COLOR_CAT = 1
COLOR_HIT = 2
COLOR_HIGHLIGHT = 3
COLOR_STATUS = 4
COLOR_TOPHEADER = 5
COLOR_HEADER = 6

COLOR_CAT_COL1 = curses.COLOR_CYAN
COLOR_CAT_COL2 = -1
COLOR_HIT_COL1 = curses.COLOR_YELLOW
COLOR_HIT_COL2 = -1
COLOR_HIGHLIGHT_COL1 = curses.COLOR_BLACK
COLOR_HIGHLIGHT_COL2 = curses.COLOR_GREEN
COLOR_STATUS_COL1 = curses.COLOR_WHITE
COLOR_STATUS_COL2 = curses.COLOR_BLUE
COLOR_TOPHEADER_COL1 = curses.COLOR_WHITE
COLOR_TOPHEADER_COL2 = curses.COLOR_BLUE
COLOR_HEADER_COL1 = curses.COLOR_WHITE
COLOR_HEADER_COL2 = curses.COLOR_BLACK


CAT_W = 32
DETAILS_W = 50
HITS_MIN_W = 10
SEP = 2

# ---------------- HEX FILE PARSER -----------------
def is_hex_file(file_path):
    try:
        with open(file_path, "rb") as f:
            for _ in range(10):  # only check first few lines
                line = f.readline()
                if not line:
                    break
                line = line.strip()
                if line:
                    return line.startswith(b":")
    except OSError:
        return False
    return False

def is_elf(binary):
    return binary.startswith(b"\x7fELF")

def load_binary(file_path):
    """Load a file as raw binary."""
    with open(file_path,"rb") as f:
        return f.read()

def hex_to_bin(file_path):
    """
    Convert an Intel HEX file to a flat binary image.

    Supports:
      - Data records (00)
      - End Of File (01)
      - Extended Linear Address (04)

    Unsupported record types are ignored safely.
    """
    memory = bytearray()
    max_addr = 0
    base_addr = 0  # Upper 16 bits from type 04 records

    with open(file_path, "r", encoding="ascii", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line.startswith(":"):
                continue

            try:
                byte_count = int(line[1:3], 16)
                address = int(line[3:7], 16)
                record_type = int(line[7:9], 16)
                data = line[9:9 + byte_count * 2]
            except ValueError:
                continue

            # ----- Data record -----
            if record_type == 0x00:
                abs_addr = base_addr + address
                bytes_data = bytes(
                    int(data[i:i + 2], 16)
                    for i in range(0, len(data), 2)
                )

                end_addr = abs_addr + len(bytes_data)
                if len(memory) < end_addr:
                    memory.extend(b"\x00" * (end_addr - len(memory)))

                memory[abs_addr:end_addr] = bytes_data
                max_addr = max(max_addr, end_addr)

            # ----- End Of File -----
            elif record_type == 0x01:
                break

            # ----- Extended Linear Address -----
            elif record_type == 0x04:
                base_addr = int(data, 16) << 16

            # ----- Ignore other record types safely -----
            else:
                continue

    return bytes(memory[:max_addr])

# ---------------- EXPORT HELPERS -----------------
def keywords_to_findings(keywords):
    """
    Convert keyword list into the rule structure expected by search_keywords().
    """
    findings = defaultdict(list)

    for kw in keywords:
        category = f"{kw['domain']}/{kw['subcategory']}"

        findings[category].append({
            "type": "plain",
            "pattern": kw["value"],
            "raw": kw["value"],
        })

    return dict(findings)

def generate_metadata(file_path, findings):
    total_hits = sum(len(hits) for hits in findings.values())

    return {
        "tool": "hexwalk",
        "version": HEXWALK_VERSION,
        "file": os.path.basename(file_path),
        "file_path": os.path.abspath(file_path),
        "file_size": os.path.getsize(file_path),
        "date": datetime.now().astimezone().isoformat(),
        "categories": len(findings),
        "total_hits": total_hits,
    }

def write_export(findings, filename, file_path):
    out = f"hexwalk_{filename}_export.json"

    safe_findings = make_findings_json_safe(findings)
    meta = generate_metadata(file_path, findings)

    export_obj = {
        "metadata": meta,
        "findings": safe_findings,
    }

    with open(out, "w", encoding="utf-8") as f:
        json.dump(export_obj, f, indent=2)

    return out

def write_summary(summary_text, filename):
    out = f"hexwalk_{filename}_summary.txt"
    with open(out, "w", encoding="utf-8") as f:
        f.write(summary_text)
    return out

def generate_summary_text(findings, filename, file_path):
    meta = generate_metadata(file_path, findings)

    lines = []
    lines.append("Hexwalk Summary")
    lines.append("=" * 60)
    lines.append(f"File        : {meta['file']}")
    lines.append(f"Path        : {meta['file_path']}")
    lines.append(f"File size   : {meta['file_size']} bytes")
    lines.append(f"Date (UTC)  : {meta['date']}")
    lines.append(f"Categories  : {meta['categories']}")
    lines.append(f"Total hits  : {meta['total_hits']}")
    lines.append("=" * 60)
    lines.append("")

    for cat, hits in sorted(findings.items()):
        lines.append(f"{cat} ({len(hits)} hits)")

        keywords = {}
        for h in hits:
            k = h["match_key"]
            keywords[k] = keywords.get(k, 0) + 1

        for k, count in sorted(keywords.items(), key=lambda x: -x[1]):
            lines.append(f"  {k}: {count}")

        lines.append("")

    return "\n".join(lines)

def make_findings_json_safe(findings):
    safe = {}

    for cat, hits in findings.items():
        safe_hits = []
        for h in hits:
            safe_hit = h.copy()

            # Fix context
            ctx = h.get("context", {}).copy()
            if "bytes" in ctx:
                ctx["bytes_hex"] = ctx["bytes"].hex()
                del ctx["bytes"]

            safe_hit["context"] = ctx
            safe_hits.append(safe_hit)

        safe[cat] = safe_hits

    return safe

# ---------------- KEYWORDS -----------------
def load_keywords(base_dir: str):
    """
    Load keywords from keywords/<domain>/<subcategory>.txt
    Deduplicate globally (first occurrence wins).
    """
    base = Path(base_dir)
    keywords = []
    seen = set()

    for domain_dir in sorted(p for p in base.iterdir() if p.is_dir()):
        domain = domain_dir.name

        for file in sorted(domain_dir.glob("*.txt")):
            subcategory = file.stem

            with file.open(encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue

                    key = line.lower()
                    if key in seen:
                        continue

                    seen.add(key)

                    keywords.append({
                        "value": line,
                        "domain": domain,
                        "subcategory": subcategory,
                        "source": str(file),
                    })

    return keywords

# ---------------- SEARCH -----------------
def search_keywords(binary, findings):
    results = {}
    text = binary.decode("latin1", errors="ignore")

    for cat, rules in findings.items():
        cat_hits = []

        for rule in rules:
            try:
                if rule["type"] == "regex":
                    # Regex rules: user controls flags
                    pat = re.compile(rule["pattern"])
                else:
                    # Plain keywords: case-insensitive
                    pat = re.compile(
                        re.escape(rule["pattern"]),
                        re.IGNORECASE
                    )
            except re.error:
                continue

            for m in pat.finditer(text):
                s = m.group()
                off = m.start()

                start_context = max(0, off - 32)
                end_context = min(len(binary), off + len(s) + 32)
                context_bytes = binary[start_context:end_context]

                context_ascii = "".join(
                    chr(b) if 32 <= b <= 126 else "."
                    for b in context_bytes
                )

                cat_hits.append({
                    "string": context_ascii,
                    "match_key": rule["raw"],
                    "match_span": m.span(),
                    "match_type": rule["type"],
                    "context": {
                        "offset": off,
                        "bytes": context_bytes,
                    },
                })

        if cat_hits:
            results[cat] = cat_hits

    return results

# ---------------- OD STYLE -----------------
def od_bc_view(data, offset, keyword, context=64):
    start = max(0, offset - context)
    end = min(len(data), offset + context)

    lines = []
    BYTES_PER_LINE = 8

    for i in range(start, end, BYTES_PER_LINE):
        chunk = data[i:i + BYTES_PER_LINE]

        # Offset
        line = f"{i:08X}  "

        # Hex bytes
        hex_part = " ".join(f"{b:02X}" for b in chunk)
        hex_part = hex_part.ljust(BYTES_PER_LINE * 3 - 1)

        # ASCII
        ascii_part = "".join(chr(b) if 32 <= b <= 126 else "." for b in chunk)

        # Highlight keyword (ASCII only)
#        if keyword in ascii_part:
#            ascii_part = ascii_part.replace(keyword, f"<[{keyword}]>")

        line += hex_part + "  " + ascii_part
        lines.append(line)

    return lines

# ---------------- TUI -----------------
class HexwalkTUI:
    def __init__(self,stdscr,findings,binary,filename,file_path,keywords,show_all=False):
        self.keywords = keywords
        self.show_all = show_all
        self.stdscr = stdscr
        self.findings = findings
        self.filename = filename
        self.file_path = file_path
        self.binary = binary
        self.tree_filter = None
        self.categories = sorted(findings.keys())
        self.category_tree = self.build_domain_tree()
        self.cat_i = 0
        self.cat_offset = 0
        self.category_scroll_state = {}
        self.subcategory_keyword_state = {}
        self.domain_subcategory_state = {}
        self.pane = 0
        self.hit_i = 0
        self.hit_offset = 0
        self.filter_text = ""
        self.details_visible = True
        self.details_width = 48
        self.init_curses()
        self.main_loop()

    def init_curses(self):
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(COLOR_CAT, COLOR_CAT_COL1, COLOR_CAT_COL2)
        curses.init_pair(COLOR_HIT, COLOR_HIT_COL1, COLOR_HIT_COL2)
        curses.init_pair(COLOR_HIGHLIGHT, COLOR_HIGHLIGHT_COL1, COLOR_HIGHLIGHT_COL2)
        curses.init_pair(COLOR_STATUS, COLOR_STATUS_COL1, COLOR_STATUS_COL2) 
        curses.init_pair(COLOR_TOPHEADER, COLOR_TOPHEADER_COL1, COLOR_TOPHEADER_COL2)
        curses.init_pair(COLOR_HEADER, COLOR_HEADER_COL1, COLOR_HEADER_COL2)
        self.stdscr.keypad(True)

    # ---------------- HELPERS -----------------
    def format_top_header(self):
        parts = [
            f"Hexwalk v{HEXWALK_VERSION}",
            f"File: {self.file_path}",
        ]

        if self.tree_filter:
            parts.append(f"Filter: {self.tree_filter}")

        return " | ".join(parts)

    def find_subcategory_row_index(self, domain, subcat):
        """
        Find the row index of a given subcategory in the visible tree.
        """
        rows = self.visible_category_rows()
        target = f"{domain}/{subcat}"
    
        for i, node in enumerate(rows):
            if (
                node["type"] == "subcategory"
                and node["parent"] == domain
                and node["name"] == subcat
            ):
                return i
        return None

    def build_domain_tree(self):
        """
        Build a hierarchical tree with FILTER-AWARE counts.
    
        Rules:
        - Keyword filter (/) is applied FIRST
        - Subcategory count = sum of VISIBLE keyword hit counts
        - Domain count = sum of VISIBLE subcategory counts
        - Empty branches hidden unless --show-all
        """
    
        tree = []
        tree_filter = self.tree_filter.lower() if self.tree_filter else None
    
        # --------------------------------------------------
        # Group keywords (single source of truth)
        # --------------------------------------------------
        grouped_keywords = defaultdict(lambda: defaultdict(list))
        for kw in self.keywords:
            grouped_keywords[kw["domain"]][kw["subcategory"]].append(kw["value"])
    
        # --------------------------------------------------
        # Group hits
        # --------------------------------------------------
        hit_map = defaultdict(lambda: defaultdict(list))
        for cat, hits in self.findings.items():
            domain, subcat = cat.split("/", 1)
            hit_map[domain][subcat].extend(hits)
    
        # --------------------------------------------------
        # Build tree
        # --------------------------------------------------
        for domain in sorted(grouped_keywords):
            domain_children = []
            domain_count = 0
    
            for subcat in sorted(grouped_keywords[domain]):
                keywords = grouped_keywords[domain][subcat]
                hits = hit_map[domain].get(subcat, [])
    
                # count hits per keyword
                kw_counts = defaultdict(int)
                for h in hits:
                    kw_counts[h["match_key"]] += 1
    
                children = []
                subcat_count = 0
    
                for kw in keywords:
                    kw_norm = kw.lower()
    
                    # apply keyword filter
                    if tree_filter and tree_filter not in kw_norm:
                        continue
    
                    count = kw_counts.get(kw, 0)
    
                    if count == 0 and not self.show_all:
                        continue
    
                    children.append({
                        "type": "keyword",
                        "name": kw,
                        "count": count,
                        "parent": f"{domain}/{subcat}",
                    })
    
                    subcat_count += count
    
                # hide empty subcategory unless show_all
                if not children and not self.show_all:
                    continue
    
                domain_children.append({
                    "type": "subcategory",
                    "name": subcat,
                    "display": subcat.replace("_", " ").capitalize(),
                    "expanded": False,
                    "parent": domain,
                    "children": children,
                    "count": subcat_count,   # FILTERED COUNT
                })
    
                domain_count += subcat_count
    
            # hide empty domain unless show_all
            if domain_count == 0 and not self.show_all:
                continue
    
            tree.append({
                "type": "domain",
                "name": domain,
                "display": domain.capitalize(),
                "expanded": False,
                "children": domain_children,
                "count": domain_count,     # FILTERED COUNT
            })
    
        return tree

    def filtered_hits(self):
        """
        Return hits based on current tree selection.
        Domain/Subcategory/Keyword aware.
        """
        sel = self.current_category_selection()
        if not sel:
            return []
    
        # DOMAIN → all hits under domain
        if sel["mode"] == "domain":
            domain = sel["domain"]
            hits = []
            for cat, cat_hits in self.findings.items():
                if cat.startswith(domain + "/"):
                    hits.extend(cat_hits)
            return hits
    
        # SUBCATEGORY → all hits in subcategory
        if sel["mode"] == "subcategory":
            return self.findings.get(sel["category"], [])
    
        # KEYWORD → only that keyword
        if sel["mode"] == "keyword":
            return [
                h for h in self.findings.get(sel["category"], [])
                if h["match_key"] == sel["keyword"]
            ]
    
        return []

    def safe_basename(self):
        """
        Return a filesystem-safe base name for exports.
        """
        base = os.path.basename(self.filename)
        # Replace anything non-alphanumeric with underscore
        base = re.sub(r"[^A-Za-z0-9._-]", "_", base)
        return base

    def clamp_category_scroll(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            self.cat_offset = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

        max_offset = max(0, len(rows) - 1)
        self.cat_offset = max(0, min(self.cat_offset, max_offset))

    def save_category_scroll(self):
        sel = self.current_category_selection()
        if not sel or sel["mode"] != "category":
            return

        key = sel["category"]
        self.category_scroll_state[key] = (self.cat_i, self.cat_offset)

    def restore_category_scroll(self):
        sel = self.current_category_selection()
        if not sel or sel["mode"] != "category":
            return

        key = sel["category"]
        if key in self.category_scroll_state:
            self.cat_i, self.cat_offset = self.category_scroll_state[key]

    # ---------------- HEADERS -----------------
    def draw_top_header(self, title):
        h, w = self.stdscr.getmaxyx()
        if w <= 1:
            return

        self.stdscr.addnstr(
            0,
            0,
            title.ljust(w),
            w,
            curses.color_pair(COLOR_TOPHEADER) | curses.A_BOLD | curses.A_DIM
        )

    def draw_header(self, y, x, width, title):
        if width <= 0:
            return

        max_w = self.stdscr.getmaxyx()[1]

        # Prevent writing into last column (curses wrap bug)
        safe_width = min(width, max_w - x - 1)
        if safe_width <= 0:
            return

        self.stdscr.addnstr(
            y,
            x,
            title.ljust(safe_width),
            safe_width,
            curses.color_pair(COLOR_HEADER) | curses.A_BOLD
        )
    # ---------------- SUMMARY -----------------
    def build_summary(self):
        """
        Build a summary structure:
        {
            category: {
                "total": int,
                "keywords": { keyword: count }
            }
        }
        """
        summary = {}
    
        for category, hits in self.findings.items():
            cat_summary = {
                "total": len(hits),
                "keywords": {}
            }
    
            for h in hits:
                kw = (
                    h["match_key"][6:]
                    if h["match_key"].startswith("regex:")
                    else h["match_key"]
                )
                cat_summary["keywords"][kw] = (
                    cat_summary["keywords"].get(kw, 0) + 1
                )
    
            summary[category] = cat_summary
    
        return summary

    def export_summary_text(self, lines):
        fname = f"hexwalk_{self.safe_basename()}_summary.txt"
        with open(fname, "w", encoding="utf-8") as f:
            for line in lines:
                f.write(line + "\n")
    
        h, w = self.stdscr.getmaxyx()
        msg = f"Summary exported to {fname}"
        self.stdscr.addstr(
            h - 2,
            0,
            msg[:w - 1],
            curses.A_BOLD | curses.color_pair(COLOR_STATUS)
        )
        self.stdscr.refresh()
        curses.napms(1200)

    def show_summary(self):
        summary = self.build_summary()
        lines = []

        total_hits = sum(cat["total"] for cat in summary.values())
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        lines.append("HexWalk Summary")
        lines.append("=" * 15)
        lines.append("")
        lines.append(f"Analyzed file : {self.filename}")
        lines.append(f"Generated     : {ts}")
        lines.append("")
        lines.append(f"Total categories : {len(summary)}")
        lines.append(f"Total hits       : {total_hits}")
        lines.append("")
    
        for category in sorted(summary.keys()):
            cat_name = self.format_category_name(category)
            cat_data = summary[category]
    
            lines.append(f"Category: {cat_name} ({cat_data['total']} hits)")
            lines.append("-" * (len(lines[-1])))
    
            for kw, cnt in sorted(
                cat_data["keywords"].items(),
                key=lambda x: x[1],
                reverse=True
            ):
                lines.append(f"  {kw:<20} : {cnt}")
    
            lines.append("")
    
        # ---- Screen loop ----
        offset = 0
        while True:
            self.stdscr.clear()
            h, w = self.stdscr.getmaxyx()
    
            for i in range(h - 1):
                idx = offset + i
                if idx >= len(lines):
                    break
                self.stdscr.addstr(
                    i,
                    0,
                    lines[idx][:w - 1]
                )
    
            status = "[ q ] back   [ e ] export summary to text"
            self.stdscr.addstr(
                h - 1,
                0,
                status[:w - 1],
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )
    
            self.stdscr.refresh()
            key = self.stdscr.getch()
    
            if key in (ord("q"), 27):
                break
            elif key == ord("e"):
                self.export_summary_text(lines)
            elif key == curses.KEY_DOWN:
                offset = min(offset + 1, max(0, len(lines) - h + 1))
            elif key == curses.KEY_UP:
                offset = max(0, offset - 1)

    def visible_category_rows(self):
        rows = []

        for domain in self.category_tree:
            rows.append(domain)
            if domain["expanded"]:
                for sub in domain["children"]:
                    rows.append(sub)
                    if sub["expanded"]:
                        rows.extend(sub["children"])

        return rows

    def current_category_selection(self):
        rows = self.visible_category_rows()
        if not rows:
            return None
    
        node = rows[self.cat_i]
    
        if node["type"] == "domain":
            return {
                "mode": "domain",
                "domain": node["name"],
            }
    
        if node["type"] == "subcategory":
            return {
                "mode": "subcategory",
                "category": f"{node['parent']}/{node['name']}",
            }
    
        if node["type"] == "keyword":
            return {
                "mode": "keyword",
                "category": node["parent"],
                "keyword": node["name"],
            }

    def clamp_category_index(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

    # ---------------- MODAL -----------------
    def show_hit_modal(self, hits, start_index):
        h, w = self.stdscr.getmaxyx()
    
        # ---------- Modal geometry ----------
        modal_h = min(37, h - 4)
        modal_w = min(120, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2
    
        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)
    
        # ---------- Layout constants ----------
        BYTES_PER_LINE = 16
        GROUP_SIZE = 8
        GROUP_GAP = 1
    
        INFO_LINES = 4
        INFO_PAD = 2
        STATUS_LINES = 1
        BORDER_LINES = 2

        def hex_col_for_byte(j):
            """
            Return column offset (relative to start of hex field)
            for byte index j, respecting GROUP_SIZE and GROUP_GAP.
            """
            group = j // GROUP_SIZE
            offset_in_group = j % GROUP_SIZE

            return (
                group * (GROUP_SIZE * 3 + GROUP_GAP + 1) +
                offset_in_group * 3
            )
    
        HEX_LINES = (
            modal_h
            - BORDER_LINES
            - INFO_LINES
            - INFO_PAD
            - STATUS_LINES
        )
    
        # ---------- Hex width calculation ----------
        groups = (BYTES_PER_LINE + GROUP_SIZE - 1) // GROUP_SIZE
        hex_width = (
            BYTES_PER_LINE * 3 - 1 +
            (groups - 1) * GROUP_GAP
        )
    
        data = self.binary
        idx = start_index
        total = len(hits)
    
        # Initial view offset
        offset = hits[idx]["context"]["offset"]
        view_offset = max(0, offset - (HEX_LINES // 2) * BYTES_PER_LINE)
    
        while True:
            hit = hits[idx]
            offset = hit["context"]["offset"]
            match_len = len(hit["match_key"])
    
            win.clear()
            win.box()
    
            # ---------- Info block ----------
            info = [
                f"Offset       : 0x{offset:08X}",
                f"Match type   : {hit['match_type']}",
                f"Match key    : {hit['match_key']}",
                f"String length: {match_len}",
            ]
    
            for i, line in enumerate(info):
                win.addstr(
                    1 + i,
                    2,
                    line[:modal_w - 4],
                    curses.A_BOLD | curses.color_pair(COLOR_CAT),
                )
    
            sep_y = 1 + INFO_LINES
            win.hline(sep_y, 1, curses.ACS_HLINE, modal_w - 2)
    
            # ---------- Hex view ----------
            hex_y = sep_y + INFO_PAD
    
            for i in range(HEX_LINES):
                line_start = view_offset + i * BYTES_PER_LINE
                if line_start >= len(data):
                    break
    
                chunk = data[line_start:line_start + BYTES_PER_LINE]
    
                # ---- Build grouped hex ----
                hex_chunks = []
                for j, b in enumerate(chunk):
                    hex_chunks.append(f"{b:02X}")
                    if (
                        (j + 1) % GROUP_SIZE == 0
                        and (j + 1) < BYTES_PER_LINE
                    ):
                        hex_chunks.append(" " * GROUP_GAP)
    
                hex_part = " ".join(hex_chunks).ljust(hex_width)
    
                ascii_part = "".join(
                    chr(b) if 32 <= b <= 126 else "."
                    for b in chunk
                )
    
                base_line = f"{line_start:08X}  {hex_part}  {ascii_part}"
    
                win.addstr(
                    hex_y + i,
                    2,
                    base_line[:modal_w - 4],
                    curses.color_pair(COLOR_CAT),
                )
    
                # ---------- Highlight matching bytes (line-safe) ----------
                match_start = offset
                match_end = offset + match_len
                
                line_start_abs = line_start
                line_end_abs = line_start + len(chunk)
                
                # Compute overlap between match and this line
                highlight_start = max(match_start, line_start_abs)
                highlight_end = min(match_end, line_end_abs)
                
                if highlight_start < highlight_end:
                    for abs_pos in range(highlight_start, highlight_end):
                        j = abs_pos - line_start_abs
                        group_index = j // GROUP_SIZE
                
                        # Hex highlight
                        HEX_START_X = 2 + 10  # offset + two spaces
                        hex_x = HEX_START_X + hex_col_for_byte(j)

                        win.addstr(
                            hex_y + i,
                            hex_x,
                            f"{chunk[j]:02X}",
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )
                
                        # ASCII highlight
                        ascii_x = (
                            2
                            + 10
                            + hex_width
                            + 3
                            + j
                        )
                        win.addstr(
                            hex_y + i,
                            ascii_x,
                            ascii_part[j],
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )
    
            # ---------- Status ----------
            status = f"<- -> navigate | ↑↓ scroll | q close  ({idx + 1}/{total})"
            win.addstr(
                modal_h - 2,
                2,
                status[:modal_w - 4],
                curses.A_BOLD | curses.color_pair(COLOR_STATUS),
            )
    
            win.refresh()
    
            # ---------- Input ----------
            key = win.getch()
    
            if key in (ord("q"), 27):
                break
    
            elif key == curses.KEY_UP:
                view_offset = max(0, view_offset - BYTES_PER_LINE)
    
            elif key == curses.KEY_DOWN:
                view_offset = min(
                    max(0, len(data) - BYTES_PER_LINE),
                    view_offset + BYTES_PER_LINE,
                )
    
            elif key == curses.KEY_RIGHT:
                if idx < total - 1:
                    idx += 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = max(
                        0, offset - (HEX_LINES // 2) * BYTES_PER_LINE
                    )
    
            elif key == curses.KEY_LEFT:
                if idx > 0:
                    idx -= 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = max(
                        0, offset - (HEX_LINES // 2) * BYTES_PER_LINE
                    )

    # ---------------- HELP -----------------
    def show_help(self):
        self.stdscr.clear()
        h,w = self.stdscr.getmaxyx()
        lines = [
            "Hexwalk TUI Help",
            "",
            "Navigation:",
            "  Arrow Up/Down : Move in pane",
            "  Tab           : Switch pane (Categories/Hits/Details)",
            "  Enter         : View hit modal",
            "  /             : Filter hits",
            "  e             : Export current findings to hexwalk_<filename>_export.json",
            "  s             : Show summary",
            "  h             : Show this help",
            "  q             : Quit",
            "",
            "Press any key to return..."
        ]
        for i,line in enumerate(lines):
            if i>=h-1: break
            self.stdscr.addstr(i,0,line[:w-1])
        self.stdscr.refresh()
        self.stdscr.getch()

    # ---------------- HITS COUNT -----------------
    def category_hit_count(self, category):
        hits = self.findings.get(category, [])
        if not self.filter_text:
            return len(hits)
        ft = self.filter_text.lower()
        return sum(1 for h in hits if ft in h["string"].lower())

    # ---------------- CATEGORY NAME -----------------
    def format_category_name(self, name):
        base = os.path.splitext(name)[0]   # remove .txt (or any extension)
        if not base:
            return name
        return base[0].upper() + base[1:]

    # ---------------- EXPORT -----------------
    def exportable_findings(self):
        """
        Return a JSON-safe version of findings.
        Raw bytes are converted to hex strings.
        """
        out = {}
    
        for category, hits in self.findings.items():
            out[category] = []
            for h in hits:
                clean = dict(h)
    
                # Fix context
                ctx = dict(clean.get("context", {}))
                if "bytes" in ctx:
                    ctx["bytes_hex"] = ctx["bytes"].hex()
                    del ctx["bytes"]
    
                clean["context"] = ctx
                out[category].append(clean)
    
        return out

    # ---------------- DRAW -----------------
    def draw(self):
        self.stdscr.clear()
        h, w = self.stdscr.getmaxyx()
        if w < 20 or h < 5:
            self.stdscr.clear()
            self.stdscr.addstr(0, 0, "Terminal too small")
            self.stdscr.refresh()
            return
    
        if self.pane not in (0, 1):
            self.pane = 0
    
        self.clamp_category_scroll()
        self.clamp_category_index()
    
        # ---------- Layout constants ----------
        HITS_MIN_W = 10
        DETAILS_MIN_W = 50
        SEP_CHAR = curses.ACS_VLINE
        SEP_PAD = 1
    
        # ---------- Initial widths ----------
        cat_w = max(1, CAT_W)
        details_w = self.details_width if self.details_visible else 0
    
        cat_x = 0
        hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))
    
        if self.details_visible and hits_w < HITS_MIN_W:
            details_w = max(
                DETAILS_MIN_W,
                details_w - (HITS_MIN_W - hits_w)
            )
            details_w = max(0, details_w)
            hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))
    
        if hits_w < HITS_MIN_W:
            details_w = 0
            self.details_visible = False
            hits_w = w - cat_w - (1 + SEP_PAD)
    
        # ---------- X positions ----------
        sep1_x = cat_x + cat_w + SEP_PAD
        hits_x = sep1_x + 1 + SEP_PAD
    
        sep2_x = hits_x + hits_w + SEP_PAD if details_w else None
        details_x = sep2_x + 1 + SEP_PAD if sep2_x is not None else None
    
        # ---------- Compute hits ----------
        hits = self.filtered_hits() or []
        if self.hit_i >= len(hits):
            self.hit_i = max(0, len(hits) - 1)
    
        # ---------- Clear panes ----------
        for y in range(0, h - 1):
            if cat_x + cat_w <= w:
                self.stdscr.addstr(y, cat_x, " " * cat_w)
            if hits_x + hits_w <= w:
                self.stdscr.addstr(y, hits_x, " " * hits_w)
            if self.details_visible and details_w > 0 and details_x + details_w <= w:
                self.stdscr.addstr(y, details_x, " " * details_w)
    
        # ---------- Vertical separators ----------
        for y in range(0, h - 1):
            if sep1_x < w:
                self.stdscr.addch(y, sep1_x, SEP_CHAR)
            if self.details_visible and sep2_x is not None and sep2_x < w:
                self.stdscr.addch(y, sep2_x, SEP_CHAR)
    
        # ---------- Top Header ----------
        header = " " + self.format_top_header()
        self.draw_top_header(header)
    
        # ==========================================================
        # Categories (WITH SCROLLING)
        # ==========================================================
        rows = self.visible_category_rows()
        cat_height = h - 3  # top header + pane header + status bar
    
        # ---- Scroll handling (NEW) ----
        if self.cat_i < self.cat_offset:
            self.cat_offset = self.cat_i
        elif self.cat_i >= self.cat_offset + cat_height:
            self.cat_offset = self.cat_i - cat_height + 1
    
        # Header
        self.draw_header(1, cat_x, cat_w, "Categories")
    
        for row in range(cat_height):
            idx = self.cat_offset + row
            if idx >= len(rows):
                break
    
            node = rows[idx]

            # ---- default attributes (always defined) ----
            attr = curses.color_pair(COLOR_CAT)
            label = ""
            
            if node["type"] == "domain":
                arrow = "▾" if node["expanded"] else "▸"
                label = f"{arrow} [{node['count']:>4}] {node['display']}"
                attr |= curses.A_BOLD
            
            elif node["type"] == "subcategory":
                arrow = "▾" if node["expanded"] else "▸"
                label = f"  {arrow} [{node['count']:>4}] {node['display']}"
            
            elif node["type"] == "keyword":
                label = f"      [{node['count']:>4}] {node['name']}"
                attr |= curses.A_ITALIC
            
            if idx == self.cat_i and self.pane == 0:
                attr |= curses.A_REVERSE
            
            # ---- selection highlight ----
            if idx == self.cat_i and self.pane == 0:
                attr |= curses.A_REVERSE
            
            self.stdscr.addstr(
                row + 2,
                cat_x,
                label[:cat_w].ljust(cat_w),
                attr
            )

        # ==========================================================
        # Hits (unchanged)
        # ==========================================================
        sel = self.current_category_selection()

        if not sel:
            title = "Hits"

        elif sel["mode"] == "domain":
            title = f"Hits — {sel['domain'].capitalize()}"

        elif sel["mode"] == "subcategory":
            title = f"Hits — {sel['category'].capitalize()}"

        elif sel["mode"] == "keyword":
            title = (
                f"Hits — {sel['category'].capitalize()} / {sel['keyword']}"
            )

        else:
            title = "Hits"
    
        self.draw_header(1, hits_x, hits_w, title)
    
        hit_height = h - 3
    
        if self.hit_i < self.hit_offset:
            self.hit_offset = self.hit_i
        elif self.hit_i >= self.hit_offset + hit_height:
            self.hit_offset = self.hit_i - hit_height + 1
    
        for i in range(hit_height):
            idx = self.hit_offset + i
            if idx >= len(hits):
                break
    
            hit = hits[idx]
            text = hit["string"]
            kw = hit["match_key"]
    
            attr_normal = (
                curses.A_REVERSE
                if self.pane == 1 and idx == self.hit_i
                else curses.color_pair(COLOR_HIT)
            )
    
            attr_highlight = curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD
    
            visible = text[:hits_w - 1]
            pos = visible.lower().find(kw.lower())
    
            if pos >= 0:
                self.stdscr.addstr(i + 2, hits_x, visible[:pos], attr_normal)
                self.stdscr.addstr(
                    i + 2,
                    hits_x + pos,
                    visible[pos:pos + len(kw)],
                    attr_highlight
                )
                self.stdscr.addstr(
                    i + 2,
                    hits_x + pos + len(kw),
                    visible[pos + len(kw):].ljust(hits_w - pos - len(kw) - 1),
                    attr_normal
                )
            else:
                self.stdscr.addstr(
                    i + 2,
                    hits_x,
                    visible.ljust(hits_w - 1),
                    attr_normal
                )
    
        # ==========================================================
        # Details (unchanged)
        # ==========================================================
        if self.details_visible and details_w > 0:
            SAFE_W = max(1, details_w - 2)
            self.draw_header(1, details_x, details_w - 2, "Details")
    
            if hits:
                hit = hits[self.hit_i]
                offset = hit["context"]["offset"]
    
                od_lines = od_bc_view(
                    self.binary,
                    offset,
                    hit["match_key"],
                    context=32
                )
    
                for i, line in enumerate(od_lines[:h - 2]):
                    self.stdscr.addstr(
                        i + 2,
                        details_x,
                        line[:SAFE_W].ljust(SAFE_W),
                        curses.color_pair(COLOR_CAT)
                    )
    
        # ---------- Status bar ----------
        status = (
            "Tab pane | ↑↓ move | Enter expand/view | / filter | "
            "d toggle details | [ ] resize | e export | h help | q quit"
        )
    
        if w > 1:
            self.stdscr.addstr(
                h - 1,
                0,
                status[:w - 1].ljust(w - 1),
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )
    
        self.stdscr.refresh()

    # ---------------- MAIN LOOP -----------------
    def main_loop(self):
        while True:
            self.draw()
            key = self.stdscr.getch()
            hits = self.filtered_hits()
            hit_height = self.stdscr.getmaxyx()[0]-2

            if key==ord("q"): break
            elif key==ord("h"): self.show_help()
            elif key == curses.KEY_DOWN and self.pane == 0:
                self.cat_i += 1
                self.clamp_category_index()

            elif key == curses.KEY_UP and self.pane == 0:
                self.cat_i -= 1
                self.clamp_category_index()
            elif key==curses.KEY_DOWN:
                if self.pane==0: self.cat_i=min(len(self.categories)-1,self.cat_i+1);self.hit_i=0;self.hit_offset=0
                elif self.pane==1 and hits: self.hit_i=min(len(hits)-1,self.hit_i+1)
            elif key==curses.KEY_UP:
                if self.pane==0: self.cat_i=max(0,self.cat_i-1);self.hit_i=0;self.hit_offset=0
                elif self.pane==1 and hits: self.hit_i=max(0,self.hit_i-1)
            elif key == 9:  # Tab
                self.pane = (self.pane + 1) % 2
            elif key == ord("/"):
                curses.echo()
                h, w = self.stdscr.getmaxyx()
                self.stdscr.addstr(h - 1, 0, "Search keywords: ")
                self.stdscr.clrtoeol()

                s = self.stdscr.getstr().decode("utf-8", errors="ignore").strip()
                curses.noecho()

                if s:
                    self.tree_filter = s.lower()
                else:
                    self.tree_filter = None

                # rebuild tree with filter applied
                self.category_tree = self.build_domain_tree()
                self.cat_i = 0
                self.cat_offset = 0
            elif key==ord("e"):
                fname = f"hexwalk_{self.safe_basename()}_export.json"
                with open(fname,"w") as f:
                    json.dump(self.exportable_findings(),f,indent=2)
                h,w=self.stdscr.getmaxyx()
                self.stdscr.addstr(h-2,0,"Exported current findings to hexwalk_export.json",curses.A_BOLD)
                self.stdscr.refresh()
                curses.napms(1000)
            elif key == ord("s"):
                self.show_summary()
            elif key == ord("d"):
                self.details_visible = not self.details_visible
            elif key == ord("["):
                self.details_width = max(20, self.details_width - 4)
            elif key == ord("]"):
                self.details_width = min(120, self.details_width + 4)
            elif self.pane == 0:
            
                rows = self.visible_category_rows()
                if not rows:
                    continue
            
                node = rows[self.cat_i]
            
                # ---------- MOVE ----------
                if key == curses.KEY_DOWN:
                    self.cat_i += 1
                    self.clamp_category_index()
            
                elif key == curses.KEY_UP:
                    self.cat_i -= 1
                    self.clamp_category_index()
            
                # ---------- EXPAND (RIGHT) ----------
                elif key == curses.KEY_RIGHT:
            
                    # RIGHT = expand only, never collapse, never go up
                    if node["type"] == "domain":
                        if not node["expanded"]:
                            node["expanded"] = True
            
                    elif node["type"] == "subcategory":
                        if not node["expanded"]:
                            node["expanded"] = True
            
                            # restore keyword cursor if known
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                                self.cat_i = self.subcategory_keyword_state[key_id]
            
                    # keyword → NO-OP on RIGHT
            
                    self.clamp_category_index()
            
                # ---------- COLLAPSE (LEFT) ----------
                elif key == curses.KEY_LEFT:
                
                    # ---------- KEYWORD → go up to subcategory ----------
                    if node["type"] == "keyword":
                        parent_cat = node["parent"]  # domain/subcategory
                        domain, subcat = parent_cat.split("/", 1)
                
                        # remember keyword position
                        self.subcategory_keyword_state[parent_cat] = self.cat_i
                
                        # collapse subcategory
                        for n in rows:
                            if (
                                n["type"] == "subcategory"
                                and n["parent"] == domain
                                and n["name"] == subcat
                            ):
                                n["expanded"] = False
                                break
                
                        # move to subcategory
                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx
                
                    # ---------- SUBCATEGORY → go up to domain ----------
                    elif node["type"] == "subcategory":
                        domain = node["parent"]
                        subcat = node["name"]
                
                        # remember subcategory position
                        self.domain_subcategory_state[domain] = self.cat_i
                
                        # collapse subcategory
                        node["expanded"] = False
                
                        # move to domain
                        rows = self.visible_category_rows()
                        for i, n in enumerate(rows):
                            if n["type"] == "domain" and n["name"] == domain:
                                self.cat_i = i
                                break
                
                    # ---------- DOMAIN → collapse ----------
                    elif node["type"] == "domain":
                        node["expanded"] = False
                
                    self.clamp_category_index()
            
                # ---------- TOGGLE (ENTER) ----------
                elif key in (10, 13):
            
                    if node["type"] in ("domain", "subcategory"):
                        node["expanded"] = not node["expanded"]
            
                        if node["expanded"] and node["type"] == "subcategory":
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                               self.cat_i = self.subcategory_keyword_state[key_id]
            
                    elif node["type"] == "keyword":
                        parent_cat = node["parent"]
                        domain, subcat = parent_cat.split("/", 1)
            
                        self.subcategory_keyword_state[parent_cat] = self.cat_i
                        for n in rows:
                            if (
                                n["type"] == "subcategory"
                                and n["parent"] == domain
                                and n["name"] == subcat
                            ):
                                n["expanded"] = False
                                break
            
                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx
            
                    self.clamp_category_index()
                    self.clamp_category_scroll()

# ---------------- MAIN -----------------
def main():
    parser = argparse.ArgumentParser(
        description="Hexwalk – binary keyword scanner"
    )

    parser.add_argument(
        "file",
        help="File to analyze (binary or Intel HEX)",
    )

    parser.add_argument(
        "--summary",
        action="store_true",
        help="Write summary file and exit (no TUI)",
    )

    parser.add_argument(
        "--export",
        action="store_true",
        help="Write JSON export file and exit (no TUI)",
    )

    parser.add_argument(
        "--show-all",
        action="store_true",
        help="Show all domains, subcategories, and keywords even if no hits are found",
    )

    args = parser.parse_args()

    file_path = args.file
    filename = os.path.basename(file_path)

    # ---------- Load binary ----------
    if is_hex_file(file_path):
        binary = hex_to_bin(file_path)
    else:
        binary = load_binary(file_path)

    keywords = load_keywords(KEYWORD_DIR)
    findings_def = keywords_to_findings(keywords)
    matches = search_keywords(binary, findings_def)

    if not matches:
        print("No matches found.")
        sys.exit(0)

    # ---------- Non-interactive mode ----------
    if args.summary or args.export:
        if args.export:
            out = write_export(matches, filename, file_path)
            print(f"Wrote export: {out}")

        if args.summary:
            # Generate summary text without TUI
            summary = generate_summary_text(matches, filename, file_path)
            out = write_summary(summary, filename)
            print(f"Wrote summary: {out}")

        sys.exit(0)

    # ---------- Interactive TUI ----------
    curses.wrapper(
        lambda stdscr: HexwalkTUI(
            stdscr,
            matches,
            binary,
            filename,
            file_path,
            keywords,
            show_all=args.show_all
        )
    )

if __name__=="__main__":
    main()

