def load_config():
    if not os.path.exists(CONFIG_PATH):
        cfg = default_config()
        save_config(cfg)
        return cfg

    with open(CONFIG_PATH, "r") as f:
        return json.load(f)

def save_config(cfg):
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)

# --- OLLAMA ---
def probe_ollama(url, timeout=5):
    """
    Probe Ollama API for availability and models.

    Returns:
        (ok: bool, models: list[str], error: str | None)
    """
    api_url = url.rstrip("/") + "/api/tags"

    try:
        req = urllib.request.Request(api_url)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status != 200:
                return False, [], f"HTTP {resp.status}"

            data = json.loads(resp.read().decode("utf-8"))
            models = [
                m.get("name", "")
                for m in data.get("models", [])
                if m.get("name")
            ]

            if not models:
                return False, [], "No models available"

            return True, models, None

    except urllib.error.URLError as e:
        return False, [], str(e.reason)
    except Exception as e:
        debug_log(f"Unable to connect to Ollama")
        return False, [], str(e)

# --- TUI ---
def get_tree_arrows():
    """
    Return safe expand/collapse arrows depending on terminal support.
    """
    try:
        "▸▾".encode(sys.stdout.encoding)
        return {
            #"collapsed": "▸",
            #"expanded":  "▾",
            "collapsed": ">",
            "expanded":  "v",
        }
    except Exception:
        return {
            "collapsed": ">",
            "expanded":  "v",
        }

def safe_hline(win, y, x, w, ch):
    if w <= 0:
        return
    try:
        win.addstr(y, x, ch * w)
    except curses.error:
        pass

def draw_box(win, h, w, box):
    """
    Safely draw a box using provided characters.
    Will NOT draw if the window is too small.
    """
    # Minimum viable box: 3x3
    if h < 3 or w < 3:
        return

    try:
        # Top
        win.addstr(0, 0, box["tl"] + box["h"] * (w - 2) + box["tr"])

        # Sides
        for y in range(1, h - 1):
            win.addstr(y, 0, box["v"])
            win.addstr(y, w - 1, box["v"])

        # Bottom
        win.addstr(h - 1, 0, box["bl"] + box["h"] * (w - 2) + box["br"])

    except curses.error:
        # Terminal resized or window invalid — ignore safely
        pass


def get_box_chars():
    """
    Return safe box-drawing characters depending on terminal support.
    """
    try:
        # If UTF-8 works, use proper box drawing
        "│".encode(sys.stdout.encoding)
        return {
            "v": "│",
            "h": "─",
            "tl": "┌",
            "tr": "┐",
            "bl": "└",
            "br": "┘",
        }
    except Exception:
        # Pure ASCII fallback
        return {
            "v": "|",
            "h": "-",
            "tl": "+",
            "tr": "+",
            "bl": "+",
            "br": "+",
        }

def draw_progress_modal(
    stdscr,
    box_style,
    title,
    message,
    progress=None,
    win=None,
    density=None,
    density_pairs=None
):
    h, w = stdscr.getmaxyx()

    modal_h = 11
    modal_w = min(60, w - 4)
    modal_y = (h - modal_h) // 2
    modal_x = (w - modal_w) // 2

    if win is None:
        win = stdscr.subwin(modal_h, modal_w, modal_y, modal_x)

    win.erase()
    draw_box(win, modal_h, modal_w, box_style)

    win.addstr(1, 2, title[: modal_w - 4], curses.A_BOLD)
    win.addstr(3, 2, message[: modal_w - 4])

    # -------------------------------------------------
    # Progress bar
    # -------------------------------------------------
    if progress is not None:
        bar_w = modal_w - 4
        filled = int(bar_w * max(0.0, min(1.0, progress)))
        bar = "█" * filled + " " * (bar_w - filled)

        win.addnstr(5, 2, bar, bar_w, curses.A_REVERSE)

        pct = f"{int(progress * 100):3d}%"
        win.addstr(6, modal_w - len(pct) - 2, pct)

    # -------------------------------------------------
    # Density heatmap (COLOR-BASED)
    # -------------------------------------------------
    if density and density_pairs:
        heat_y = 7
        heat_w = modal_w - 4

        max_val = max(density) or 1

        for i in range(min(heat_w, len(density))):
            val = density[i]

            # Normalize (same logic as big heatmap)
            ratio = val / max_val
            ratio = max(0.0, min(1.0, ratio))

            idx = int(ratio * (len(density_pairs) - 1))
            idx = max(0, min(len(density_pairs) - 1, idx))

            color = density_pairs[idx]

            try:
                # space with background color = clean heat bar
                win.addstr(heat_y, 2 + i, " ", color)
            except curses.error:
                pass

    win.noutrefresh()
    curses.doupdate()

    return win

# ---------------- HEX FILE PARSER -----------------
def is_hex_file(file_path):
    try:
        with open(file_path, "rb") as f:
            for _ in range(10):  # only check first few lines
                line = f.readline()
                if not line:
                    break
                line = line.strip()
                if line:
                    return line.startswith(b":")
    except OSError:
        return False
    return False

def load_binary(file_path):
    """Load a file as raw binary."""
    with open(file_path,"rb") as f:
        return f.read()

def hex_to_bin(file_path):
    """
    Convert an Intel HEX file to a flat binary image.

    Supports:
      - Data records (00)
      - End Of File (01)
      - Extended Linear Address (04)

    Unsupported record types are ignored safely.
    """
    memory = bytearray()
    max_addr = 0
    base_addr = 0  # Upper 16 bits from type 04 records

    with open(file_path, "r", encoding="ascii", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line.startswith(":"):
                continue

            try:
                byte_count = int(line[1:3], 16)
                address = int(line[3:7], 16)
                record_type = int(line[7:9], 16)
                data = line[9:9 + byte_count * 2]
            except ValueError:
                continue

            # ----- Data record -----
            if record_type == 0x00:
                abs_addr = base_addr + address
                bytes_data = bytes(
                    int(data[i:i + 2], 16)
                    for i in range(0, len(data), 2)
                )

                end_addr = abs_addr + len(bytes_data)
                if len(memory) < end_addr:
                    memory.extend(b"\x00" * (end_addr - len(memory)))

                memory[abs_addr:end_addr] = bytes_data
                max_addr = max(max_addr, end_addr)

            # ----- End Of File -----
            elif record_type == 0x01:
                break

            # ----- Extended Linear Address -----
            elif record_type == 0x04:
                base_addr = int(data, 16) << 16

            # ----- Ignore other record types safely -----
            else:
                continue

    return bytes(memory[:max_addr])

# ---------------- SEARCH RULES -----------------
def search_rules(binary: bytes, rules: dict, progress_cb=None, density=None):
    """
    Offset-safe scanning:
    - Works ONLY on raw bytes
    - Stores preview_bytes + relative offsets
    - Optional density heatmap (lightweight, incremental)
    """

    findings = defaultdict(list)
    progress_steps = 1 

    file_size = len(binary)

    total_steps = (
        len(rules.get("plain", []))
        + len(rules.get("regex", []))
        + len(rules.get("yara", []))
    )

    current_step = 0

    def update_progress(status=""):
        if progress_cb and total_steps > 0:
            progress_cb(current_step / total_steps, status)

    CONTEXT = 40

    # ==========================================================
    # HELPER: density update (safe + fast)
    # ==========================================================
    def update_density(offset):
        if not density or file_size == 0:
            return

        idx = int((offset / file_size) * (len(density) - 1))
        idx = max(0, min(len(density) - 1, idx))
        density[idx] += 1

    # ==========================================================
    # PLAIN KEYWORDS
    # ==========================================================
    for rule in rules.get("plain", []):
        key_bytes = rule["value"].encode(errors="ignore")
        domain = rule["domain"]
        subcat = rule["subcategory"]

        search_from = 0

        while True:
            pos = binary.find(key_bytes, search_from)
            if pos == -1:
                break

            start = pos
            end = pos + len(key_bytes)

            update_density(start)

            ctx_start = max(0, start - CONTEXT)
            ctx_end = min(file_size, end + CONTEXT)

            preview = binary[ctx_start:ctx_end]

            findings[f"{domain}/{subcat}"].append({
                "preview_bytes": preview,
                "match_offset": start - ctx_start,
                "match_length": len(key_bytes),
                "match_type": "plain",
                "match_key": rule["value"],
                "context": {
                    "offset": start,
                    "bytes_hex": binary[start:end].hex(),
                }
            })

            search_from = end

        current_step += 1
        if not current_step % progress_steps:
            update_progress(f"{current_step}/{total_steps} | Plain: {domain}/{subcat}")

    # ==========================================================
    # REGEX RULES
    # ==========================================================
    for rule in rules.get("regex", []):
        domain = rule["domain"]
        subcat = rule["subcategory"]
        pattern = rule["compiled"]

        try:
            for match in pattern.finditer(binary):
                start = match.start()
                end = match.end()
                length = end - start

                update_density(start)

                ctx_start = max(0, start - CONTEXT)
                ctx_end = min(file_size, end + CONTEXT)

                preview = binary[ctx_start:ctx_end]

                findings[f"{domain}/{subcat}"].append({
                    "preview_bytes": preview,
                    "match_offset": start - ctx_start,
                    "match_length": length,
                    "match_type": "regex",
                    "match_key": rule["pattern"],
                    "context": {
                        "offset": start,
                        "bytes_hex": binary[start:end].hex(),
                    }
                })

        except re.error:
            continue

        current_step += 1
        if not current_step % progress_steps:
            update_progress(f"{current_step}/{total_steps} | Regex: {domain}/{subcat}")

    # ==========================================================
    # YARA RULES
    # ==========================================================
    for rule in rules.get("yara", []):
        domain = rule["domain"]
        subcat = rule["subcategory"]
        compiled = rule["compiled"]

        try:
            matches = compiled.match(data=binary)
        except Exception as e:
            debug_log(f"YARA execution error: {e}", "yara")
            continue

        for m in matches:
            key = f"{domain}/{subcat}/{m.rule}"

            for s in m.strings or []:
                for instance in s.instances:

                    offset = instance.offset
                    length = instance.matched_length

                    update_density(offset)

                    ctx_start = max(0, offset - CONTEXT)
                    ctx_end = min(file_size, offset + length + CONTEXT)

                    preview = binary[ctx_start:ctx_end]

                    findings[key].append({
                        "preview_bytes": preview,
                        "match_offset": offset - ctx_start,
                        "match_length": length,
                        "match_type": "yara",
                        "rule_name": m.rule,
                        "match_key": m.rule,
                        "context": {
                            "offset": offset,
                            "bytes_hex": binary[offset:offset+length].hex(),
                        }
                    })

        current_step += 1
        if not current_step % progress_steps:
            update_progress(f"{current_step}/{total_steps} | YARA: {domain}/{subcat}")

    return findings


def generate_metadata(file_path, findings):
    total_hits = sum(len(hits) for hits in findings.values())

    return {
        "tool": "hexwalk",
        "version": HEXWALK_VERSION,
        "file": os.path.basename(file_path),
        "file_path": os.path.abspath(file_path),
        "file_size": os.path.getsize(file_path),
        "date": datetime.now().astimezone().isoformat(),
        "categories": len(findings),
        "total_hits": total_hits,
    }

def json_safe(obj):
    """
    Recursively convert objects into JSON-safe types.
    """

    if isinstance(obj, bytes):
        return obj.hex()   # or obj.decode(errors="ignore")

    elif isinstance(obj, dict):
        return {k: json_safe(v) for k, v in obj.items()}

    elif isinstance(obj, list):
        return [json_safe(v) for v in obj]

    elif isinstance(obj, tuple):
        return tuple(json_safe(v) for v in obj)

    return obj


def write_export(findings, filename, file_path):
    out = f"hexwalk_{filename}_export.json"

    safe_findings = make_findings_json_safe(findings)
    meta = generate_metadata(file_path, findings)

    export_obj = {
        "metadata": meta,
        "findings": safe_findings,
    }

    with open(out, "w", encoding="utf-8") as f:
        json.dump(json_safe(export_obj), f, indent=2)

    return out

def write_summary(summary_text, filename):
    out = f"hexwalk_{filename}_summary.txt"
    with open(out, "w", encoding="utf-8") as f:
        f.write(summary_text)
    return out

def generate_summary_text(findings, filename, file_path):
    meta = generate_metadata(file_path, findings)

    lines = []
    lines.append("Hexwalk Summary")
    lines.append("=" * 60)
    lines.append(f"File        : {meta['file']}")
    lines.append(f"Path        : {meta['file_path']}")
    lines.append(f"File size   : {meta['file_size']} bytes")
    lines.append(f"Date (UTC)  : {meta['date']}")
    lines.append(f"Categories  : {meta['categories']}")
    lines.append(f"Total hits  : {meta['total_hits']}")
    lines.append("=" * 60)
    lines.append("")

    for cat, hits in sorted(findings.items()):
        lines.append(f"{cat} ({len(hits)} hits)")

        keywords = {}
        for h in hits:
            k = h["match_key"]
            keywords[k] = keywords.get(k, 0) + 1

        for k, count in sorted(keywords.items(), key=lambda x: -x[1]):
            lines.append(f"  {k}: {count}")

        lines.append("")

    return "\n".join(lines)

def make_findings_json_safe(findings):
    safe = {}

    for cat, hits in findings.items():
        safe_hits = []
        for h in hits:
            safe_hit = h.copy()

            # Fix context
            ctx = h.get("context", {}).copy()
            if "bytes" in ctx:
                ctx["bytes_hex"] = ctx["bytes"].hex()
                del ctx["bytes"]

            safe_hit["context"] = ctx
            safe_hits.append(safe_hit)

        safe[cat] = safe_hits

    return safe

# ---------------- KEYWORDS -----------------
def load_cli_keywords(expr):
    """
    Build a synthetic keyword list from -k / --keyword.

    Supports:
      - literal keywords separated by |
      - regex:... expressions

    Example:
      root|admin|regex:\\bpassword\\b
    """
    keywords = []

    parts = expr.split("|")

    for part in parts:
        part = part.strip()
        if not part:
            continue

        keywords.append({
            "value": part,
            "domain": "search",
            "subcategory": "cli",
            "raw": part,
        })

    return keywords


def load_rules(base_dir: str):
    rules = {
        "plain": [],
        "regex": [],
        "yara": []
    }

    seen_plain = set()
    seen_regex = set()

    debug_log("Starting load_rules()")

    def process_txt_file(file: Path):
        category = file.parent.name
        subcategory = file.stem

        try:
            with file.open(encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()

                    if not line or line.startswith("#"):
                        continue

                    # ---------------- REGEX ----------------
                    if line.startswith("regex:"):
                        pattern = line[6:]

                        if pattern in seen_regex:
                            continue

                        try:
                            compiled = re.compile(pattern.encode(), re.IGNORECASE)
                        except re.error:
                            continue

                        seen_regex.add(pattern)

                        rules["regex"].append({
                            "pattern": pattern,
                            "compiled": compiled,
                            "domain": category,
                            "category": category,
                            "subcategory": subcategory,
                            "source": str(file),
                        })

                    # ---------------- PLAIN ----------------
                    else:
                        key = line.lower()

                        if key in seen_plain:
                            continue

                        seen_plain.add(key)

                        rules["plain"].append({
                            "value": line,
                            "domain": category,
                            "category": category,
                            "subcategory": subcategory,
                            "source": str(file),
                        })

        except Exception as e:
            debug_log(f"TXT load failed: {file} ({e})", "error")

    def process_yara_file(file: Path):
        if not YARA_AVAILABLE:
            return

        category = file.parent.name
        subcategory = file.stem

        try:
            compiled = yara.compile(filepath=str(file))

            rules["yara"].append({
                "compiled": compiled,
                "domain": category,
                "category": category,
                "subcategory": subcategory,
                "source": str(file),
            })

        except Exception as e:
            debug_log(f"YARA compile failed: {file} ({e})", "error")

    def scan_directory(root: Path):
        if not root.exists():
            return

        for file in root.rglob("*"):
            if not file.is_file():
                continue

            if file.suffix == ".txt":
                process_txt_file(file)

            elif file.suffix in (".yara", ".yar"):
                process_yara_file(file)

    # Scan base + user directories
    scan_directory(Path(base_dir))
    scan_directory(Path.home() / ".hexwalk" / "keywords")

    return rules


# ---------------- OD STYLE -----------------
def od_bc_view(data, offset, keyword, context=64):
    start = max(0, offset - context)
    end = min(len(data), offset + context)

    lines = []
    BYTES_PER_LINE = 8

    for i in range(start, end, BYTES_PER_LINE):
        chunk = data[i:i + BYTES_PER_LINE]

        # Offset
        line = f"{i:08X}  "

        # Hex bytes
        hex_part = " ".join(f"{b:02X}" for b in chunk)
        hex_part = hex_part.ljust(BYTES_PER_LINE * 3 - 1)

        # ASCII
        ascii_part = "".join(chr(b) if 32 <= b <= 126 else "." for b in chunk)

        # Highlight keyword (ASCII only)
#        if keyword in ascii_part:
#            ascii_part = ascii_part.replace(keyword, f"<[{keyword}]>")

        line += hex_part + "  " + ascii_part
        lines.append(line)

    return lines

# ---------------- TUI -----------------
class HexwalkTUI:
    def __init__(self, stdscr, binary, filename, file_path, keywords ):

        debug_init(CONFIG)

        # ---------- Core state ----------
        self.stdscr = stdscr
        self.binary = binary
        self.filename = filename
        self.file_path = file_path

        self.rules = load_rules(KEYWORD_DIR)

        # ---------- Ollama state ----------
        self.ollama_ok = False
        self.ollama_models = []
        self.ollama_error = None

        # ---------- Keyword Manager state ----------
        self.keyword_base_dir = Path.home() / ".hexwalk" / "keywords"
        self.keyword_base_dir.mkdir(parents=True, exist_ok=True)
        self.keywords_modified = False
        self._rescan_on_return = False

        ollama_cfg = CONFIG.get("ollama", {})

        if ollama_cfg.get("enabled"):
            ok, models, err = probe_ollama(
                ollama_cfg.get("url", ""),
                ollama_cfg.get("timeout", 5),
            )
            self.ollama_ok = ok
            self.ollama_models = models
            self.ollama_error = err

        # ---------- Initialize ----------
        self.stdscr.clear()
        self.stdscr.refresh()
        self.box = get_box_chars()
        self.arrows = get_tree_arrows()

        # ---------- Findings / tree ----------
        self.findings = {}
        self.categories = []
        self.category_tree = []
        self.tree_filter = None
        self.search_density = [0] * 60

        # ---------- UI state ----------
        self.cat_i = 0
        self.cat_offset = 0
        self.subcategory_keyword_state = {}

        self.pane = 0  # 0 = categories, 1 = hits, 2 = details
        self.hit_i = 0
        self.hit_offset = 0

        self.details_visible = False
        self.details_width = 48

        # ---------- Count column widths ----------
        self.count_widths = {
            "domain": 1,
            "subcategory": 1,
            "keyword": 1,
        }

        # ---------- Init curses ----------
        self.init_curses()

        self.show_splash_screen()

        # ---------- Draw empty base UI ----------
        self.draw_empty_layout()

        # ---------- Clear screen before scan ----------
        self.stdscr.clear()
        self.stdscr.refresh()

        # ---------- Run scan WITH progress ----------
        progress_win = None

        def progress_cb(progress, status):
            nonlocal progress_win
            progress_win = draw_progress_modal(
                self.stdscr,
                self.box,
                "HexWalk Scan",
                status,
                progress,
                win=progress_win,
                density=self.search_density,
                density_pairs=self.density_pairs
            )

        self.findings = search_rules(
            self.binary,
            self.rules,
            progress_cb=progress_cb,
            density=self.search_density
        )

        # ---------- Clear modal ----------
        self.stdscr.clear()
        self.stdscr.refresh()
        self.draw()

        # ---------- Build category tree ----------
        self.categories = sorted(self.findings.keys())
        self.category_tree = self.build_domain_tree()
        self.recompute_count_widths()

        # ---------- Enter main loop ----------
        self.main_loop()

    def recompute_count_widths(self):
        """
        Recompute count column widths per tree level.
        Call this after search or when filter changes.
        """
        widths = {
            "domain": 1,
            "subcategory": 1,
            "keyword": 1,
        }

        for node in self.category_tree:
            # domain
            if node["type"] == "domain":
                widths["domain"] = max(
                    widths["domain"],
                    len(str(node["count"]))
                )

                for sub in node.get("children", []):
                    # subcategory
                    widths["subcategory"] = max(
                        widths["subcategory"],
                        len(str(sub["count"]))
                    )

                    for kw in sub.get("children", []):
                        # keyword
                        widths["keyword"] = max(
                            widths["keyword"],
                            len(str(kw["count"]))
                        )

        self.count_widths = widths

