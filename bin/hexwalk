        modal_h = len(art[artix]) + 6
        modal_w = max(len(line) for line in art[artix]) + 6

        y = (h - modal_h) // 2
        x = (w - modal_w) // 2

        win = self.stdscr.subwin(modal_h, modal_w, y, x)

        density_colors = self.density_pairs or [curses.A_BOLD]

        # -------------------------------------------------
        # Enable NON-BLOCKING input
        # -------------------------------------------------
        self.stdscr.nodelay(True)
        curses.flushinp()

        def heat_value(x, y, t):
            return (
                math.sin(x * 0.15 + t) +
                math.cos(y * 0.25 - t * 0.7) +
                math.sin((x + y) * 0.1 + t * 0.5)
            )

        start = time.time()

        while True:
            # -----------------------------
            # EXIT on keypress
            # -----------------------------
            key = self.stdscr.getch()
            if key != -1:
                break

            # -----------------------------
            # EXIT on timeout
            # -----------------------------
            if time.time() - start > splash_sleep:
                break

            t = time.time() - start

            win.erase()
            draw_box(win, modal_h, modal_w, self.box)

            for i, line in enumerate(art[artix]):
                row = 2 + i
                col = (modal_w - len(line)) // 2

                for j, ch in enumerate(line):
                    if ch == "¤":
                        continue

                    nx = j / max(1, len(line))
                    ny = i / max(1, len(art[artix]))

                    v = heat_value(nx * 10, ny * 10, t)
                    v = (v + 3) / 6
                    v = max(0.0, min(1.0, v))
                    v = v ** 0.6

                    idx = int(v * (len(density_colors) - 1))
                    idx = max(0, min(len(density_colors) - 1, idx))

                    attr = density_colors[idx] | curses.A_BOLD

                    try:
                        win.addch(row, col + j, ch, attr)
                    except curses.error:
                        pass

            footer = "Press any key to continue..."
            win.addstr(
                modal_h - 2,
                (modal_w - len(footer)) // 2,
                footer,
                curses.A_DIM
            )

            win.noutrefresh()
            curses.doupdate()

            time.sleep(0.02)

        # -------------------------------------------------
        # Restore blocking input (IMPORTANT)
        # -------------------------------------------------
        self.stdscr.nodelay(False)
        curses.flushinp()


    def build_heatmap(self, hits, width):
        """
        Build heatmap string for given hits and screen width.
        """

        if not hits or width <= 0:
            return ""

        file_size = len(self.binary)
        if file_size == 0:
            return ""

        # Number of blocks = width
        block_size = max(1, file_size // width)

        blocks = [0] * width

        for h in hits:
            offset = h.get("context", {}).get("offset", 0)

            idx = min(width - 1, offset // block_size)
            blocks[idx] += 1

        max_hits = max(blocks) or 1

        # Normalize 0.0–1.0
        normalized = [b / max_hits for b in blocks]

        return normalized

    def show_heatmap(self):
        import curses
        import math

        show_density = True
        show_entropy = True
        scale_mode = "log"
        entropy_contrast = False

        h, w = self.stdscr.getmaxyx()

        # ---------- Modal geometry ----------
        mh = min(200, h)
        mw = min(200, w)
        y = (h - mh) // 2
        x = (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)

        # ---------- Grid ----------
        grid_h = mh - 11
        grid_w = mw - 6

        file_size = len(self.binary)

        # ---------- Hits ----------
        hits = self.filtered_hits()
        if not hits:
            hits = []
            for v in self.findings.values():
                hits.extend(v)

        total_cells = grid_h * grid_w
        if total_cells <= 0:
            return

        bytes_per_cell = max(1, file_size // total_cells)

        # ==========================================================
        # DENSITY MAP
        # ==========================================================
        density = [0] * total_cells

        for hit in hits:
            start = hit["context"]["offset"]
            length = hit.get("match_length", 1)
            end = start + length

            start_idx = start // bytes_per_cell
            end_idx = end // bytes_per_cell

            for idx in range(start_idx, min(end_idx + 1, total_cells)):
                density[idx] += 1

        max_density = max(density) if density else 1

        # ==========================================================
        # ENTROPY MAP
        # ==========================================================
        def shannon_entropy(data):
            if not data:
                return 0.0

            freq = [0] * 256
            for b in data:
                freq[b] += 1

            ent = 0.0
            length = len(data)

            for count in freq:
                if count == 0:
                    continue
                p = count / length
                ent -= p * math.log2(p)

            return ent

        entropy_vals = []
        for i in range(total_cells):
            start = i * bytes_per_cell
            end = min(file_size, start + bytes_per_cell)
            entropy_vals.append(shannon_entropy(self.binary[start:end]))

        min_e = min(entropy_vals) if entropy_vals else 0.0
        max_e = max(entropy_vals) if entropy_vals else 8.0

        if abs(max_e - min_e) < 1e-6:
            min_e = 0.0
            max_e = 8.0


        # ==========================================================
        # HELPERS
        # ==========================================================
        def entropy_to_color(e):
            if not entropy_contrast:
                ratio = min(1.0, e / 8.0)
            else:
                ratio = (e - min_e) / (max_e - min_e)
                ratio = max(0.0, min(1.0, ratio))
                ratio = ratio ** 1.5

            # --- clamp ---
            ratio = max(0.0, min(1.0, ratio))

            idx = int(ratio * (len(self.entropy_pairs) - 1))
            idx = max(0, min(len(self.entropy_pairs) - 1, idx))

            return self.entropy_pairs[idx]

        def density_to_color(val):
            if max_density == 0:
                return curses.color_pair(0)

            if scale_mode == "linear":
                ratio = val / max_density

            elif scale_mode == "log":
                ratio = math.log1p(val) / math.log1p(max_density)

            elif scale_mode == "sqrt":
                ratio = math.sqrt(val) / math.sqrt(max_density)

            else:
                ratio = val / max_density

            # --- clamp ratio ---
            ratio = max(0.0, min(1.0, ratio))

            idx = int(ratio * (len(self.density_pairs) - 1))

            # --- clamp index (critical) ---
            idx = max(0, min(len(self.density_pairs) - 1, idx))

            return self.density_pairs[idx]


        def render_cell(d, e):
            if show_density and show_entropy:
                return density_to_color(d) if d > 0 else entropy_to_color(e)
            elif show_density:
                return density_to_color(d)
            elif show_entropy:
                return entropy_to_color(e)
            else:
                return curses.color_pair(0)

        def cell_to_offset(cx, cy):
            idx = cy * grid_w + cx
            return min(file_size - 1, idx * bytes_per_cell)

        # ==========================================================
        # CURSOR
        # ==========================================================
        cursor_x = 0
        cursor_y = 0

        # ==========================================================
        # LOOP
        # ==========================================================
        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)

            # ---------- Title ----------
            active = []
            if show_density:
                active.append("DENSITY")
            if show_entropy:
                active.append("ENTROPY")

            mode_label = "+".join(active) if active else "NONE"
            contrast_label = "C" if entropy_contrast else "N"

            idx = cursor_y * grid_w + cursor_x
            d = density[idx]
            e = entropy_vals[idx]

            title = f" Heatmap | {mode_label} | Scale:{scale_mode.upper()} | Entropy:{contrast_label} | D:{d:2d} E:{e:2.2f} "
            win.addstr(1, 2, title[:mw - 4], curses.A_BOLD)

            # ======================================================
            # DIVIDER
            # ======================================================
            divider_y = 2

            for gx in range(grid_w):
                try:
                    win.addstr(divider_y, 3 + gx, "─", curses.A_DIM)
                except curses.error:
                    pass

            # ======================================================
            # MINIMAP
            # ======================================================
            minimap_y = 3

            mini_cells = grid_w

            bytes_per_mini = max(1, file_size // mini_cells)

            mini_density = [0] * mini_cells
            for hit in hits:
                off = hit["context"]["offset"]
                idx = min(mini_cells - 1, off // bytes_per_mini)
                mini_density[idx] += 1


            for gx in range(mini_cells):
                start = gx * bytes_per_mini
                end = min(file_size, start + bytes_per_mini)

                # density
                d = mini_density[gx]
                for hit in hits:
                    off = hit["context"]["offset"]
                    if start <= off < end:
                        d += 1

                # entropy
                e = shannon_entropy(self.binary[start:end])

                attr = render_cell(d, e)

                # cursor projection
                cur_offset = cell_to_offset(cursor_x, cursor_y)
                if start <= cur_offset < end:
                    char = "█"
                    attr = self.cursor_pair | curses.A_BOLD
                else:
                    char = " "

                try:
                    win.addstr(minimap_y, 3 + gx, char, attr)
                except curses.error:
                    pass

            # ======================================================
            # DIVIDER
            # ======================================================
            divider_y = 4

            for gx in range(grid_w):
                try:
                    win.addstr(divider_y, 3 + gx, "─", curses.A_DIM)
                except curses.error:
                    pass
            # ======================================================
            # DRAW GRID
            # ======================================================
            grid_y = 5
            for gy in range(grid_h):
                for gx in range(grid_w):
                    idx = gy * grid_w + gx
                    d = density[idx]
                    e = entropy_vals[idx]

                    attr = render_cell(d, e)
                    char = " "

                    if gx == cursor_x and gy == cursor_y:
                        char = "█"
                        attr = self.cursor_pair | curses.A_BOLD

                    try:
                        win.addstr(grid_y + gy, 3 + gx, char, attr)
                    except curses.error:
                        pass
 
            # ======================================================
            # DIVIDER
            # ======================================================
            divider_y = grid_y + grid_h

            for gx in range(grid_w):
                try:
                    win.addstr(divider_y, 3 + gx, "─", curses.A_DIM)
                except curses.error:
                    pass

            # ==========================================================
            # LEGEND
            # ==========================================================
            legend_y = 6 + grid_h

            half_w = grid_w // 2
            remaining_w = grid_w - half_w

            # ---------- Density (LEFT half) ----------
            for gx in range(half_w):
                ratio = gx / (half_w - 1) if half_w > 1 else 0
                idx = int(ratio * (len(self.density_pairs) - 1))
                idx = max(0, min(len(self.density_pairs) - 1, idx))

                color = self.density_pairs[idx]

                try:
                    win.addstr(legend_y, 3 + gx, " ", color)
                except curses.error:
                    pass
            win.addstr(legend_y + 1, 3, "Density", curses.A_BOLD)

            # ---------- Entropy (RIGHT half) ----------
            for gx in range(remaining_w):
                ratio = gx / (remaining_w - 1) if remaining_w > 1 else 0
                idx = int(ratio * (len(self.entropy_pairs) - 1))
                idx = max(0, min(len(self.entropy_pairs) - 1, idx))

                color = self.entropy_pairs[idx]

                try:
                    win.addstr(legend_y, 3 + half_w + gx, " ", color)
                except curses.error:
                    pass
            win.addstr(legend_y + 1, 3 + half_w, "Entropy", curses.A_BOLD)

            # ======================================================
            # DIVIDER
            # ======================================================
            divider_y = legend_y + 2

            for gx in range(grid_w):
                try:
                    win.addstr(divider_y, 3 + gx, "─", curses.A_DIM)
                except curses.error:
                    pass
            # ======================================================
            # STATUS
            # ======================================================
            status = " [d] density  [D] scale | [e] entropy  [E] contrast | arrows move | enter jump | q "
            status = status.ljust(grid_w)[:grid_w]
            win.addnstr(mh - 2, 3, status, mw - 4,
                        curses.color_pair(COLOR_STATUS) | curses.A_BOLD)

            win.refresh()

            key = win.getch()

            if key in (ord("q"), 27):
                break

            elif key == ord("d"):
                show_density = not show_density

            elif key == ord("D"):
                scale_mode = {"linear": "log", "log": "sqrt", "sqrt": "linear"}[scale_mode]

            elif key == ord("e"):
                show_entropy = not show_entropy

            elif key == ord("E"):
                entropy_contrast = not entropy_contrast

            elif key == curses.KEY_LEFT:
                cursor_x = max(0, cursor_x - 1)

            elif key == curses.KEY_RIGHT:
                cursor_x = min(grid_w - 1, cursor_x + 1)

            elif key == curses.KEY_UP:
                cursor_y = max(0, cursor_y - 1)

            elif key == curses.KEY_DOWN:
                cursor_y = min(grid_h - 1, cursor_y + 1)

            elif key in (10, 13):  # ENTER
                target_offset = cell_to_offset(cursor_x, cursor_y)

                if not hits:
                    fake_hit = {
                        "context": {"offset": target_offset},
                        "match_length": 1,
                        "match_type": "raw",
                        "match_key": "<cursor>",
                    }
                    return self.show_hit_modal([fake_hit], 0)

                closest_idx = min(
                    range(len(hits)),
                    key=lambda i: abs(
                        hits[i]["context"]["offset"] - target_offset
                    )
                )

                self.show_hit_modal(hits, closest_idx)

            elif key == curses.KEY_MOUSE:
                try:
                    _, mx, my, _, bstate = curses.getmouse()
                except curses.error:
                    continue

                # minimap click
                if my == y + minimap_y:
                    gx = mx - (x + 3)

                    if 0 <= gx < grid_w:
                        offset = gx * bytes_per_mini

                        # move cursor to corresponding grid cell
                        idx = offset // bytes_per_cell
                        cursor_y = idx // grid_w
                        cursor_x = idx % grid_w


    def draw_empty_layout(self):
        """
        Draw the base TUI layout without any data.
        This gives the modal something stable to sit on.
        """
        self.stdscr.clear()
        h, w = self.stdscr.getmaxyx()

        # Top header
        header = f" Hexwalk v{HEXWALK_VERSION}  |  Loading…"
        self.stdscr.addstr(
            0, 0,
            header[:w - 1].ljust(w - 1),
            curses.color_pair(COLOR_TOPHEADER) | curses.A_BOLD
        )

        # Pane headers
        self.stdscr.addstr(1, 0, "Categories".ljust(CAT_W), curses.A_BOLD)
        self.stdscr.addstr(1, CAT_W + 3, "Hits".ljust(20), curses.A_BOLD)
        self.stdscr.addstr(
            1,
            w - self.details_width - 1,
            "Details".ljust(self.details_width),
            curses.A_BOLD
        )

        # Vertical separators
        for y in range(1, h - 1):
            self.stdscr.addch(y, CAT_W + 1, curses.ACS_VLINE)
            self.stdscr.addch(y, w - self.details_width - 2, curses.ACS_VLINE)

        # Status bar
        self.stdscr.addstr(
            h - 1,
            0,
            "Initializing…".ljust(w - 1),
            curses.color_pair(COLOR_STATUS) | curses.A_BOLD
        )

        self.stdscr.refresh()

    def draw_progress_modal(
        stdscr,
        box_style,
        title,
        message,
        progress=None,
        win=None,
        density=None,
        density_pairs=None
    ):
        h, w = stdscr.getmaxyx()

        modal_h = 11
        modal_w = min(60, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2

        if win is None:
            win = stdscr.subwin(modal_h, modal_w, modal_y, modal_x)

        win.erase()
        draw_box(win, modal_h, modal_w, box_style)

        win.addstr(1, 2, title[: modal_w - 4], curses.A_BOLD)
        win.addstr(3, 2, message[: modal_w - 4])

        # -------------------------------------------------
        # Progress bar
        # -------------------------------------------------
        if progress is not None:
            bar_w = modal_w - 4
            filled = int(bar_w * max(0.0, min(1.0, progress)))
            bar = "█" * filled + " " * (bar_w - filled)

            win.addnstr(5, 2, bar, bar_w, curses.A_REVERSE)

            pct = f"{int(progress * 100):3d}%"
            win.addstr(6, modal_w - len(pct) - 2, pct)

        # -------------------------------------------------
        # Density heatmap (COLOR-BASED)
        # -------------------------------------------------
        if density and density_pairs:
            heat_y = 7
            heat_w = modal_w - 4

            max_val = max(density) or 1

            for i in range(min(heat_w, len(density))):
                val = density[i]

                # Normalize (same logic as big heatmap)
                ratio = val / max_val
                ratio = max(0.0, min(1.0, ratio))

                idx = int(ratio * (len(density_pairs) - 1))
                idx = max(0, min(len(density_pairs) - 1, idx))

                color = density_pairs[idx]

                try:
                    # space with background color = clean heat bar
                    win.addstr(heat_y, 2 + i, " ", color)
                except curses.error:
                    pass

        win.noutrefresh()
        curses.doupdate()

        return win


    def init_curses(self):
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(COLOR_CAT, COLOR_CAT_COL1, COLOR_CAT_COL2)
        curses.init_pair(COLOR_HIT, COLOR_HIT_COL1, COLOR_HIT_COL2)
        curses.init_pair(COLOR_HIGHLIGHT, COLOR_HIGHLIGHT_COL1, COLOR_HIGHLIGHT_COL2)
        curses.init_pair(COLOR_STATUS, COLOR_STATUS_COL1, COLOR_STATUS_COL2) 
        curses.init_pair(COLOR_TOPHEADER, COLOR_TOPHEADER_COL1, COLOR_TOPHEADER_COL2)
        curses.init_pair(COLOR_HEADER, COLOR_HEADER_COL1, COLOR_HEADER_COL2)
        curses.init_pair(10, 222, -1)  # plain
        curses.init_pair(11, 222, -1)  # regex
        curses.init_pair(12, 222, -1)  # yara
        curses.init_pair(13, 222, -1)  # multi
        self.stdscr.keypad(True)

        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)

        # ---------- Heatmap cursor color ----------
        CURSOR_PAIR_ID = 200
        curses.init_pair(CURSOR_PAIR_ID, curses.COLOR_BLACK, curses.COLOR_BLACK)
        self.cursor_pair = curses.color_pair(CURSOR_PAIR_ID)

        # ---------- Entropy palette (blue → green) ----------
        self.entropy_colors = [
            17, 18, 19, 20, 21,   # dark blue → blue
            27, 33, 39,           # cyan-ish
            45, 51                # green
        ]

        # ---------- Density palette (yellow → red) ----------
        self.density_colors = [
#            226, 220, 214,        # yellow → orange
#            208, 202, 196         # orange → red

            196, 202, 208, 214, 220, 226
        ]

        # Build pairs
        self.entropy_pairs = []
        self.density_pairs = []

        base_entropy = 60
        base_density = 80

        for i, c in enumerate(self.entropy_colors):
            curses.init_pair(base_entropy + i, 0, c)
            self.entropy_pairs.append(curses.color_pair(base_entropy + i))

        for i, c in enumerate(self.density_colors):
            curses.init_pair(base_density + i, 0, c)
            self.density_pairs.append(curses.color_pair(base_density + i))


    # ---------------- HELPERS -----------------

    def edit_prompt_modal(self, prompt_id):

        prompts = CONFIG.setdefault("prompts", {})

        if prompt_id not in prompts:
            return

        prompt = prompts[prompt_id]
        name = prompt.get("name", "")
        text = prompt.get("text", "")

        h, w = self.stdscr.getmaxyx()
        mh, mw = min(22, h - 4), min(90, w - 4)
        y, x = (h - mh) // 2, (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)
        curses.curs_set(0)

        # ---- Editor state ----
        mode = "name"  # or "text"
        name_buf = list(name)
        lines = text.splitlines() or [""]

        cy, cx = 0, 0

        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)

            # ---- Labels ----
            win.addstr(1, 2, "Name:", curses.A_BOLD)
            win.addstr(3, 2, "Prompt:", curses.A_BOLD)

            # ---- Name field ----
            win.addstr(1, 8, "".join(name_buf)[:mw - 10])

            # ---- Wrap prompt text ----
            wrapped = []
            wrap_map = []  # maps wrapped row → (line index, col offset)

            for li, line in enumerate(lines):
                chunks = textwrap.wrap(
                    line,
                    mw - 6,
                    replace_whitespace=False,
                    drop_whitespace=False
                ) or [""]

                for ci, chunk in enumerate(chunks):
                    wrapped.append(chunk)
                    wrap_map.append((li, ci))

            # ---- Render prompt ----
            max_rows = mh - 8
            for i, row in enumerate(wrapped[:max_rows]):
                win.addstr(4 + i, 4, row)

            # ---- Footer (commands) ----
            footer = "[Tab] Switch Field   [Enter] Save   [Esc] Cancel"
            win.addstr(mh - 2, 2, footer[:mw - 4])

            # ---- Cursor placement (LAST) ----
            if mode == "name":
                cx_vis = min(len(name_buf), mw - 12)
                win.move(1, 8 + cx_vis)
            else:
                wy = sum(
                    len(
                        textwrap.wrap(
                            lines[i],
                            mw - 6,
                            replace_whitespace=False,
                            drop_whitespace=False
                        ) or [""]
                    )
                    for i in range(cy)
                )
                wx = min(cx, mw - 7)
                win.move(4 + wy, 4 + wx)

            win.refresh()
            ch = win.getch()

            # ---- Global controls ----
            if ch == 27:  # ESC
                curses.curs_set(0)
                return

            elif ch in (10, 13):  # ENTER = save
                break

            elif ch == 9:  # TAB
                mode = "text" if mode == "name" else "name"

            # ---- Name edit ----
            elif mode == "name":
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    if name_buf:
                        name_buf.pop()
                elif 32 <= ch <= 126:
                    name_buf.append(chr(ch))

            # ---- Prompt edit ----
            else:
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    if cx > 0:
                        lines[cy] = lines[cy][:cx - 1] + lines[cy][cx:]
                        cx -= 1
                    elif cy > 0:
                        cx = len(lines[cy - 1])
                        lines[cy - 1] += lines[cy]
                        del lines[cy]
                        cy -= 1

                elif ch == curses.KEY_LEFT:
                    if cx > 0:
                        cx -= 1
                    elif cy > 0:
                        cy -= 1
                        cx = len(lines[cy])

                elif ch == curses.KEY_RIGHT:
                    if cx < len(lines[cy]):
                        cx += 1
                    elif cy < len(lines) - 1:
                        cy += 1
                        cx = 0

                elif ch == curses.KEY_UP:
                    if cy > 0:
                        cy -= 1
                        cx = min(cx, len(lines[cy]))

                elif ch == curses.KEY_DOWN:
                    if cy < len(lines) - 1:
                        cy += 1
                        cx = min(cx, len(lines[cy]))

                elif 32 <= ch <= 126:
                    lines[cy] = lines[cy][:cx] + chr(ch) + lines[cy][cx:]
                    cx += 1

        curses.curs_set(0)

        # ---- Save back (ID unchanged) ----
        prompt["name"] = "".join(name_buf).strip()
        prompt["text"] = "\n".join(lines)

    def show_prompt_manager_modal(self):

        prompts = CONFIG.setdefault("prompts", {})
        active = CONFIG.get("active_prompt")

        if not prompts:
            prompts["default"] = {
                "name": "Default",
                "text": "Analyze the following findings."
            }
            CONFIG["active_prompt"] = "default"
            active = "default"

        keys = list(prompts.keys())
        sel = keys.index(active) if active in keys else 0

        h, w = self.stdscr.getmaxyx()
        mh, mw = min(20, h - 4), min(80, w - 4)
        y, x = (h - mh) // 2, (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)

        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)
            win.addstr(1, 2, "Prompt Manager", curses.A_BOLD)

            for i, key in enumerate(keys):
                prompt = prompts[key]
                label = prompt["name"]
                suffix = " (active)" if key == active else ""
                attr = curses.A_REVERSE if i == sel else curses.A_NORMAL
                win.addstr(3 + i, 4, f"{label}{suffix}", attr)

            footer = "[Enter] Edit  [a] Add  [d] Delete  [Space] Activate  [q] Back"
            win.addstr(mh - 2, 2, footer[:mw - 4])
            win.refresh()

            ch = win.getch()

            if ch == curses.KEY_UP:
                sel = max(0, sel - 1)
            elif ch == curses.KEY_DOWN:
                sel = min(len(keys) - 1, sel + 1)

            elif ch in (10, 13):  # Edit
                self.edit_prompt_modal(keys[sel])
                keys = list(prompts.keys())

            elif ch == ord(" "):  # Set active
                CONFIG["active_prompt"] = keys[sel]
                CONFIG["ollama"]["active_prompt"] = keys[sel]
                active = keys[sel]

            elif ch == ord("a"):
                self.edit_prompt_modal()
                keys = list(prompts.keys())
                sel = len(keys) - 1

            elif ch == ord("d"):
                key = keys[sel]
                if len(keys) > 1:
                    del prompts[key]
                    if active == key:
                        active = keys[0]
                        CONFIG["active_prompt"] = active
                    keys = list(prompts.keys())
                    sel = max(0, sel - 1)

            elif ch in (ord("q"), 27):
                break

    def show_model_select_modal(self):

        url = CONFIG["ollama"]["url"].rstrip("/") + "/api/tags"

        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                models = [m["name"] for m in json.loads(r.read())["models"]]
        except Exception:
            return None

        if not models:
            return None

        sel = 0
        offset = 0

        h, w = self.stdscr.getmaxyx()
        mw = min(70, w - 4)
        mh = min(20, h - 4)
        y = (h - mh) // 2
        x = (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)

        visible_rows = mh - 6  # title + footer + borders

        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)
            win.addstr(1, 2, "Select Ollama Model", curses.A_BOLD)

            # ---- Scroll logic ----
            if sel < offset:
                offset = sel
            elif sel >= offset + visible_rows:
                offset = sel - visible_rows + 1

            # ---- Render list ----
            for row in range(visible_rows):
                idx = offset + row
                if idx >= len(models):
                    break

                model_name = models[idx]
                label = f"[{idx}] {model_name}"

                attr = curses.A_REVERSE if idx == sel else curses.A_NORMAL
                win.addstr(3 + row, 4, label[:mw - 8], attr)

            # ---- Scrollbar ----
            if len(models) > visible_rows:
                bar_height = max(1, int(visible_rows * visible_rows / len(models)))
                bar_pos = int(offset * visible_rows / len(models))

                for i in range(visible_rows):
                    win.addch(3 + i, mw - 3, "│")

                for i in range(bar_height):
                    if 0 <= bar_pos + i < visible_rows:
                        win.addch(3 + bar_pos + i, mw - 3, "█")

            # ---- Footer ----
            footer = "[↑↓ PgUp PgDn] Move  [Enter] Select  [q] Cancel"
            win.addstr(mh - 2, 2, footer[:mw - 4])

            win.refresh()
            key = win.getch()

            if key == curses.KEY_UP:
                sel = max(0, sel - 1)

            elif key == curses.KEY_DOWN:
                sel = min(len(models) - 1, sel + 1)

            elif key == curses.KEY_PPAGE:  # Page Up
                sel = max(0, sel - visible_rows)

            elif key == curses.KEY_NPAGE:  # Page Down
                sel = min(len(models) - 1, sel + visible_rows)

            elif key == curses.KEY_HOME:
                sel = 0

            elif key == curses.KEY_END:
                sel = len(models) - 1

            elif key in (10, 13):
                return models[sel]

            elif key in (ord("q"), 27):
                return None

    def edit_single_line(self, title, value):

        buf = list(value)
        pos = len(buf)  # cursor at end

        h, w = self.stdscr.getmaxyx()
        mh = 7
        mw = min(80, w - 4)
        sy = (h - mh) // 2
        sx = (w - mw) // 2

        win = curses.newwin(mh, mw, sy, sx)
        win.keypad(True)
        curses.curs_set(1)

        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)
            win.addstr(1, 2, title[:mw - 4], curses.A_BOLD)

            text = "".join(buf)
            win.addstr(3, 2, text[:mw - 4])
            win.move(3, 2 + min(pos, mw - 5))

            win.addstr(mh - 2, 2, "[Enter] Save   [Esc] Cancel")
            win.refresh()

            key = win.getch()

            # ESC
            if key == 27:
                curses.curs_set(0)
                return None

            # ENTER
            if key in (10, 13):
                curses.curs_set(0)
                return "".join(buf)

            # LEFT / RIGHT
            if key == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif key == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)

            # BACKSPACE (ALL variants)
            elif key in (
                curses.KEY_BACKSPACE,
                curses.ascii.BS,     # Ctrl+H (8)
                curses.ascii.DEL,    # 127
            ):
                if pos > 0:
                    buf.pop(pos - 1)
                    pos -= 1

            # DELETE
            elif key == curses.KEY_DC:
                if pos < len(buf):
                    buf.pop(pos)

            # HOME / END
            elif key == curses.KEY_HOME:
                pos = 0
            elif key == curses.KEY_END:
                pos = len(buf)

            # PRINTABLE CHAR
            elif curses.ascii.isprint(key):
                buf.insert(pos, chr(key))
                pos += 1

    def show_config_modal(self):

        # ---- Ensure config structure ----
        cfg = CONFIG.setdefault("ollama", {})
        cfg.setdefault("enabled", False)
        cfg.setdefault("url", "http://localhost:11434")
        cfg.setdefault("model", "")
        cfg.setdefault("timeout", 5)
        cfg.setdefault("prompts", {
            "Default": "You are a cybersecurity analyst.\n\nFindings:\n{findings}\n\nSummarize risks."
        })
        cfg.setdefault("active_prompt", "Default")

        items = [
            ("Enable",   "toggle"),
            ("URL",      "url"),
            ("Model",    "model"),
            ("Timeout",  "timeout"),
            ("Prompt",   "prompt"),
        ]

        sel = 0

        h, w = self.stdscr.getmaxyx()
        mw = min(80, w - 4)
        mh = min(18, h - 4)
        y = (h - mh) // 2
        x = (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)

        while True:
            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)

            win.addstr(1, 2, "HexWalk Configuration – Ollama", curses.A_BOLD)

            # ---- Render items ----
            for i, (label, key) in enumerate(items):
                attr = curses.A_REVERSE if i == sel else curses.A_NORMAL

                if key == "toggle":
                    val = "ON" if cfg["enabled"] else "OFF"
                elif key == "url":
                    val = cfg["url"]
                elif key == "model":
                    val = cfg["model"] or "<not set>"
                elif key == "timeout":
                    val = f"{cfg['timeout']}s"
                elif key == "prompt":
                    pid = CONFIG.get("active_prompt")
                    prompt = CONFIG.get("prompts", {}).get(pid, {})
                    val = prompt.get("name", "<none>")


                line = f"{label:<8}: {val}"
                win.addstr(3 + i, 4, line[:mw - 8], attr)

            footer = "[↑↓] Move  [Enter] Edit  [s] Save  [q] Cancel"
            win.addstr(mh - 2, 2, footer[:mw - 4])

            win.refresh()
            key = win.getch()

            # ---- Navigation ----
            if key == curses.KEY_UP:
                sel = max(0, sel - 1)
            elif key == curses.KEY_DOWN:
                sel = min(len(items) - 1, sel + 1)

            # ---- Activate / edit ----
            elif key in (10, 13):  # Enter
                _, item = items[sel]

                if item == "toggle":
                    cfg["enabled"] = not cfg["enabled"]

                elif item == "url":
                    new = self.edit_single_line("Edit Ollama URL", cfg["url"])
                    if new is not None:
                        cfg["url"] = new.strip()

                elif item == "timeout":
                    new = self.edit_single_line(
                        "Edit Timeout (seconds)",
                        str(cfg["timeout"])
                    )
                    if new and new.isdigit():
                        cfg["timeout"] = int(new)

                elif item == "model":
                    model = self.show_model_select_modal()
                    if model:
                        cfg["model"] = model

                elif item == "prompt":
                    self.show_prompt_manager_modal()


            # ---- Save ----
            elif key == ord("s"):
                save_config(CONFIG)
                break

            # ---- Cancel ----
            elif key in (ord("q"), 27):
                break


    def show_text_modal( self, title, text="", single_line=False, footer="[q] Close", on_key=None,):

        h, w = self.stdscr.getmaxyx()
        mh = min(30, h - 4)
        mw = min(110, w - 4)
        y = (h - mh) // 2
        x = (w - mw) // 2

        win = curses.newwin(mh, mw, y, x)
        win.keypad(True)

        offset = 0
        content_height = mh - 6
        content_width = mw - 6  # leave space for scrollbar

        while True:
            # ---- Re-wrap every redraw (safe for dynamic resize)
            wrapped = []
            for line in (text.splitlines() or [""]):
                wrapped.extend(textwrap.wrap(line, content_width) or [""])

            max_offset = max(0, len(wrapped) - content_height)
            offset = max(0, min(offset, max_offset))

            win.erase()
            win.box()
            draw_box(win, mh, mw, self.box)

            win.addstr(1, 2, title, curses.A_BOLD)

            # ---- Render content
            for i in range(content_height):
                idx = offset + i
                if idx < len(wrapped):
                    win.addstr(3 + i, 2, wrapped[idx][:content_width])

            # ---- Scrollbar
            if len(wrapped) > content_height:
                bar_height = max(
                    1, int(content_height * content_height / len(wrapped))
                )
                bar_pos = int(offset * content_height / len(wrapped))

                for i in range(content_height):
                    win.addch(3 + i, mw - 3, "│")

                for i in range(bar_height):
                    if 0 <= bar_pos + i < content_height:
                        win.addch(3 + bar_pos + i, mw - 3, "█")

            win.addstr(mh - 2, 2, footer[: mw - 4])

            win.refresh()
            key = win.getch()

            # ---- External key handler
            if on_key:
                on_key(key)

            # ---- Default controls
            if key in (ord("q"), 27):
                break

            elif key == curses.KEY_UP:
                offset -= 1

            elif key == curses.KEY_DOWN:
                offset += 1

            elif key == curses.KEY_PPAGE:
                offset -= content_height

            elif key == curses.KEY_NPAGE:
                offset += content_height

            elif key == curses.KEY_HOME:
                offset = 0

            elif key == curses.KEY_END:
                offset = max_offset


    def save_ai_output(self, text):
        """
        Save AI analysis output to current working directory.
        """

        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")

        safe_name = os.path.basename(self.filename) if hasattr(self, "filename") else "output"

        fname = f"hexwalk_{safe_name}_ai_{ts}.txt"
        full_path = os.path.abspath(fname)

        try:
            with open(fname, "w", encoding="utf-8") as f:
                f.write(text)

            self.show_text_modal(
                title="Saved",
                text=f"AI output saved to:\n\n{full_path}",
                footer="[q] Close"
            )

        except Exception as e:
            debug_log(f"Save failed: {e}")
            self.show_text_modal(
                title="Save Failed",
                text=str(e),
                footer="[q] Close"
            )

    def run_ai_analysis(self):
        import json
        import urllib.request
        import urllib.error
        import time
        import binascii

        cfg = CONFIG.get("ollama", {})
        url = cfg.get("url")
        model = cfg.get("model")
        timeout = cfg.get("timeout", 30)

        if not url or not model:
            return "Ollama is not configured."

        # --------------------------------------------------
        # Build prompt from configured prompt + real JSON schema
        # --------------------------------------------------
        prompts = CONFIG.get("prompts", {})
        active_id = CONFIG.get("active_prompt")
        prompt_obj = prompts.get(active_id)

        if not prompt_obj:
            return "No active AI prompt configured."

        base_prompt = prompt_obj.get("text", "").strip()

        lines = []
        total_hits = 0
        max_examples_per_category = 5
        max_total_examples = 100
        example_count = 0

        for cat, hits in sorted(self.findings.items()):
            if not hits:
                continue

            total_hits += len(hits)
            lines.append(f"\nCategory: {cat}")
            lines.append(f"Total Hits: {len(hits)}")

            for h in hits[:max_examples_per_category]:
                if example_count >= max_total_examples:
                    lines.append("  ... global example limit reached ...")
                    break

                context = h.get("context", {})

                offset = context.get("offset")
                bytes_hex = context.get("bytes_hex", "")

                # Derive ASCII preview from hex
                try:
                    raw_bytes = binascii.unhexlify(bytes_hex)
                    ascii_preview = "".join(
                        chr(b) if 32 <= b <= 126 else "."
                        for b in raw_bytes
                    )
                except Exception:
                    ascii_preview = "N/A"

                lines.append("  ---")
                lines.append(f"  Matched String: {h.get('string')}")
                lines.append(f"  Match Key: {h.get('match_key')}")
                lines.append(f"  Match Type: {h.get('match_type')}")
                lines.append(f"  Match Length: {h.get('match_len')}")
                lines.append(f"  Match Span: {h.get('match_span')}")
                lines.append(f"  Offset: {offset}")
                lines.append(f"  Hex Context: {bytes_hex}")
                lines.append(f"  ASCII Context (derived): {ascii_preview}")

                example_count += 1

            if example_count >= max_total_examples:
                break

        summary_block = "\n".join(lines) if lines else "No findings detected."

        prompt = f"""{base_prompt}

    File analyzed: {self.filename}
    Total findings: {total_hits}

    DETAILED FINDINGS WITH CONTEXT:
    {summary_block}

    ANALYSIS REQUIREMENTS:

    1. For each category:
       - Assess whether findings are meaningful artifacts or likely false positives.
       - Use surrounding hex context (bytes_hex) to evaluate plausibility.
       - Consider:
           • string termination
           • printable byte ratio
           • alignment
           • whether match appears embedded in structured data
           • repetition patterns
       - Provide probability score (0–100%) of meaningful artifact.

    2. Provide overall security relevance probability (0–100%).

    3. Base conclusions strictly on evidence provided.

    4. Do NOT speculate beyond data.

    5. Maintain deterministic structure.

    6. Keep report under 800 words.
    """

        # --------------------------------------------------
        # Streaming modal with spinner
        # --------------------------------------------------
        h, w = self.stdscr.getmaxyx()
        mh = min(35, h - 4)
        mw = min(120, w - 4)
        y = (h - mh) // 2
        x = (w - mw) // 2

        modal = curses.newwin(mh, mw, y, x)
        modal.keypad(False)

        content = []
        spinner = ["|", "/", "-", "\\"]
        spinner_index = 0
        first_token = False

        payload = {
            "model": model,
            "prompt": prompt.strip(),
            "stream": True,
        }

        req = urllib.request.Request(
            url.rstrip("/") + "/api/generate",
            data=json.dumps(payload).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )

        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                last_spinner = time.time()

                for raw in resp:

                    if not first_token:
                        now = time.time()
                        if now - last_spinner > 0.1:
                            spinner_index = (spinner_index + 1) % len(spinner)
                            modal.erase()
                            modal.box()
                            draw_box(modal, mh, mw, self.box)

                            modal.addstr(
                                1, 2,
                                f"AI Analysis {spinner[spinner_index]}",
                                curses.A_BOLD
                            )

                            modal.addstr(
                                mh // 2,
                                (mw // 2) - 14,
                                "Waiting for model response..."
                            )

                            modal.refresh()
                            last_spinner = now

                    obj = json.loads(raw.decode())
                    token = obj.get("response")
                    if not token:
                        continue

                    first_token = True
                    content.append(token)

                    modal.erase()
                    modal.box()
                    h2, w2 = modal.getmaxyx()
                    draw_box(modal, h2, w2, self.box)

                    modal.addstr(1, 2, "AI Analysis (streaming)", curses.A_BOLD)

                    text = "".join(content)
                    wrapped = []
                    for ln in text.splitlines():
                        wrapped.extend(textwrap.wrap(ln, w2 - 4) or [""])

                    max_lines = h2 - 4
                    visible = wrapped[-max_lines:]

                    for i, ln in enumerate(visible):
                        modal.addstr(2 + i, 2, ln[: w2 - 4])

                    modal.refresh()

        except Exception as e:
            debug_log(f"AI error: {e}")
            return f"AI error:\n{e}"

        return "".join(content)


    def show_ai_summary_modal(self, ai_text):
        """
        Display AI-generated analysis in a scrollable modal.
        """
        if not ai_text or not ai_text.strip():
            ai_text = "No AI output available."

        self.show_text_modal(
            title="AI Summary",
            text=ai_text,
            footer="[↑↓ PgUp PgDn] Scroll   [s] Save   [q] Close",
            on_key=lambda k: self.save_ai_output(ai_text) if k == ord("s") else None
        )


    def confirm_quit(self):
        # --------------------------------------------------
        # Clear and redraw background cleanly
        # --------------------------------------------------
        self.stdscr.clear()
        self.draw()
        self.stdscr.refresh()

        h, w = self.stdscr.getmaxyx()

        # ---------- Modal geometry ----------
        modal_h = 7
        modal_w = 40
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2

        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)
        win.clear()
        draw_box(win, modal_h, modal_w, self.box)

        # ---------- Title ----------
        title = " Confirm Quit "
        win.addstr(
            0,
            max(2, (modal_w - len(title)) // 2),
            title,
            curses.A_BOLD
        )

        # ---------- Content ----------
        lines = [
            "Quit HexWalk?",
            "",
            "  y : Yes, quit",
            "  n : No, return",
        ]

        for i, line in enumerate(lines):
            win.addstr(2 + i, 2, line)

        win.refresh()

        # ---------- Input loop ----------
        while True:
            key = win.getch()

            if key in (ord("y"), ord("Y")):
                return True
            else:
                return False

    def expand_all(self):
        """Expand all domains and subcategories."""
        for d in self.category_tree:
            if d["type"] == "domain":
                d["expanded"] = True
                for s in d.get("children", []):
                    if s["type"] == "subcategory":
                        s["expanded"] = True


    def collapse_all(self):
        """Collapse all domains and subcategories."""
        for d in self.category_tree:
            if d["type"] == "domain":
                d["expanded"] = False
                for s in d.get("children", []):
                    if s["type"] == "subcategory":
                        s["expanded"] = False

    def format_top_header(self):
        parts = [
            f"Hexwalk v{HEXWALK_VERSION}",
            f"File: {self.file_path}",
        ]

        if self.tree_filter:
            parts.append(f"Filter: {self.tree_filter}")

        return " | ".join(parts)

    def find_subcategory_row_index(self, domain, subcat):
        """
        Find the row index of a given subcategory in the visible tree.
        """
        rows = self.visible_category_rows()
        target = f"{domain}/{subcat}"

        for i, node in enumerate(rows):
            if (
                node["type"] == "subcategory"
                and node["parent"] == domain
                and node["name"] == subcat
            ):
                return i
        return None


    def build_domain_tree(self):
        """
        Build tree structure from rules + findings.

        Tree levels:
        domain
            └─ subcategory
                └─ keyword

        Supports:
        - show_all (include zero-hit keywords)
        """

        tree = []
        tree_filter = self.tree_filter.lower() if self.tree_filter else None
        show_all = CONFIG.get("global", {}).get("show_all", False)

        # -------------------------------------------------
        # Group structure: domain -> subcategory -> keyword
        # -------------------------------------------------
        grouped = defaultdict(lambda: defaultdict(lambda: defaultdict(list)))

        # -------------------------------------------------
        # 1. Initialize ALL keywords from rules
        # -------------------------------------------------
        for rule in self.rules.get("plain", []):
            grouped[rule["domain"]][rule["subcategory"]][rule["value"]] = []

        for rule in self.rules.get("regex", []):
            grouped[rule["domain"]][rule["subcategory"]][rule["pattern"]] = []

        for rule in self.rules.get("yara", []):
            key = rule.get("rule_name") or Path(rule.get("source", "")).stem or "<yara>"
            grouped[rule["domain"]][rule["subcategory"]][key] = []

        # -------------------------------------------------
        # 2. Inject findings into grouped structure
        # -------------------------------------------------
        for category, hits in self.findings.items():
            if "/" not in category:
                continue

            domain, subcat = category.split("/", 1)

            for hit in hits:
                key = hit.get("match_key", "")

                # --- normalize ---
                if isinstance(key, bytes):
                    key = key.decode(errors="ignore")

                key = "".join(c for c in key if c.isprintable()).strip()

                # fallback
                if not key:
                    raw = hit.get("context", {}).get("bytes_hex", "")
                    key = f"<hex:{raw[:8]}>" if raw else "<binary>"

                grouped[domain][subcat][key].append(hit)

        # -------------------------------------------------
        # 3. Build tree nodes
        # -------------------------------------------------
        for domain in sorted(grouped.keys()):
            domain_total = 0

            domain_node = {
                "type": "domain",
                "name": domain,
                "display": domain.capitalize(),
                "expanded": False,
                "count": 0,
                "children": []
            }

            for subcat in sorted(grouped[domain].keys()):
                sub_total = 0

                sub_node = {
                    "type": "subcategory",
                    "name": subcat,
                    "parent": domain,
                    "display": subcat.replace("_", " ").capitalize(),
                    "expanded": False,
                    "count": 0,
                    "children": []
                }

                for key in sorted(grouped[domain][subcat].keys()):
                    hits = grouped[domain][subcat][key]

                    # Filter
                    if tree_filter and tree_filter not in key.lower():
                        continue

                    count = len(hits)

                    if count == 0 and not show_all:
                        continue

                    # -------------------------------------------------
                    # Match types
                    # -------------------------------------------------
                    if hits:
                        types = {h.get("match_type", "plain") for h in hits}
                        match_type = next(iter(types)) if len(types) == 1 else "multi"
                    else:
                        match_type = "none"

                    sub_total += count

                    sub_node["children"].append({
                        "type": "keyword",
                        "name": key,
                        "display": key,
                        "parent": f"{domain}/{subcat}",
                        "count": count,
                        "hits": hits,
                        "match_type": match_type,
                    })

                if sub_total == 0 and not show_all:
                    continue

                sub_node["count"] = sub_total
                domain_total += sub_total
                domain_node["children"].append(sub_node)

            if domain_total == 0 and not show_all:
                continue

            domain_node["count"] = domain_total
            tree.append(domain_node)

        return tree


    def filtered_hits(self):
        """
        Return hits based on current tree selection.
        Domain/Subcategory/Keyword aware.
        """
        sel = self.current_category_selection()
        if not sel:
            return []

        # DOMAIN → all hits under domain
        if sel["mode"] == "domain":
            domain = sel["domain"]
            hits = []
            for cat, cat_hits in self.findings.items():
                if cat.startswith(domain + "/"):
                    hits.extend(cat_hits)
            return hits

        # SUBCATEGORY → all hits in subcategory
        if sel["mode"] == "subcategory":
            return self.findings.get(sel["category"], [])

        # KEYWORD → only that keyword
        if sel["mode"] == "keyword":
            return [
                h for h in self.findings.get(sel["category"], [])
                if h["match_key"] == sel["keyword"]
            ]

        return []

    def safe_basename(self):
        """
        Return a filesystem-safe base name for exports.
        """
        base = os.path.basename(self.filename)
        # Replace anything non-alphanumeric with underscore
        base = re.sub(r"[^A-Za-z0-9._-]", "_", base)
        return base

    def clamp_category_scroll(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            self.cat_offset = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

        max_offset = max(0, len(rows) - 1)
        self.cat_offset = max(0, min(self.cat_offset, max_offset))


    # ---------------- HEADERS -----------------
    def draw_top_header(self, title):
        h, w = self.stdscr.getmaxyx()
        if w <= 1:
            return

        self.stdscr.addnstr(
            0,
            0,
            title.ljust(w),
            w,
            curses.color_pair(COLOR_TOPHEADER) | curses.A_BOLD | curses.A_DIM
        )

    def draw_header(self, y, x, width, title):
        if width <= 0:
            return

        max_w = self.stdscr.getmaxyx()[1]

        # Prevent writing into last column (curses wrap bug)
        safe_width = min(width, max_w - x - 1)
        if safe_width <= 0:
            return

        self.stdscr.addnstr(
            y,
            x,
            title.ljust(safe_width),
            safe_width,
            curses.color_pair(COLOR_HEADER) | curses.A_BOLD
        )


    def show_summary(self):
        """
        Use CLI summary generator for consistency.
        """

        summary_text = generate_summary_text(
            self.findings,
            self.filename,
            self.file_path
        )

        lines = summary_text.splitlines()

        # ---- Screen loop ----
        offset = 0

        while True:
            self.stdscr.clear()
            h, w = self.stdscr.getmaxyx()

            for i in range(h - 1):
                idx = offset + i
                if idx >= len(lines):
                    break
                self.stdscr.addstr(i, 0, lines[idx][:w - 1])

            status = "[ q ] back   [ e ] export summary to text"
            self.stdscr.addstr(
                h - 1,
                0,
                status[:w - 1],
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )

            self.stdscr.refresh()
            key = self.stdscr.getch()

            if key in (ord("q"), 27):
                break

            elif key == ord("e"):
                out = write_summary(summary_text, self.filename)

                msg = f"Summary exported to {out}"
                self.stdscr.addstr(
                    h - 2,
                    0,
                    msg[:w - 1],
                    curses.A_BOLD | curses.color_pair(COLOR_STATUS),
                )
                self.stdscr.refresh()
                curses.napms(1200)

            elif key == curses.KEY_DOWN:
                offset = min(offset + 1, max(0, len(lines) - h + 1))

            elif key == curses.KEY_UP:
                offset = max(0, offset - 1)


    def visible_category_rows(self):
        rows = []

        for domain in self.category_tree:
            rows.append(domain)
            if domain["expanded"]:
                for sub in domain["children"]:
                    rows.append(sub)
                    if sub["expanded"]:
                        rows.extend(sub["children"])

        return rows

    def current_category_selection(self):
        rows = self.visible_category_rows()
        if not rows:
            return None

        node = rows[self.cat_i]

        if node["type"] == "domain":
            return {
                "mode": "domain",
                "domain": node["name"],
            }

        if node["type"] == "subcategory":
            return {
                "mode": "subcategory",
                "category": f"{node['parent']}/{node['name']}",
            }

        if node["type"] == "keyword":
            return {
                "mode": "keyword",
                "category": node["parent"],
                "keyword": node["name"],
            }

    def clamp_category_index(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

    # ---------------- MODAL -----------------
    def show_hit_modal(self, hits, start_index):
        h, w = self.stdscr.getmaxyx()

        # ---------- Modal geometry ----------
        modal_h = min(37, h - 4)
        modal_w = min(120, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2

        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)

        # ---------- Layout constants ----------
        BYTES_PER_LINE = 16
        GROUP_SIZE = 8
        GROUP_GAP = 1

        INFO_LINES = 4
        INFO_PAD = 2
        STATUS_LINES = 1
        BORDER_LINES = 2

        def align_offset(off):
            return off - (off % BYTES_PER_LINE)

        def hex_col_for_byte(j):
            """
            Return column offset (relative to start of hex field)
            for byte index j, respecting GROUP_SIZE and GROUP_GAP.
            """
            group = j // GROUP_SIZE
            offset_in_group = j % GROUP_SIZE

            return (
                group * (GROUP_SIZE * 3 + GROUP_GAP + 1) +
                offset_in_group * 3
            )

        HEX_LINES = (
            modal_h
            - BORDER_LINES
            - INFO_LINES
            - INFO_PAD
            - STATUS_LINES
        )

        # ---------- Hex width calculation ----------
        groups = (BYTES_PER_LINE + GROUP_SIZE - 1) // GROUP_SIZE
        hex_width = (
            BYTES_PER_LINE * 3 - 1 +
            (groups - 1) * GROUP_GAP
        )

        data = self.binary
        idx = start_index
        total = len(hits)

        # Initial view offset
        offset = hits[idx]["context"]["offset"]
        view_offset = align_offset(max(0, offset - (HEX_LINES // 2) * BYTES_PER_LINE))

        while True:
            hit = hits[idx]
            offset = hit["context"]["offset"]
            match_len = hit["match_length"]

            win.clear()
            draw_box(win, modal_h, modal_w, self.box)

            # ---------- Info block ----------
            info = [
                f"Offset       : 0x{offset:08X}",
                f"Match type   : {hit['match_type']}",
                f"Match key    : {hit['match_key']}",
                f"String length: {match_len}",
            ]

            for i, line in enumerate(info):
                win.addstr(
                    1 + i,
                    2,
                    line[:modal_w - 4],
                    curses.A_BOLD | curses.color_pair(COLOR_CAT),
                )

            sep_y = 1 + INFO_LINES
            safe_hline(win, sep_y, 1, modal_w - 2, self.box["h"])

            # ---------- Hex view ----------
            hex_y = sep_y + INFO_PAD

            for i in range(HEX_LINES):
                line_start = view_offset + i * BYTES_PER_LINE
                if line_start >= len(data):
                    break

                chunk = data[line_start:line_start + BYTES_PER_LINE]

                # ---- Build grouped hex ----
                hex_chunks = []
                for j, b in enumerate(chunk):
                    hex_chunks.append(f"{b:02X}")
                    if (
                        (j + 1) % GROUP_SIZE == 0
                        and (j + 1) < BYTES_PER_LINE
                    ):
                        hex_chunks.append(" " * GROUP_GAP)

                hex_part = " ".join(hex_chunks).ljust(hex_width)

                ascii_part = "".join(
                    chr(b) if 32 <= b <= 126 else "."
                    for b in chunk
                )

                base_line = f"{line_start:08X}  {hex_part}  {ascii_part}"

                win.addstr(
                    hex_y + i,
                    2,
                    base_line[:modal_w - 4],
                    curses.color_pair(COLOR_CAT),
                )

                # ---------- Highlight matching bytes (line-safe) ----------
                match_start = offset
                match_end = offset + match_len

                line_start_abs = line_start
                line_end_abs = line_start + len(chunk)

                # Compute overlap between match and this line
                highlight_start = max(match_start, line_start_abs)
                highlight_end = min(match_end, line_end_abs)

                if highlight_start < highlight_end:
                    for abs_pos in range(highlight_start, highlight_end):
                        j = abs_pos - line_start_abs

                        # Hex highlight
                        HEX_START_X = 2 + 10  # offset + two spaces
                        hex_x = HEX_START_X + hex_col_for_byte(j)

                        win.addstr(
                            hex_y + i,
                            hex_x,
                            f"{chunk[j]:02X}",
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )

                        # ASCII highlight
                        ascii_x = (
                            2
                            + 10
                            + hex_width
                            + 3
                            + j
                        )
                        win.addstr(
                            hex_y + i,
                            ascii_x,
                            ascii_part[j],
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )

            # ---------- Status ----------
            status = f"<- -> navigate | ↑↓ scroll | q close  ({idx + 1}/{total})"
            win.addstr(
                modal_h - 2,
                2,
                status[:modal_w - 4],
                curses.A_BOLD | curses.color_pair(COLOR_STATUS),
            )

            win.refresh()

            # ---------- Input ----------
            key = win.getch()

            if key in (ord("q"), 27):
                break

            elif key == curses.KEY_UP:
                view_offset = align_offset( max(0, view_offset - BYTES_PER_LINE) )

            elif key == curses.KEY_DOWN:
                view_offset = align_offset( min( max(0, len(data) - BYTES_PER_LINE), view_offset + BYTES_PER_LINE,) )

            elif key == curses.KEY_RIGHT:
                if idx < total - 1:
                    idx += 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = align_offset(max( 0, offset - (HEX_LINES // 2) * BYTES_PER_LINE) )

            elif key == curses.KEY_LEFT:
                if idx > 0:
                    idx -= 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = align_offset( max( 0, offset - (HEX_LINES // 2) * BYTES_PER_LINE) )

    # ---------------- HELP -----------------
    def show_help(self):
        h, w = self.stdscr.getmaxyx()

        # ---------- Modal geometry ----------
        modal_h = min(37, h - 4)
        modal_w = min(120, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2

        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)

        # ---------- Help text ----------
        lines = [
            "HexWalk — Interactive Binary Analysis",
            "",
            "Panes:",
            "  Categories  : Domain / Subcategory / Keyword tree",
            "  Hits        : Matching contexts for selection",
            "  Details     : Hex + ASCII view of hit",
            "",
            "Global Navigation:",
            "  Tab            : Switch pane (Categories ↔ Hits)",
            "  Arrow Up/Down  : Move selection in active pane",
            "",
            "Tree Navigation (Categories pane):",
            "  Enter          : Expand / collapse domain or subcategory",
            "  Enter on key   : Collapse to subcategory (restore position)",
            "  Right Arrow    : Expand current node",
            "  Left Arrow     : Collapse current node",
            "  +              : Expand entire tree",
            "  -              : Collapse entire tree",
            "",
            "Hits & Inspection:",
            "  Enter          : Open hit inspection modal (Hits pane)",
            "  Arrow Up/Down  : Navigate between hits",
            "",
            "Filtering:",
            "  /              : Filter keywords globally (tree + counts)",
            "                   (active filter shown in header)",
            "",
            "Heatmap:",
            "  m              : Show Heatmap"
            "",
            "Actions:",
            "  s              : Show summary page",
            "  e              : Export findings to JSON",
            "  d              : Toggle details pane",
            "  [ / ]          : Resize details pane",
            "",
            "Keyword Management:",
            "  K              : Enter Keyword Management",
            "",
            "AI Analysis:",
            "  A              : Enter AI mode",
            "",
            "Help & Exit:",
            "  h              : Show this help",
            "  q / Esc        : Close help",
        ]

        # ---------- Scrolling ----------
        offset = 0
        visible_h = modal_h - 4  # borders + title + status

        while True:
            win.clear()
            draw_box(win, modal_h, modal_w, self.box)

            # ---------- Title ----------
            title = " Help "
            win.addstr(
                0,
                max(2, (modal_w - len(title)) // 2),
                title,
                curses.A_BOLD
            )

            # ---------- Content ----------
            for i in range(visible_h):
                idx = offset + i
                if idx >= len(lines):
                    break
                win.addstr(
                    1 + i,
                    2,
                    lines[idx][: modal_w - 4]
                )

            # ---------- Status ----------
            status = "↑↓ scroll | PgUp/PgDn | q / Esc close"
            win.addstr(
                modal_h - 2,
                2,
                status[: modal_w - 4],
                curses.A_BOLD | curses.color_pair(COLOR_STATUS),
            )

            win.refresh()

            key = win.getch()

            if key in (ord("q"), 27, 10, 13):
                break

            elif key == curses.KEY_DOWN:
                offset = min(offset + 1, max(0, len(lines) - visible_h))

            elif key == curses.KEY_UP:
                offset = max(0, offset - 1)

            elif key == curses.KEY_NPAGE:  # Page Down
                offset = min(
                    offset + visible_h,
                    max(0, len(lines) - visible_h)
                )

            elif key == curses.KEY_PPAGE:  # Page Up
                offset = max(0, offset - visible_h)


    # ---------------- CATEGORY NAME -----------------
    def format_category_name(self, name):
        base = os.path.splitext(name)[0]   # remove .txt (or any extension)
        if not base:
            return name
        return base[0].upper() + base[1:]


    # ---------------- DRAW -----------------
    def draw(self):
        self.stdscr.clear()
        h, w = self.stdscr.getmaxyx()

        if w < 20 or h < 5:
            self.stdscr.addstr(0, 0, "Terminal too small")
            self.stdscr.refresh()
            return

        if self.pane not in (0, 1):
            self.pane = 0

        self.clamp_category_scroll()
        self.clamp_category_index()

        # ---------- Layout constants ----------
        HITS_MIN_W = 40
        DETAILS_MIN_W = 50
        SEP_PAD = 1

        # ---------- Initial widths ----------
        cat_w = max(1, CAT_W)
        details_w = self.details_width if self.details_visible else 0

        cat_x = 0
        hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))

        if self.details_visible and hits_w < HITS_MIN_W:
            details_w = max(
                DETAILS_MIN_W,
                details_w - (HITS_MIN_W - hits_w)
            )
            details_w = max(0, details_w)
            hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))

        if hits_w < HITS_MIN_W:
            details_w = 0
            self.details_visible = False
            hits_w = w - cat_w - (1 + SEP_PAD)

        # ---------- X positions ----------
        sep1_x = cat_x + cat_w + SEP_PAD
        hits_x = sep1_x + 1 + SEP_PAD

        sep2_x = hits_x + hits_w + SEP_PAD if details_w else None
        details_x = sep2_x + 1 + SEP_PAD if sep2_x is not None else None

        hits = self.filtered_hits() or []

        if self.hit_i >= len(hits):
            self.hit_i = max(0, len(hits) - 1)

        # ---------- Clear panes ----------
        for y in range(0, h - 1):
            if cat_x + cat_w <= w:
                self.stdscr.addnstr(y, cat_x, " " * cat_w, cat_w)
            if hits_x + hits_w <= w:
                self.stdscr.addnstr(y, hits_x, " " * hits_w, hits_w)
            if self.details_visible and details_w > 0 and details_x + details_w <= w:
                self.stdscr.addnstr(y, details_x, " " * details_w, details_w)

        # ---------- Vertical separators ----------
        for y in range(0, h - 1):
            if sep1_x < w:
                self.stdscr.addch(y, sep1_x, self.box["v"])
            if self.details_visible and sep2_x is not None and sep2_x < w:
                self.stdscr.addch(y, sep2_x, self.box["v"])

        # ---------- Top Header ----------
        header = " " + self.format_top_header()
        self.draw_top_header(header)

        # ==========================================================
        # Categories
        # ==========================================================
        rows = self.visible_category_rows()
        cat_height = h - 3

        dw = self.count_widths['domain']
        sw = self.count_widths['subcategory']
        kw = self.count_widths['keyword']

        if self.cat_i < self.cat_offset:
            self.cat_offset = self.cat_i
        elif self.cat_i >= self.cat_offset + cat_height:
            self.cat_offset = self.cat_i - cat_height + 1

        self.draw_header(1, cat_x, cat_w, "Categories")

        for row in range(cat_height):
            idx = self.cat_offset + row
            if idx >= len(rows):
                break

            node = rows[idx]
            attr = curses.color_pair(COLOR_CAT)
            label = ""

            if node["type"] == "domain":
                arrow = (
                    self.arrows["expanded"]
                    if node["expanded"]
                    else self.arrows["collapsed"]
                )

                label = f"{arrow} [{node['count']:>{dw}}] {node['display']}"
                attr |= curses.A_BOLD

            elif node["type"] == "subcategory":
                arrow = (
                    self.arrows["expanded"]
                    if node["expanded"]
                    else self.arrows["collapsed"]
                )
                label = f"  {arrow} [{node['count']:>{sw}}] {node['display']}"

            elif node["type"] == "keyword":
                symbol, color_id = TYPE_INDICATOR.get(node.get("match_type"), ("?", COLOR_CAT))
                label = f"      [{node['count']:>{kw}}] {symbol} {node['name']}"
                attr |= curses.color_pair(color_id)

            if idx == self.cat_i and self.pane == 0:
                attr |= curses.A_REVERSE

            self.stdscr.addnstr(
                row + 2,
                cat_x,
                label.ljust(cat_w)[:cat_w],
                cat_w,
                attr
            )

        # ==========================================================
        # HITS (FIXED)
        # ==========================================================
        sel = self.current_category_selection()

        if sel and sel["mode"] == "keyword":
            keyword = sel["keyword"]

            # truncate to avoid UI overflow
            max_len = 40
            if len(keyword) > max_len:
                keyword = keyword[:max_len - 3] + "..."

            title = f"Hits [{keyword}]"

        elif sel and sel["mode"] == "subcategory":
            title = f"Hits [{sel['category'].split('/')[-1]}]"

        elif sel and sel["mode"] == "domain":
            title = f"Hits [{sel['domain']}]"

        else:
            title = "Hits"

        self.draw_header(1, hits_x, hits_w, title)

        hit_height = h - 3

        if self.hit_i < self.hit_offset:
            self.hit_offset = self.hit_i
        elif self.hit_i >= self.hit_offset + hit_height:
            self.hit_offset = self.hit_i - hit_height + 1

        max_width = max(1, min(hits_w - 1, w - hits_x - 1))

        for i in range(hit_height):
            idx = self.hit_offset + i
            if idx >= len(hits):
                break

            hit = hits[idx]

            row = i + 2
            col = hits_x

            if row >= h - 1:
                continue

            attr_normal = (
                curses.A_REVERSE
                if self.pane == 1 and idx == self.hit_i
                else curses.color_pair(COLOR_HIT)
            )

            attr_highlight = curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD

            data = hit.get("preview_bytes")
            if data is None:
                continue

            visible_bytes = data[:max_width]

            visible = "".join(
                chr(b) if 32 <= b <= 126 else "."
                for b in visible_bytes
            )

            match_offset = hit.get("match_offset", 0)
            match_length = hit.get("match_length", 0)

            h_start = max(0, min(match_offset, len(visible)))
            h_end = max(h_start, min(match_offset + match_length, len(visible)))

            try:
                x = col

                # BEFORE
                before = visible[:h_start]
                self.stdscr.addnstr(row, x, before, max_width, attr_normal)
                x += len(before)

                # MATCH
                if h_start < h_end:
                    match = visible[h_start:h_end]
                    remaining = max_width - (x - col)

                    if remaining > 0:
                        self.stdscr.addnstr(
                            row, x,
                            match[:remaining],
                            remaining,
                            attr_highlight
                        )
                        x += min(len(match), remaining)

                # AFTER
                after = visible[h_end:]
                remaining = max_width - (x - col)

                if remaining > 0:
                    self.stdscr.addnstr(
                        row, x,
                        after[:remaining],
                        remaining,
                        attr_normal
                    )

            except curses.error:
                pass

        # ==========================================================
        # Details
        # ==========================================================
        if self.details_visible and details_w > 0:
            SAFE_W = max(1, details_w - 2)
            self.draw_header(1, details_x, details_w - 2, "Details")

            if hits:
                hit = hits[self.hit_i]
                offset = hit["context"]["offset"]

                od_lines = od_bc_view(
                    self.binary,
                    offset,
                    hit.get("match_key", ""),
                    context=32
                )

                for i, line in enumerate(od_lines[:h - 2]):
                    self.stdscr.addnstr(
                        i + 2,
                        details_x,
                        line[:SAFE_W].ljust(SAFE_W),
                        SAFE_W,
                        curses.color_pair(COLOR_CAT)
                    )

        # ---------- Status bar ----------
        status = (
            " Tab pane | Enter open | / filter | "
            "K Keyword | d details | [ ] resize | "
            "H Heatmap | "
            "e export | h help | q quit"
        )

        if w > 1:
            self.stdscr.addnstr(
                h - 1,
                0,
                status[:w - 1].ljust(w - 1),
                w - 1,
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )

        self.stdscr.refresh()

    # ---------------- CATEGORY MANAGER -----------------
    def show_keyword_category_modal(self):
        import curses
        from pathlib import Path

        base_dir = Path.home() / ".hexwalk" / "keywords"
        base_dir.mkdir(parents=True, exist_ok=True)

        sel = 0
        offset = 0

        while True:
            categories = sorted(
                [p.name for p in base_dir.iterdir() if p.is_dir()]
            )

            h, w = self.stdscr.getmaxyx()
            mh = min(100, h - 2)
            mw = min(100, w - 0)
            y = (h - mh) // 2
            x = (w - mw) // 2

            win = curses.newwin(mh, mw, y, x)
            win.keypad(True)

            visible_rows = mh - 6

            # Adjust selection bounds
            if sel >= len(categories):
                sel = max(0, len(categories) - 1)

            while True:
                win.erase()
                win.box()
                draw_box(win, mh, mw, self.box)
                win.addstr(1, 2, "Manage Keywords – Categories", curses.A_BOLD)

                if sel < offset:
                    offset = sel
                elif sel >= offset + visible_rows:
                    offset = sel - visible_rows + 1

                # Render categories
                for row in range(visible_rows):
                    idx = offset + row
                    if idx >= len(categories):
                        break

                    label = f"[{idx}] {categories[idx]}"
                    attr = curses.A_REVERSE if idx == sel else curses.A_NORMAL
                    win.addstr(3 + row, 4, label[:mw - 8], attr)

                footer = "[Enter] Open  [a] Add  [d] Delete  [q] Back"
                win.addstr(mh - 2, 2, footer[:mw - 4])

                win.refresh()
                key = win.getch()

                if key == curses.KEY_UP:
                    sel = max(0, sel - 1)

                elif key == curses.KEY_DOWN:
                    sel = min(len(categories) - 1, sel + 1)

                elif key in (10, 13):  # Enter
                    if categories:
                        # Stub for next step
                        self.show_keyword_subcategory_modal(categories[sel])
                    break

                elif key == ord("a"):
                    name = self.edit_single_line(
                        "New Category Name",
                        ""
                    )
                    if name:
                        name = name.strip()
                        if self._valid_keyword_name(name):
                            (base_dir / name).mkdir(exist_ok=True)
                            self.reload_keywords_only()
                    break

                elif key == ord("d"):
                    if not categories:
                        continue
                    target = base_dir / categories[sel]
                    if any(target.iterdir()):
                        self.show_text_modal(
                            "Cannot Delete",
                            "Category is not empty.",
                        )
                    else:
                        target.rmdir()
                        self.reload_keywords_only()
                    break

                elif key in (ord("q"), 27):
                    if self.keywords_modified:
                        self.findings = {}
                    return


    def _validate_keyword_file(self, content: str):
        """
        Validate keyword file.
        - One keyword per line
        - Allow empty lines
        - Allow comments starting with #
        - Strip whitespace
        - Deduplicate
        """

        lines = content.splitlines()
        cleaned_lines = []
        seen = set()

        for i, line in enumerate(lines, start=1):
            raw = line.strip()

            if not raw:
                continue

            if raw.startswith("#"):
                cleaned_lines.append(raw)
                continue

            if not self._valid_keyword_name(raw):
                return False, None, f"Invalid keyword at line {i}: '{raw}'"

            lower = raw.lower()
            if lower in seen:
                continue

            seen.add(lower)
            cleaned_lines.append(raw)

        cleaned = "\n".join(cleaned_lines) + "\n"
        return True, cleaned, None

    def _valid_keyword_name(self, name: str) -> bool:
        return bool(re.fullmatch(r"[a-zA-Z0-9. _\-{}:,*\?\[\]\\]+", name))

    def show_keyword_subcategory_modal(self, category):
        from pathlib import Path

        base_dir = self.keyword_base_dir / category
        base_dir.mkdir(parents=True, exist_ok=True)

        sel = 0
        offset = 0

        while True:
            files = sorted(base_dir.glob("*.txt"))
            subcategories = [f.stem for f in files]

            h, w = self.stdscr.getmaxyx()
            mh = min(100, h - 2)
            mw = min(100, w - 0)
            y = (h - mh) // 2
            x = (w - mw) // 2

            win = curses.newwin(mh, mw, y, x)
            win.keypad(True)

            visible_rows = mh - 6

            if sel >= len(subcategories):
                sel = max(0, len(subcategories) - 1)

            while True:
                win.erase()
                win.box()
                draw_box(win, mh, mw, self.box)
                win.addstr(1, 2, f"Category: {category}", curses.A_BOLD)

                if sel < offset:
                    offset = sel
                elif sel >= offset + visible_rows:
                    offset = sel - visible_rows + 1

                for row in range(visible_rows):
                    idx = offset + row
                    if idx >= len(subcategories):
                        break

                    label = f"[{idx}] {subcategories[idx]}"
                    attr = curses.A_REVERSE if idx == sel else curses.A_NORMAL
                    win.addstr(3 + row, 4, label[:mw - 8], attr)

                footer = "[Enter] Edit  [a] Add  [d] Delete  [q] Back"
                win.addstr(mh - 2, 2, footer[:mw - 4])

                win.refresh()
                key = win.getch()

                if key == curses.KEY_UP:
                    sel = max(0, sel - 1)

                elif key == curses.KEY_DOWN:
                    sel = min(len(subcategories) - 1, sel + 1)

                elif key in (10, 13):  # Enter → Edit
                    if subcategories:
                        self.edit_keyword_file(category, subcategories[sel])
                    break

                elif key == ord("a"):  # Add subcategory
                    name = self.edit_single_line("New Subcategory Name", "")
                    if name:
                        name = name.strip()
                        if self._valid_keyword_name(name):
                            path = base_dir / f"{name}.txt"
                            path.touch(exist_ok=True)
                            self.reload_keywords_only()
                    break

                elif key == ord("d"):  # Delete subcategory
                    if not subcategories:
                        continue
                    target = base_dir / f"{subcategories[sel]}.txt"
                    target.unlink(missing_ok=True)
                    self.reload_keywords_only()
                    break

                elif key == ord("q"):
                    return


    def edit_keyword_file(self, category, subcategory):
        import os
        import tempfile
        import subprocess
        from pathlib import Path

        path = self.keyword_base_dir / category / f"{subcategory}.txt"
        path.parent.mkdir(parents=True, exist_ok=True)

        existing = ""
        if path.exists():
            existing = path.read_text(encoding="utf-8", errors="ignore")

        # ---- Create temp file ----
        with tempfile.NamedTemporaryFile(
            mode="w+",
            delete=False,
            suffix=".txt"
        ) as tmp:
            tmp_path = Path(tmp.name)
            tmp.write(existing)
            tmp.flush()

        # ---- Determine editor ----
        editor = os.environ.get("EDITOR", "vi")

        # ---- Suspend curses before launching editor ----
        curses.endwin()

        try:
            subprocess.call([editor, str(tmp_path)])
        finally:
            # Restore curses screen
            self.stdscr.refresh()

        # ---- Read edited content ----
        try:
            new_content = tmp_path.read_text(encoding="utf-8", errors="ignore")
        except Exception as e:
            self.show_text_modal("Error", f"Failed to read temp file:\n{e}")
            debug_log(f"Failed to read temp file: {e}")
            tmp_path.unlink(missing_ok=True)
            return

        tmp_path.unlink(missing_ok=True)

        # ---- Syntax validation ----
        valid, cleaned, error = self._validate_keyword_file(new_content)

        if not valid:
            self.show_text_modal("Keyword Validation Error", error)
            return

        # ---- Write final file ----
        path.write_text(cleaned, encoding="utf-8")

        # ---- Reload keywords only ----
        self.reload_keywords_only()


    def reload_keywords_only(self):
        self.rules = load_rules(KEYWORD_DIR)
        self._rescan_on_return = True

    # ---------------- MAIN LOOP -----------------
    def main_loop(self):
        while True:
            # ---- Auto re-scan if keywords changed ----
            if getattr(self, "_rescan_on_return", False):
                self._rescan_on_return = False

                def progress_cb(progress, status=None):
                    draw_progress_modal(
                        self.stdscr,
                        title="HexWalk Scan",
                        message="Scanning with updated keywords...",
                        progress=progress,
                        box_style = self.box
                    )

                self.findings = search_rules(
                    self.binary,
                    self.rules,
                    progress_cb=progress_cb,
                    density=self.search_density
                )

                # Clear modal after completion
                self.stdscr.clear()
                self.stdscr.refresh()

                self.category_tree = self.build_domain_tree()
                self.cat_i = 0
                self.cat_offset = 0
                self.hit_i = 0
                self.hit_offset = 0
                self.recompute_count_widths()
            # ---- Auto re-scan if keywords changed ----

            self.draw()
            key = self.stdscr.getch()

            # ==================================================
            # GLOBAL ACTIONS
            # ==================================================
            if key == ord("q"):
                if self.confirm_quit():
                    break

            elif key == ord("h"):
                self.show_help()

            # ==================================================
            # CONFIGURATION MODAL
            # ==================================================
            elif key == ord("c"):
                self.show_config_modal()

            # ==================================================
            # EXPAND / COLLAPSE ALL
            # ==================================================
            elif key == ord("+"):
                if self.pane == 0:
                    self.expand_all()
                    self.clamp_category_index()
                    self.clamp_category_scroll()

            elif key == ord("-"):
                if self.pane == 0:
                    self.collapse_all()
                    self.clamp_category_index()
                    self.clamp_category_scroll()

            # ==================================================
            # CATEGORY LEFT RIGHT NAVIGATION
            # ==================================================
            if self.pane == 0 and key in ( curses.KEY_RIGHT, curses.KEY_LEFT):
                rows = self.visible_category_rows()
                if not rows:
                    continue

                node = rows[self.cat_i]

                # RIGHT = expand
                if key == curses.KEY_RIGHT:
                    if node["type"] in ("domain", "subcategory") and not node["expanded"]:
                        node["expanded"] = True

                        # Restore last keyword position for subcategory
                        if node["type"] == "subcategory":
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                                self.cat_i = self.subcategory_keyword_state[key_id]

                        self.clamp_category_index()
                        self.clamp_category_scroll()

                # LEFT = collapse
                elif key == curses.KEY_LEFT:
                    if node["type"] in ("domain", "subcategory") and node["expanded"]:
                        node["expanded"] = False
                        self.clamp_category_index()
                        self.clamp_category_scroll()

                    elif node["type"] == "keyword":
                        # Collapse keyword → go to parent subcategory
                        parent = node["parent"]
                        domain, subcat = parent.split("/", 1)

                        self.subcategory_keyword_state[parent] = self.cat_i

                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx

                        self.clamp_category_index()
                        self.clamp_category_scroll()

            # ==================================================
            # ENTER — ACTIVATE / TOGGLE (MUST BE EARLY)
            # ==================================================
            elif key in (10, 13, curses.KEY_ENTER):
                if self.pane == 0:
                    rows = self.visible_category_rows()
                    if not rows:
                        continue

                    node = rows[self.cat_i]

                    # ---- Domain / Subcategory toggle ----
                    if node["type"] in ("domain", "subcategory"):
                        node["expanded"] = not node["expanded"]

                        # restore keyword position when expanding subcategory
                        if node["expanded"] and node["type"] == "subcategory":
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                                self.cat_i = self.subcategory_keyword_state[key_id]

                    # ---- Keyword → collapse back to subcategory ----
                    elif node["type"] == "keyword":
                        parent_cat = node["parent"]
                        domain, subcat = parent_cat.split("/", 1)

                        # remember keyword cursor position
                        self.subcategory_keyword_state[parent_cat] = self.cat_i

                        # collapse subcategory
                        for n in rows:
                            if (
                                n["type"] == "subcategory"
                                and n["parent"] == domain
                                and n["name"] == subcat
                            ):
                                n["expanded"] = False
                                break

                        # jump cursor to subcategory
                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx

                    self.clamp_category_index()
                    self.clamp_category_scroll()

                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.show_hit_modal(hits, self.hit_i)

            # ==================================================
            # TAB — SWITCH PANE
            # ==================================================
            elif key == 9:  # TAB
                self.pane = 1 if self.pane == 0 else 0

            # ==================================================
            # NAVIGATION
            # ==================================================
            elif key == curses.KEY_DOWN:
                if self.pane == 0:
                    self.cat_i += 1
                    self.clamp_category_index()
                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.hit_i = min(self.hit_i + 1, len(hits) - 1)

            elif key == curses.KEY_UP:
                if self.pane == 0:
                    self.cat_i -= 1
                    self.clamp_category_index()
                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.hit_i = max(self.hit_i - 1, 0)

            # ==================================================
            # HEATMAP
            # ==================================================
            elif key == ord("H"):
                self.show_heatmap()

            # ==================================================
            # FILTER
            # ==================================================
            elif key == ord("/"):
                curses.echo()
                self.stdscr.addstr(0, 0, "Filter: ")
                self.tree_filter = self.stdscr.getstr().decode().strip()
                curses.noecho()

                # rebuild tree with filter applied
                self.category_tree = self.build_domain_tree()
                self.recompute_count_widths()
                self.cat_i = 0
                self.cat_offset = 0
                self.hit_i = 0
                self.hit_offset = 0

            # ==================================================
            # SUMMARY / EXPORT
            # ==================================================
            elif key == ord("s"):
                self.show_summary()

            elif key == ord("e"):
                fname = f"hexwalk_{self.safe_basename()}_export.json"

                meta = generate_metadata(self.file_path, self.findings)
                safe_findings = make_findings_json_safe(self.findings)

                export_obj = {
                    "metadata": meta,
                    "findings": safe_findings,
                }

                with open(fname, "w", encoding="utf-8") as f:
                    json.dump(json_safe(export_obj), f, indent=2)

                h, w = self.stdscr.getmaxyx()
                msg = f"Exported to {fname}"
                self.stdscr.addstr(
                    h - 2,
                    0,
                    msg[:w - 1],
                    curses.A_BOLD | curses.color_pair(COLOR_STATUS),
                )
                self.stdscr.refresh()
                curses.napms(800)

                h, w = self.stdscr.getmaxyx()
                msg = f"Exported to {fname}"
                self.stdscr.addstr(
                    h - 2,
                    0,
                    msg[:w - 1],
                    curses.A_BOLD | curses.color_pair(COLOR_STATUS),
                )
                self.stdscr.refresh()
                curses.napms(800)

            # ==================================================
            # DETAILS PANE TOGGLES
            # ==================================================
            elif key == ord("d"):
                self.details_visible = not self.details_visible

            elif key == ord("["):
                self.details_width = max(20, self.details_width - 4)

            elif key == ord("]"):
                self.details_width = min(120, self.details_width + 4)

            # ==================================================
            # AI SUMMARY PANE
            # ==================================================
            elif key == ord("a") and self.ollama_ok:
                ai_output = self.run_ai_analysis()
                self.show_ai_summary_modal(ai_output)

            elif key == ord("K"):
                self.show_keyword_category_modal()


# ---------------- MAIN -----------------
def main():
    global CONFIG

    CONFIG = load_config()

    parser = argparse.ArgumentParser(
        description="Hexwalk – binary keyword scanner"
    )

    parser.add_argument(
        "file",
        help="File to analyze (binary or Intel HEX)",
    )

    parser.add_argument(
        "--summary",
        action="store_true",
        help="Write summary file and exit (no TUI)",
    )

    parser.add_argument(
        "--export",
        action="store_true",
        help="Write JSON export file and exit (no TUI)",
    )

    parser.add_argument(
        "-k", "--keyword",
        help="Ad-hoc keyword(s), e.g. 'root|admin|regex:\\bfoo\\b'",
    )

    parser.add_argument(
        "--show_all",
        action="store_true",
        help="Show all keywords",
    )

    parser.add_argument(
        "--hide_splash",
        action="store_true",
        help="Hide splash page",
    )

    parser.add_argument(
        "-d", "--debug",
        action="store_true",
        help="Enable config mode",
    )

    args = parser.parse_args()

    file_path = args.file
    filename = os.path.basename(file_path)

    if args.hide_splash:
        CONFIG["global"]["show_splash"] = False

    if args.show_all:
        CONFIG["global"]["show_all"] = True

    if args.debug:
        CONFIG["debug"]["enabled"] = True


    # ---------- Load binary ----------
    if is_hex_file(file_path):
        binary = hex_to_bin(file_path)
    else:
        binary = load_binary(file_path)

    # ---------- Load keywords ----------
    if args.keyword:
        keywords = load_cli_keywords(args.keyword)
    else:
        keywords = load_rules(KEYWORD_DIR)

    # ==================================================
    # NON-INTERACTIVE MODE (NO CURSES)
    # ==================================================
    if args.summary or args.export:
        matches = search_rules(binary, keywords)

        if not matches:
            print("No matches found.")
            sys.exit(0)

        if args.export:
            out = write_export(matches, filename, file_path)
            print(f"Wrote export: {out}")

        if args.summary:
            summary = generate_summary_text(matches, filename, file_path)
            out = write_summary(summary, filename)
            print(f"Wrote summary: {out}")

        sys.exit(0)

    # ==================================================
    # INTERACTIVE MODE (TUI-FIRST)
    # ==================================================
    curses.wrapper(
        lambda stdscr: HexwalkTUI(
            stdscr,
            binary=binary,
            filename=filename,
            file_path=file_path,
            keywords=keywords
        )
    )

if __name__=="__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
