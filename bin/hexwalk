# ---------------- HELPERS -----------------
def handle_exception(exc_type, exc_value, exc_traceback):
    try:
        curses.endwin()
    except:
        pass

    print("\n[HexWalk] Unexpected error occurred.")
    print("Run with --debug for details.")

    # Optional logging
    with open("/tmp/hexwalk_error.log", "w") as f:
        traceback.print_exception(exc_type, exc_value, exc_traceback, file=f)

#sys.excepthook = handle_exception

def make_json_safe(obj):
    if isinstance(obj, bytes):
        return obj.decode("latin1", errors="replace")

    elif isinstance(obj, dict):
        return {k: make_json_safe(v) for k, v in obj.items()}

    elif isinstance(obj, list):
        return [make_json_safe(v) for v in obj]

    return obj

def debug_init(cfg):
    global DEBUG_CFG
    DEBUG_CFG = cfg.get("debug", {})

def debug_log(message, section=None):
    """
    Safe debug logger that writes to file.
    Never prints to stdout (safe for curses).
    """
    if not DEBUG_CFG:
        return

    if not DEBUG_CFG.get("enabled", False):
        return

    if section and not DEBUG_CFG.get(section, True):
        return

    try:
        logfile = DEBUG_CFG.get("log_file", os.path.expanduser("~/.hexwalk_debug.log"))
        with open(logfile, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} | {message}\n")
    except Exception:
        debug_log(f"Unable to open config file")
        pass

