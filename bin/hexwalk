#!/usr/bin/env python3
# ===================================================
#
# NAME
#     hexwalk - keyword-based binary and firmware analysis tool
#
# SYNOPSIS
#     hexwalk [OPTIONS] <file>
#
# DESCRIPTION
#     HexWalk is a terminal-based analysis tool for inspecting raw binaries
#     and Intel HEX files using categorized keyword lists and pattern rules.
#     It scans files for embedded strings, configuration artifacts, credentials,
#     and other indicators commonly found in firmware, executables, and system
#     binaries.
#
#     Results are presented in an interactive curses-based interface with
#     category navigation, hit inspection, and a byte-accurate hex viewer.
#
# FEATURES
#     - Supports raw binaries and Intel HEX files
#     - Category-based keyword scanning
#     - Regex-based pattern matching
#     - Interactive TUI with hex and ASCII views
#     - Per-hit modal inspection with navigation
#     - Summary and export capabilities
#
# OPTIONS
#     -h, --help
#         Show help text and exit.
#
#     --version
#         Show version information and exit.
#
# INPUT
#     <file>
#         File to analyze. Can be a raw binary or Intel HEX file.
#
# FILES
#     /usr/local/share/hexwalk/*.txt
#         Keyword and rule definition files, one category per file.
#
# OUTPUT
#     hexwalk_<filename>_export.json
#         JSON export of all findings.
#
#     hexwalk_<filename>_summary.txt
#         Human-readable summary of findings.
#
# EXIT STATUS
#     0   Successful execution
#     1   Invalid arguments or file error
#
# AUTHOR
#     curiousmaster
#
# URL
#     https://github.com/curiousmaster/hexwalk
#
# LICENSE
#     MIT License
#
# ===================================================
import curses, os, sys, re, json
import argparse
from pathlib import Path
from datetime import datetime
from collections import defaultdict

HEXWALK_VERSION = "1.0"

KEYWORD_DIR = "/usr/local/share/hexwalk/keywords"

DOMAIN_RE = re.compile(r'^(\d+)_([a-zA-Z0-9_-]+)$')

COLOR_CAT = 1
COLOR_HIT = 2
COLOR_HIGHLIGHT = 3
COLOR_STATUS = 4
COLOR_TOPHEADER = 5
COLOR_HEADER = 6

COLOR_CAT_COL1 = curses.COLOR_CYAN
COLOR_CAT_COL2 = -1
COLOR_HIT_COL1 = curses.COLOR_YELLOW
COLOR_HIT_COL2 = -1
COLOR_HIGHLIGHT_COL1 = curses.COLOR_BLACK
COLOR_HIGHLIGHT_COL2 = curses.COLOR_GREEN
COLOR_STATUS_COL1 = curses.COLOR_WHITE
COLOR_STATUS_COL2 = curses.COLOR_BLUE
COLOR_TOPHEADER_COL1 = curses.COLOR_WHITE
COLOR_TOPHEADER_COL2 = curses.COLOR_BLUE
COLOR_HEADER_COL1 = curses.COLOR_WHITE
COLOR_HEADER_COL2 = curses.COLOR_BLACK


CAT_W = 32
DETAILS_W = 50
HITS_MIN_W = 10
SEP = 2

# ---------------- HELPERS -----------------
def get_tree_arrows():
    """
    Return safe expand/collapse arrows depending on terminal support.
    """
    try:
        "▸▾".encode(sys.stdout.encoding)
        return {
            #"collapsed": "▸",
            #"expanded":  "▾",
            "collapsed": ">",
            "expanded":  "v",
        }
    except Exception:
        return {
            "collapsed": ">",
            "expanded":  "v",
        }

def safe_hline(win, y, x, w, ch):
    if w <= 0:
        return
    try:
        win.addstr(y, x, ch * w)
    except curses.error:
        pass

def draw_box(win, h, w, box):
    """
    Safely draw a box using provided characters.
    Will NOT draw if the window is too small.
    """
    # Minimum viable box: 3x3
    if h < 3 or w < 3:
        return

    try:
        # Top
        win.addstr(0, 0, box["tl"] + box["h"] * (w - 2) + box["tr"])

        # Sides
        for y in range(1, h - 1):
            win.addstr(y, 0, box["v"])
            win.addstr(y, w - 1, box["v"])

        # Bottom
        win.addstr(h - 1, 0, box["bl"] + box["h"] * (w - 2) + box["br"])

    except curses.error:
        # Terminal resized or window invalid — ignore safely
        pass


def get_box_chars():
    """
    Return safe box-drawing characters depending on terminal support.
    """
    try:
        # If UTF-8 works, use proper box drawing
        "│".encode(sys.stdout.encoding)
        return {
            "v": "│",
            "h": "─",
            "tl": "┌",
            "tr": "┐",
            "bl": "└",
            "br": "┘",
        }
    except Exception:
        # Pure ASCII fallback
        return {
            "v": "|",
            "h": "-",
            "tl": "+",
            "tr": "+",
            "bl": "+",
            "br": "+",
        }

def draw_progress_modal(stdscr, title, message, progress=None):
    """
    Draw a centered modal progress window.
    progress: float between 0.0–1.0 or None
    """
    h, w = stdscr.getmaxyx()

    modal_h = 9
    modal_w = min(60, w - 4)
    modal_y = (h - modal_h) // 2
    modal_x = (w - modal_w) // 2

    win = stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
    win.clear()
    draw_box(win, modal_h, modal_w, self.box)

    win.keypad(False)

    # Title
    win.addstr(1, 2, title[: modal_w - 4], curses.A_BOLD)

    # Message
    win.addstr(3, 2, message[: modal_w - 4])

    # Progress bar
    if progress is not None:
        bar_w = modal_w - 4
        filled = int(bar_w * max(0.0, min(1.0, progress)))
        bar = "█" * filled + " " * (bar_w - filled)
        win.addstr(5, 2, bar, curses.A_REVERSE)

        pct = f"{int(progress * 100):3d}%"
        win.addstr(6, modal_w - len(pct) - 2, pct)

    win.refresh()
    return win


def normalize_rules(keywords):
    """
    Convert loaded keywords into normalized rule objects.
    """
    rules = []

    for kw in keywords:
        raw = kw["value"]

        if raw.startswith("regex:"):
            rules.append({
                "type": "regex",
                "pattern": raw[6:],   # strip "regex:"
                "raw": raw,
                "category": f"{kw['domain']}/{kw['subcategory']}",
            })
        else:
            rules.append({
                "type": "plain",
                "pattern": raw,
                "raw": raw,
                "category": f"{kw['domain']}/{kw['subcategory']}",
            })

    return rules

# ---------------- HEX FILE PARSER -----------------
def is_hex_file(file_path):
    try:
        with open(file_path, "rb") as f:
            for _ in range(10):  # only check first few lines
                line = f.readline()
                if not line:
                    break
                line = line.strip()
                if line:
                    return line.startswith(b":")
    except OSError:
        return False
    return False

def is_elf(binary):
    return binary.startswith(b"\x7fELF")

def load_binary(file_path):
    """Load a file as raw binary."""
    with open(file_path,"rb") as f:
        return f.read()

def hex_to_bin(file_path):
    """
    Convert an Intel HEX file to a flat binary image.

    Supports:
      - Data records (00)
      - End Of File (01)
      - Extended Linear Address (04)

    Unsupported record types are ignored safely.
    """
    memory = bytearray()
    max_addr = 0
    base_addr = 0  # Upper 16 bits from type 04 records

    with open(file_path, "r", encoding="ascii", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line.startswith(":"):
                continue

            try:
                byte_count = int(line[1:3], 16)
                address = int(line[3:7], 16)
                record_type = int(line[7:9], 16)
                data = line[9:9 + byte_count * 2]
            except ValueError:
                continue

            # ----- Data record -----
            if record_type == 0x00:
                abs_addr = base_addr + address
                bytes_data = bytes(
                    int(data[i:i + 2], 16)
                    for i in range(0, len(data), 2)
                )

                end_addr = abs_addr + len(bytes_data)
                if len(memory) < end_addr:
                    memory.extend(b"\x00" * (end_addr - len(memory)))

                memory[abs_addr:end_addr] = bytes_data
                max_addr = max(max_addr, end_addr)

            # ----- End Of File -----
            elif record_type == 0x01:
                break

            # ----- Extended Linear Address -----
            elif record_type == 0x04:
                base_addr = int(data, 16) << 16

            # ----- Ignore other record types safely -----
            else:
                continue

    return bytes(memory[:max_addr])

# ---------------- AHO-CORASICK SETUP -----------------

def build_ac_automaton(rules):
    """
    Build an Aho–Corasick automaton for plain keyword rules.
    """
    try:
        import ahocorasick
    except ImportError:
        raise RuntimeError(
            "pyahocorasick is required for optimized scanning. "
            "Install with: pip install pyahocorasick"
        )

    automaton = ahocorasick.Automaton()

    for rule in rules:
        automaton.add_word(
            rule["pattern"].lower(),
            rule
        )

    automaton.make_automaton()
    return automaton

# ---------------- PLAIN KEYWORD SCAN (AC) -----------------

def scan_plain_ac(binary, plain_rules, progress_cb=None):
    """
    Scan binary using Aho–Corasick for plain keywords.
    """
    text = binary.decode("latin1", errors="ignore").lower()
    automaton = build_ac_automaton(plain_rules)

    results = defaultdict(list)
    total = len(text)

    for idx, (end_pos, rule) in enumerate(automaton.iter(text)):
        start_pos = end_pos - len(rule["pattern"]) + 1

        ctx_start = max(0, start_pos - 32)
        ctx_end = min(len(binary), end_pos + 33)
        ctx_bytes = binary[ctx_start:ctx_end]

        ctx_ascii = "".join(
            chr(b) if 32 <= b <= 126 else "."
            for b in ctx_bytes
        )

        results[rule["category"]].append({
            "string": ctx_ascii,
            "match_key": rule["raw"],
            "match_span": (start_pos, end_pos + 1),
            "match_type": "plain",
            "context": {
                "offset": start_pos,
                "bytes": ctx_bytes,
            },
        })

        # ---- progress update every ~1% ----
        if progress_cb and idx % 500 == 0:
            progress_cb(end_pos / total)

    if progress_cb:
        progress_cb(1.0)

    return results

def search_keywords(binary, progress_cb=None):
    """
    Optimized keyword search using Aho–Corasick (plain)
    and regex scanning.

    progress_cb(phase, progress)
    """
    from collections import defaultdict
    import re

    results = defaultdict(list)

    # Decode ONCE for AC + regex (binary-safe)
    text = binary.decode("latin1", errors="ignore")

    # -------------------------------------------------
    # Load keywords
    # -------------------------------------------------
    keywords = load_keywords(KEYWORD_DIR)

    plain_keywords = []
    regex_rules = []

    for kw in keywords:
        val = kw["value"]

        if val.startswith("regex:"):
            try:
                regex_rules.append({
                    "pattern": re.compile(val[6:], re.IGNORECASE),
                    "domain": kw["domain"],
                    "subcategory": kw["subcategory"],
                    "raw": val,
                })
            except re.error:
                continue
        else:
            plain_keywords.append({
                "pattern": val.lower(),   # <-- STRING
                "domain": kw["domain"],
                "subcategory": kw["subcategory"],
                "raw": val,
            })

    # -------------------------------------------------
    # Plain keyword scan (Aho–Corasick)
    # -------------------------------------------------
    if progress_cb:
        progress_cb("plain", 0.0)

    try:
        import ahocorasick
    except ImportError:
        raise RuntimeError(
            "pyahocorasick required: pip install pyahocorasick"
        )

    automaton = ahocorasick.Automaton()
    for kw in plain_keywords:
        automaton.add_word(kw["pattern"], kw)
    automaton.make_automaton()

    haystack = text.lower()
    total_len = len(haystack)
    step = max(1, total_len // 200)

    for idx, (end_pos, kw) in enumerate(automaton.iter(haystack)):
        start = end_pos - len(kw["pattern"]) + 1

        context_start = max(0, start - 32)
        context_end = min(len(binary), end_pos + 33)
        context_bytes = binary[context_start:context_end]

        ascii_ctx = "".join(
            chr(b) if 32 <= b <= 126 else "."
            for b in context_bytes
        )

        cat = f"{kw['domain']}/{kw['subcategory']}"

        results[cat].append({
            "string": ascii_ctx,
            "match_key": kw["raw"],
            "match_span": (start, end_pos + 1),
            "match_len": end_pos + 1 - start,
            "match_type": "plain",
            "context": {
                "offset": start,
                "bytes": context_bytes,
            },
        })

        if progress_cb and idx % step == 0:
            progress_cb("plain", end_pos / total_len)

    # -------------------------------------------------
    # Regex scan
    # -------------------------------------------------
    if progress_cb:
        progress_cb("regex", 0.0)

    total_regex = len(regex_rules)
    regex_step = max(1, total_regex // 100)

    for i, rule in enumerate(regex_rules):
        for m in rule["pattern"].finditer(text):
            start, end = m.span()

            context_start = max(0, start - 32)
            context_end = min(len(binary), end + 32)
            context_bytes = binary[context_start:context_end]

            ascii_ctx = "".join(
                chr(b) if 32 <= b <= 126 else "."
                for b in context_bytes
            )

            cat = f"{rule['domain']}/{rule['subcategory']}"

            results[cat].append({
                "string": ascii_ctx,
                "match_key": rule["raw"],
                "match_span": (start, end),
                "match_len": end - start,
                "match_type": "regex",
                "context": {
                    "offset": start,
                    "bytes": context_bytes,
                },
            })

        if progress_cb and i % regex_step == 0:
            progress_cb("regex", i / total_regex)

    if progress_cb:
        progress_cb("done", 1.0)

    return dict(results)



def generate_metadata(file_path, findings):
    total_hits = sum(len(hits) for hits in findings.values())

    return {
        "tool": "hexwalk",
        "version": HEXWALK_VERSION,
        "file": os.path.basename(file_path),
        "file_path": os.path.abspath(file_path),
        "file_size": os.path.getsize(file_path),
        "date": datetime.now().astimezone().isoformat(),
        "categories": len(findings),
        "total_hits": total_hits,
    }

def write_export(findings, filename, file_path):
    out = f"hexwalk_{filename}_export.json"

    safe_findings = make_findings_json_safe(findings)
    meta = generate_metadata(file_path, findings)

    export_obj = {
        "metadata": meta,
        "findings": safe_findings,
    }

    with open(out, "w", encoding="utf-8") as f:
        json.dump(export_obj, f, indent=2)

    return out

def write_summary(summary_text, filename):
    out = f"hexwalk_{filename}_summary.txt"
    with open(out, "w", encoding="utf-8") as f:
        f.write(summary_text)
    return out

def generate_summary_text(findings, filename, file_path):
    meta = generate_metadata(file_path, findings)

    lines = []
    lines.append("Hexwalk Summary")
    lines.append("=" * 60)
    lines.append(f"File        : {meta['file']}")
    lines.append(f"Path        : {meta['file_path']}")
    lines.append(f"File size   : {meta['file_size']} bytes")
    lines.append(f"Date (UTC)  : {meta['date']}")
    lines.append(f"Categories  : {meta['categories']}")
    lines.append(f"Total hits  : {meta['total_hits']}")
    lines.append("=" * 60)
    lines.append("")

    for cat, hits in sorted(findings.items()):
        lines.append(f"{cat} ({len(hits)} hits)")

        keywords = {}
        for h in hits:
            k = h["match_key"]
            keywords[k] = keywords.get(k, 0) + 1

        for k, count in sorted(keywords.items(), key=lambda x: -x[1]):
            lines.append(f"  {k}: {count}")

        lines.append("")

    return "\n".join(lines)

def make_findings_json_safe(findings):
    safe = {}

    for cat, hits in findings.items():
        safe_hits = []
        for h in hits:
            safe_hit = h.copy()

            # Fix context
            ctx = h.get("context", {}).copy()
            if "bytes" in ctx:
                ctx["bytes_hex"] = ctx["bytes"].hex()
                del ctx["bytes"]

            safe_hit["context"] = ctx
            safe_hits.append(safe_hit)

        safe[cat] = safe_hits

    return safe

# ---------------- KEYWORDS -----------------
def load_keywords(base_dir: str):
    """
    Load keywords from keywords/<domain>/<subcategory>.txt
    Deduplicate globally (first occurrence wins).
    """
    base = Path(base_dir)
    keywords = []
    seen = set()

    for domain_dir in sorted(p for p in base.iterdir() if p.is_dir()):
        domain = domain_dir.name

        for file in sorted(domain_dir.glob("*.txt")):
            subcategory = file.stem

            with file.open(encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue

                    key = line.lower()
#                    if key in seen:
#                        continue

                    seen.add(key)

                    keywords.append({
                        "value": line,
                        "domain": domain,
                        "subcategory": subcategory,
                        "source": str(file),
                    })

    return keywords


# ---------------- OD STYLE -----------------
def od_bc_view(data, offset, keyword, context=64):
    start = max(0, offset - context)
    end = min(len(data), offset + context)

    lines = []
    BYTES_PER_LINE = 8

    for i in range(start, end, BYTES_PER_LINE):
        chunk = data[i:i + BYTES_PER_LINE]

        # Offset
        line = f"{i:08X}  "

        # Hex bytes
        hex_part = " ".join(f"{b:02X}" for b in chunk)
        hex_part = hex_part.ljust(BYTES_PER_LINE * 3 - 1)

        # ASCII
        ascii_part = "".join(chr(b) if 32 <= b <= 126 else "." for b in chunk)

        # Highlight keyword (ASCII only)
#        if keyword in ascii_part:
#            ascii_part = ascii_part.replace(keyword, f"<[{keyword}]>")

        line += hex_part + "  " + ascii_part
        lines.append(line)

    return lines

# ---------------- TUI -----------------
class HexwalkTUI:
    def __init__(self, stdscr, binary, filename, file_path, show_all=False):
        # ---------- Core state ----------
        self.stdscr = stdscr
        self.binary = binary
        self.filename = filename
        self.file_path = file_path
        self.show_all = show_all
    
        # ---------- Initialize ----------
        self.stdscr.clear()
        self.stdscr.refresh()
        self.box = get_box_chars()
        self.arrows = get_tree_arrows()

        # ---------- Findings / tree ----------
        self.findings = {}
        self.categories = []
        self.category_tree = []
        self.tree_filter = None
    
        # ---------- UI state ----------
        self.cat_i = 0
        self.cat_offset = 0
        self.category_scroll_state = {}
        self.subcategory_keyword_state = {}
    
        self.pane = 0  # 0 = categories, 1 = hits, 2 = details
        self.hit_i = 0
        self.hit_offset = 0
    
        self.filter_text = ""
        self.details_visible = False
        self.details_width = 48

        # ---------- Count column widths ----------
        self.count_widths = {
            "domain": 1,
            "subcategory": 1,
            "keyword": 1,
        }

        # ---------- Init curses ----------
        self.init_curses()

        # ---------- Draw empty base UI ----------
        self.draw_empty_layout()
    
        # ---------- Clear screen before scan ----------
        self.stdscr.clear()
        self.stdscr.refresh()
    
        # ---------- Progress callback ----------
        def progress_cb(phase, progress):
            if phase == "plain":
                self.show_progress_modal(
                    "Scanning",
                    "Searching plain keywords…",
                    progress
                )
            elif phase == "regex":
                self.show_progress_modal(
                    "Scanning",
                    "Searching regex rules…",
                    progress
                )
            elif phase == "done":
                self.show_progress_modal(
                    "Finalizing",
                    "Preparing interface…",
                    1.0
                )
    
        # ---------- Run scan WITH progress ----------
        self.findings = search_keywords(
            self.binary,
            progress_cb=progress_cb
        )
    
        # ---------- Clear modal ----------
        self.stdscr.clear()
        self.stdscr.refresh()
        self.draw()
    
        # ---------- Build category tree ----------
        self.categories = sorted(self.findings.keys())
        self.category_tree = self.build_domain_tree()
        self.recompute_count_widths()
    
        # ---------- Enter main loop ----------
        self.main_loop()

    def compute_count_widths(self):
        """
        Compute count column widths per tree level.
        Returns dict: level -> width
        """
        widths = {
            "domain": 0,
            "subcategory": 0,
            "keyword": 0,
        }
    
        for node in self.visible_category_rows():
            level = node.get("type")
            count = node.get("count")
    
            if level in widths and isinstance(count, int):
                widths[level] = max(widths[level], len(str(count)))
    
        # Enforce sane minimums
        for k in widths:
            widths[k] = max(1, widths[k])
    
        return widths

    def recompute_count_widths(self):
        """
        Recompute count column widths per tree level.
        Call this after search or when filter changes.
        """
        widths = {
            "domain": 1,
            "subcategory": 1,
            "keyword": 1,
        }
    
        for node in self.category_tree:
            # domain
            if node["type"] == "domain":
                widths["domain"] = max(
                    widths["domain"],
                    len(str(node["count"]))
                )
    
                for sub in node.get("children", []):
                    # subcategory
                    widths["subcategory"] = max(
                        widths["subcategory"],
                        len(str(sub["count"]))
                    )
    
                    for kw in sub.get("children", []):
                        # keyword
                        widths["keyword"] = max(
                            widths["keyword"],
                            len(str(kw["count"]))
                        )
    
        self.count_widths = widths

    def draw_empty_layout(self):
        """
        Draw the base TUI layout without any data.
        This gives the modal something stable to sit on.
        """
        self.stdscr.clear()
        h, w = self.stdscr.getmaxyx()
    
        # Top header
        header = f" Hexwalk v{HEXWALK_VERSION}  |  Loading…"
        self.stdscr.addstr(
            0, 0,
            header[:w - 1].ljust(w - 1),
            curses.color_pair(COLOR_TOPHEADER) | curses.A_BOLD
        )
    
        # Pane headers
        self.stdscr.addstr(1, 0, "Categories".ljust(CAT_W), curses.A_BOLD)
        self.stdscr.addstr(1, CAT_W + 3, "Hits".ljust(20), curses.A_BOLD)
        self.stdscr.addstr(
            1,
            w - self.details_width - 1,
            "Details".ljust(self.details_width),
            curses.A_BOLD
        )
    
        # Vertical separators
        for y in range(1, h - 1):
            self.stdscr.addch(y, CAT_W + 1, curses.ACS_VLINE)
            self.stdscr.addch(y, w - self.details_width - 2, curses.ACS_VLINE)
    
        # Status bar
        self.stdscr.addstr(
            h - 1,
            0,
            "Initializing…".ljust(w - 1),
            curses.color_pair(COLOR_STATUS) | curses.A_BOLD
        )
    
        self.stdscr.refresh()

    def show_progress_modal(self, title, message, progress=None):
        stdscr = self.stdscr
        h, w = stdscr.getmaxyx()
    
        modal_h = 9
        modal_w = min(60, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2
    
        # Create an independent window (IMPORTANT)
        win = curses.newwin(modal_h, modal_w, modal_y, modal_x)
        win.clear()
        draw_box(win, modal_h, modal_w, self.box)
    
        # Title
        win.addstr(
            1, 2,
            title[: modal_w - 4],
            curses.A_BOLD
        )
    
        # Message
        win.addstr(
            3, 2,
            message[: modal_w - 4]
        )
    
        # Progress bar
        if progress is not None:
            bar_w = modal_w - 4
            filled = int(bar_w * max(0.0, min(1.0, progress)))
            bar = "█" * filled + " " * (bar_w - filled)
    
            win.addstr(5, 2, bar, curses.A_REVERSE)
    
            pct = f"{int(progress * 100):3d}%"
            win.addstr(6, modal_w - len(pct) - 2, pct)
    
        # IMPORTANT: do NOT call refresh() here
        win.noutrefresh()
        curses.doupdate()

    def init_curses(self):
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(COLOR_CAT, COLOR_CAT_COL1, COLOR_CAT_COL2)
        curses.init_pair(COLOR_HIT, COLOR_HIT_COL1, COLOR_HIT_COL2)
        curses.init_pair(COLOR_HIGHLIGHT, COLOR_HIGHLIGHT_COL1, COLOR_HIGHLIGHT_COL2)
        curses.init_pair(COLOR_STATUS, COLOR_STATUS_COL1, COLOR_STATUS_COL2) 
        curses.init_pair(COLOR_TOPHEADER, COLOR_TOPHEADER_COL1, COLOR_TOPHEADER_COL2)
        curses.init_pair(COLOR_HEADER, COLOR_HEADER_COL1, COLOR_HEADER_COL2)
        self.stdscr.keypad(True)

    # ---------------- HELPERS -----------------
    def confirm_quit(self):
        # --------------------------------------------------
        # Clear and redraw background cleanly
        # --------------------------------------------------
        self.stdscr.clear()
        self.draw()
        self.stdscr.refresh()
    
        h, w = self.stdscr.getmaxyx()
    
        # ---------- Modal geometry ----------
        modal_h = 7
        modal_w = 40
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2
    
        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)
        win.clear()
        draw_box(win, modal_h, modal_w, self.box)
    
        # ---------- Title ----------
        title = " Confirm Quit "
        win.addstr(
            0,
            max(2, (modal_w - len(title)) // 2),
            title,
            curses.A_BOLD
        )
    
        # ---------- Content ----------
        lines = [
            "Quit HexWalk?",
            "",
            "  y : Yes, quit",
            "  n : No, return",
        ]
    
        for i, line in enumerate(lines):
            win.addstr(2 + i, 2, line)
    
        win.refresh()
    
        # ---------- Input loop ----------
        while True:
            key = win.getch()
    
            if key in (ord("y"), ord("Y")):
                return True
            else:
                return False
    
    def expand_all(self):
        """Expand all domains and subcategories."""
        for d in self.category_tree:
            if d["type"] == "domain":
                d["expanded"] = True
                for s in d.get("children", []):
                    if s["type"] == "subcategory":
                        s["expanded"] = True
    
    
    def collapse_all(self):
        """Collapse all domains and subcategories."""
        for d in self.category_tree:
            if d["type"] == "domain":
                d["expanded"] = False
                for s in d.get("children", []):
                    if s["type"] == "subcategory":
                        s["expanded"] = False

    def format_top_header(self):
        parts = [
            f"Hexwalk v{HEXWALK_VERSION}",
            f"File: {self.file_path}",
        ]

        if self.tree_filter:
            parts.append(f"Filter: {self.tree_filter}")

        return " | ".join(parts)

    def find_subcategory_row_index(self, domain, subcat):
        """
        Find the row index of a given subcategory in the visible tree.
        """
        rows = self.visible_category_rows()
        target = f"{domain}/{subcat}"
    
        for i, node in enumerate(rows):
            if (
                node["type"] == "subcategory"
                and node["parent"] == domain
                and node["name"] == subcat
            ):
                return i
        return None

    def build_domain_tree(self):
        """
        Build tree structure from self.findings only.
    
        Tree levels:
          domain
            └─ subcategory
                 └─ keyword
    
        Each node includes hit counts and expansion state.
        """
    
        from collections import defaultdict
    
        tree = []
        tree_filter = self.tree_filter.lower() if self.tree_filter else None
    
        # -------------------------------------------------
        # Group findings: domain -> subcategory -> keyword
        # -------------------------------------------------
        grouped = defaultdict(lambda: defaultdict(lambda: defaultdict(list)))
    
        for category, hits in self.findings.items():
            if "/" not in category:
                continue
    
            domain, subcat = category.split("/", 1)
    
            for hit in hits:
                key = hit["match_key"]
                grouped[domain][subcat][key].append(hit)
    
        # -------------------------------------------------
        # Build tree nodes
        # -------------------------------------------------
        for domain in sorted(grouped.keys()):
            domain_total = 0
            domain_node = {
                "type": "domain",
                "name": domain,
                "display": domain.capitalize(),
                "expanded": False,
                "count": 0,
                "children": []
            }
    
            for subcat in sorted(grouped[domain].keys()):
                sub_total = 0
                sub_node = {
                    "type": "subcategory",
                    "name": subcat,
                    "parent": domain,
                    "display": subcat.replace("_", " ").capitalize(),
                    "expanded": False,
                    "count": 0,
                    "children": []
                }
    
                for key in sorted(grouped[domain][subcat].keys()):
                    hits = grouped[domain][subcat][key]
    
                    # Apply filter (keyword-level)
                    if tree_filter and tree_filter not in key.lower():
                        continue
    
                    count = len(hits)
                    if count == 0 and not self.show_all:
                        continue
    
                    sub_total += count
                    sub_node["children"].append({
                        "type": "keyword",
                        "name": key,
                        "display": key,
                        "parent": f"{domain}/{subcat}",
                        "count": count,
                        "hits": hits,
                    })
    
                if sub_total == 0 and not self.show_all:
                    continue
    
                sub_node["count"] = sub_total
                domain_total += sub_total
                domain_node["children"].append(sub_node)
    
            if domain_total == 0 and not self.show_all:
                continue
    
            domain_node["count"] = domain_total
            tree.append(domain_node)
    
        return tree

    def filtered_hits(self):
        """
        Return hits based on current tree selection.
        Domain/Subcategory/Keyword aware.
        """
        sel = self.current_category_selection()
        if not sel:
            return []
    
        # DOMAIN → all hits under domain
        if sel["mode"] == "domain":
            domain = sel["domain"]
            hits = []
            for cat, cat_hits in self.findings.items():
                if cat.startswith(domain + "/"):
                    hits.extend(cat_hits)
            return hits
    
        # SUBCATEGORY → all hits in subcategory
        if sel["mode"] == "subcategory":
            return self.findings.get(sel["category"], [])
    
        # KEYWORD → only that keyword
        if sel["mode"] == "keyword":
            return [
                h for h in self.findings.get(sel["category"], [])
                if h["match_key"] == sel["keyword"]
            ]
    
        return []

    def safe_basename(self):
        """
        Return a filesystem-safe base name for exports.
        """
        base = os.path.basename(self.filename)
        # Replace anything non-alphanumeric with underscore
        base = re.sub(r"[^A-Za-z0-9._-]", "_", base)
        return base

    def clamp_category_scroll(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            self.cat_offset = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

        max_offset = max(0, len(rows) - 1)
        self.cat_offset = max(0, min(self.cat_offset, max_offset))

    def save_category_scroll(self):
        sel = self.current_category_selection()
        if not sel or sel["mode"] != "category":
            return

        key = sel["category"]
        self.category_scroll_state[key] = (self.cat_i, self.cat_offset)

    def restore_category_scroll(self):
        sel = self.current_category_selection()
        if not sel or sel["mode"] != "category":
            return

        key = sel["category"]
        if key in self.category_scroll_state:
            self.cat_i, self.cat_offset = self.category_scroll_state[key]

    # ---------------- HEADERS -----------------
    def draw_top_header(self, title):
        h, w = self.stdscr.getmaxyx()
        if w <= 1:
            return

        self.stdscr.addnstr(
            0,
            0,
            title.ljust(w),
            w,
            curses.color_pair(COLOR_TOPHEADER) | curses.A_BOLD | curses.A_DIM
        )

    def draw_header(self, y, x, width, title):
        if width <= 0:
            return

        max_w = self.stdscr.getmaxyx()[1]

        # Prevent writing into last column (curses wrap bug)
        safe_width = min(width, max_w - x - 1)
        if safe_width <= 0:
            return

        self.stdscr.addnstr(
            y,
            x,
            title.ljust(safe_width),
            safe_width,
            curses.color_pair(COLOR_HEADER) | curses.A_BOLD
        )
    # ---------------- SUMMARY -----------------
    def build_summary(self):
        """
        Build a summary structure:
        {
            category: {
                "total": int,
                "keywords": { keyword: count }
            }
        }
        """
        summary = {}
    
        for category, hits in self.findings.items():
            cat_summary = {
                "total": len(hits),
                "keywords": {}
            }
    
            for h in hits:
                kw = (
                    h["match_key"][6:]
                    if h["match_key"].startswith("regex:")
                    else h["match_key"]
                )
                cat_summary["keywords"][kw] = (
                    cat_summary["keywords"].get(kw, 0) + 1
                )
    
            summary[category] = cat_summary
    
        return summary

    def export_summary_text(self, lines):
        fname = f"hexwalk_{self.safe_basename()}_summary.txt"
        with open(fname, "w", encoding="utf-8") as f:
            for line in lines:
                f.write(line + "\n")
    
        h, w = self.stdscr.getmaxyx()
        msg = f"Summary exported to {fname}"
        self.stdscr.addstr(
            h - 2,
            0,
            msg[:w - 1],
            curses.A_BOLD | curses.color_pair(COLOR_STATUS)
        )
        self.stdscr.refresh()
        curses.napms(1200)

    def show_summary(self):
        summary = self.build_summary()
        lines = []

        total_hits = sum(cat["total"] for cat in summary.values())
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        lines.append("HexWalk Summary")
        lines.append("=" * 15)
        lines.append("")
        lines.append(f"Analyzed file : {self.filename}")
        lines.append(f"Generated     : {ts}")
        lines.append("")
        lines.append(f"Total categories : {len(summary)}")
        lines.append(f"Total hits       : {total_hits}")
        lines.append("")
    
        for category in sorted(summary.keys()):
            cat_name = self.format_category_name(category)
            cat_data = summary[category]
    
            lines.append(f"Category: {cat_name} ({cat_data['total']} hits)")
            lines.append("-" * (len(lines[-1])))
    
            for kw, cnt in sorted(
                cat_data["keywords"].items(),
                key=lambda x: x[1],
                reverse=True
            ):
                lines.append(f"  {kw:<20} : {cnt}")
    
            lines.append("")
    
        # ---- Screen loop ----
        offset = 0
        while True:
            self.stdscr.clear()
            h, w = self.stdscr.getmaxyx()
    
            for i in range(h - 1):
                idx = offset + i
                if idx >= len(lines):
                    break
                self.stdscr.addstr(
                    i,
                    0,
                    lines[idx][:w - 1]
                )
    
            status = "[ q ] back   [ e ] export summary to text"
            self.stdscr.addstr(
                h - 1,
                0,
                status[:w - 1],
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )
    
            self.stdscr.refresh()
            key = self.stdscr.getch()
    
            if key in (ord("q"), 27):
                break
            elif key == ord("e"):
                self.export_summary_text(lines)
            elif key == curses.KEY_DOWN:
                offset = min(offset + 1, max(0, len(lines) - h + 1))
            elif key == curses.KEY_UP:
                offset = max(0, offset - 1)

    def visible_category_rows(self):
        rows = []

        for domain in self.category_tree:
            rows.append(domain)
            if domain["expanded"]:
                for sub in domain["children"]:
                    rows.append(sub)
                    if sub["expanded"]:
                        rows.extend(sub["children"])

        return rows

    def current_category_selection(self):
        rows = self.visible_category_rows()
        if not rows:
            return None
    
        node = rows[self.cat_i]
    
        if node["type"] == "domain":
            return {
                "mode": "domain",
                "domain": node["name"],
            }
    
        if node["type"] == "subcategory":
            return {
                "mode": "subcategory",
                "category": f"{node['parent']}/{node['name']}",
            }
    
        if node["type"] == "keyword":
            return {
                "mode": "keyword",
                "category": node["parent"],
                "keyword": node["name"],
            }

    def clamp_category_index(self):
        rows = self.visible_category_rows()
        if not rows:
            self.cat_i = 0
            return

        self.cat_i = max(0, min(self.cat_i, len(rows) - 1))

    # ---------------- MODAL -----------------
    def show_hit_modal(self, hits, start_index):
        h, w = self.stdscr.getmaxyx()
    
        # ---------- Modal geometry ----------
        modal_h = min(37, h - 4)
        modal_w = min(120, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2
    
        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)
    
        # ---------- Layout constants ----------
        BYTES_PER_LINE = 16
        GROUP_SIZE = 8
        GROUP_GAP = 1
    
        INFO_LINES = 4
        INFO_PAD = 2
        STATUS_LINES = 1
        BORDER_LINES = 2

        def align_offset(off):
            return off - (off % BYTES_PER_LINE)

        def hex_col_for_byte(j):
            """
            Return column offset (relative to start of hex field)
            for byte index j, respecting GROUP_SIZE and GROUP_GAP.
            """
            group = j // GROUP_SIZE
            offset_in_group = j % GROUP_SIZE

            return (
                group * (GROUP_SIZE * 3 + GROUP_GAP + 1) +
                offset_in_group * 3
            )
    
        HEX_LINES = (
            modal_h
            - BORDER_LINES
            - INFO_LINES
            - INFO_PAD
            - STATUS_LINES
        )
    
        # ---------- Hex width calculation ----------
        groups = (BYTES_PER_LINE + GROUP_SIZE - 1) // GROUP_SIZE
        hex_width = (
            BYTES_PER_LINE * 3 - 1 +
            (groups - 1) * GROUP_GAP
        )
    
        data = self.binary
        idx = start_index
        total = len(hits)
    
        # Initial view offset
        offset = hits[idx]["context"]["offset"]
        view_offset = align_offset(max(0, offset - (HEX_LINES // 2) * BYTES_PER_LINE))
    
        while True:
            hit = hits[idx]
            offset = hit["context"]["offset"]
            match_len = hit["match_len"]
    
            win.clear()
            draw_box(win, modal_h, modal_w, self.box)
    
            # ---------- Info block ----------
            info = [
                f"Offset       : 0x{offset:08X}",
                f"Match type   : {hit['match_type']}",
                f"Match key    : {hit['match_key']}",
                f"String length: {match_len}",
            ]
    
            for i, line in enumerate(info):
                win.addstr(
                    1 + i,
                    2,
                    line[:modal_w - 4],
                    curses.A_BOLD | curses.color_pair(COLOR_CAT),
                )
    
            sep_y = 1 + INFO_LINES
            safe_hline(win, sep_y, 1, modal_w - 2, self.box["h"])
    
            # ---------- Hex view ----------
            hex_y = sep_y + INFO_PAD
    
            for i in range(HEX_LINES):
                line_start = view_offset + i * BYTES_PER_LINE
                if line_start >= len(data):
                    break
    
                chunk = data[line_start:line_start + BYTES_PER_LINE]
    
                # ---- Build grouped hex ----
                hex_chunks = []
                for j, b in enumerate(chunk):
                    hex_chunks.append(f"{b:02X}")
                    if (
                        (j + 1) % GROUP_SIZE == 0
                        and (j + 1) < BYTES_PER_LINE
                    ):
                        hex_chunks.append(" " * GROUP_GAP)
    
                hex_part = " ".join(hex_chunks).ljust(hex_width)
    
                ascii_part = "".join(
                    chr(b) if 32 <= b <= 126 else "."
                    for b in chunk
                )
    
                base_line = f"{line_start:08X}  {hex_part}  {ascii_part}"
    
                win.addstr(
                    hex_y + i,
                    2,
                    base_line[:modal_w - 4],
                    curses.color_pair(COLOR_CAT),
                )
    
                # ---------- Highlight matching bytes (line-safe) ----------
                match_start = offset
                match_end = offset + match_len
                
                line_start_abs = line_start
                line_end_abs = line_start + len(chunk)
                
                # Compute overlap between match and this line
                highlight_start = max(match_start, line_start_abs)
                highlight_end = min(match_end, line_end_abs)
                
                if highlight_start < highlight_end:
                    for abs_pos in range(highlight_start, highlight_end):
                        j = abs_pos - line_start_abs
                        group_index = j // GROUP_SIZE
                
                        # Hex highlight
                        HEX_START_X = 2 + 10  # offset + two spaces
                        hex_x = HEX_START_X + hex_col_for_byte(j)

                        win.addstr(
                            hex_y + i,
                            hex_x,
                            f"{chunk[j]:02X}",
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )
                
                        # ASCII highlight
                        ascii_x = (
                            2
                            + 10
                            + hex_width
                            + 3
                            + j
                        )
                        win.addstr(
                            hex_y + i,
                            ascii_x,
                            ascii_part[j],
                            curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD,
                        )
    
            # ---------- Status ----------
            status = f"<- -> navigate | ↑↓ scroll | q close  ({idx + 1}/{total})"
            win.addstr(
                modal_h - 2,
                2,
                status[:modal_w - 4],
                curses.A_BOLD | curses.color_pair(COLOR_STATUS),
            )
    
            win.refresh()
    
            # ---------- Input ----------
            key = win.getch()
    
            if key in (ord("q"), 27):
                break
    
            elif key == curses.KEY_UP:
                view_offset = align_offset( max(0, view_offset - BYTES_PER_LINE) )

            elif key == curses.KEY_DOWN:
                view_offset = align_offset( min( max(0, len(data) - BYTES_PER_LINE), view_offset + BYTES_PER_LINE,) )
    
            elif key == curses.KEY_RIGHT:
                if idx < total - 1:
                    idx += 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = align_offset(max( 0, offset - (HEX_LINES // 2) * BYTES_PER_LINE) )
    
            elif key == curses.KEY_LEFT:
                if idx > 0:
                    idx -= 1
                    offset = hits[idx]["context"]["offset"]
                    view_offset = align_offset( max( 0, offset - (HEX_LINES // 2) * BYTES_PER_LINE) )

    # ---------------- HELP -----------------
    def show_help(self):
        h, w = self.stdscr.getmaxyx()
    
        # ---------- Modal geometry ----------
        modal_h = min(37, h - 4)
        modal_w = min(120, w - 4)
        modal_y = (h - modal_h) // 2
        modal_x = (w - modal_w) // 2
    
        win = self.stdscr.subwin(modal_h, modal_w, modal_y, modal_x)
        win.keypad(True)
    
        # ---------- Help text ----------
        lines = [
            "HexWalk — Interactive Binary Analysis",
            "",
            "Panes:",
            "  Categories  : Domain / Subcategory / Keyword tree",
            "  Hits        : Matching contexts for selection",
            "  Details     : Hex + ASCII view of hit",
            "",
            "Global Navigation:",
            "  Tab            : Switch pane (Categories ↔ Hits)",
            "  Arrow Up/Down  : Move selection in active pane",
            "",
            "Tree Navigation (Categories pane):",
            "  Enter          : Expand / collapse domain or subcategory",
            "  Enter on key   : Collapse to subcategory (restore position)",
            "  Right Arrow    : Expand current node",
            "  Left Arrow     : Collapse current node",
            "  +              : Expand entire tree",
            "  -              : Collapse entire tree",
            "",
            "Hits & Inspection:",
            "  Enter          : Open hit inspection modal (Hits pane)",
            "  Arrow Up/Down  : Navigate between hits",
            "",
            "Filtering:",
            "  /              : Filter keywords globally (tree + counts)",
            "                   (active filter shown in header)",
            "",
            "Actions:",
            "  s              : Show summary page",
            "  e              : Export findings to JSON",
            "  d              : Toggle details pane",
            "  [ / ]          : Resize details pane",
            "",
            "Help & Exit:",
            "  h              : Show this help",
            "  q / Esc        : Close help",
        ]
    
        # ---------- Scrolling ----------
        offset = 0
        visible_h = modal_h - 4  # borders + title + status
    
        while True:
            win.clear()
            draw_box(win, modal_h, modal_w, self.box)
    
            # ---------- Title ----------
            title = " Help "
            win.addstr(
                0,
                max(2, (modal_w - len(title)) // 2),
                title,
                curses.A_BOLD
            )
    
            # ---------- Content ----------
            for i in range(visible_h):
                idx = offset + i
                if idx >= len(lines):
                    break
                win.addstr(
                    1 + i,
                    2,
                    lines[idx][: modal_w - 4]
                )
    
            # ---------- Status ----------
            status = "↑↓ scroll | PgUp/PgDn | q / Esc close"
            win.addstr(
                modal_h - 2,
                2,
                status[: modal_w - 4],
                curses.A_BOLD | curses.color_pair(COLOR_STATUS),
            )
    
            win.refresh()
    
            key = win.getch()
    
            if key in (ord("q"), 27, 10, 13):
                break
    
            elif key == curses.KEY_DOWN:
                offset = min(offset + 1, max(0, len(lines) - visible_h))
    
            elif key == curses.KEY_UP:
                offset = max(0, offset - 1)
    
            elif key == curses.KEY_NPAGE:  # Page Down
                offset = min(
                    offset + visible_h,
                    max(0, len(lines) - visible_h)
                )
    
            elif key == curses.KEY_PPAGE:  # Page Up
                offset = max(0, offset - visible_h)

    # ---------------- HITS COUNT -----------------
    def category_hit_count(self, category):
        hits = self.findings.get(category, [])
        if not self.filter_text:
            return len(hits)
        ft = self.filter_text.lower()
        return sum(1 for h in hits if ft in h["string"].lower())

    # ---------------- CATEGORY NAME -----------------
    def format_category_name(self, name):
        base = os.path.splitext(name)[0]   # remove .txt (or any extension)
        if not base:
            return name
        return base[0].upper() + base[1:]

    # ---------------- EXPORT -----------------
    def exportable_findings(self):
        """
        Return a JSON-safe version of findings.
        Raw bytes are converted to hex strings.
        """
        out = {}
    
        for category, hits in self.findings.items():
            out[category] = []
            for h in hits:
                clean = dict(h)
    
                # Fix context
                ctx = dict(clean.get("context", {}))
                if "bytes" in ctx:
                    ctx["bytes_hex"] = ctx["bytes"].hex()
                    del ctx["bytes"]
    
                clean["context"] = ctx
                out[category].append(clean)
    
        return out

    # ---------------- DRAW -----------------
    def draw(self):
        self.stdscr.clear()
        h, w = self.stdscr.getmaxyx()
        if w < 20 or h < 5:
            self.stdscr.clear()
            self.stdscr.addstr(0, 0, "Terminal too small")
            self.stdscr.refresh()
            return
    
        if self.pane not in (0, 1):
            self.pane = 0
    
        self.clamp_category_scroll()
        self.clamp_category_index()
    
        # ---------- Layout constants ----------
        HITS_MIN_W = 10
        DETAILS_MIN_W = 50
        SEP_PAD = 1
    
        # ---------- Initial widths ----------
        cat_w = max(1, CAT_W)
        details_w = self.details_width if self.details_visible else 0
    
        cat_x = 0
        hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))
    
        if self.details_visible and hits_w < HITS_MIN_W:
            details_w = max(
                DETAILS_MIN_W,
                details_w - (HITS_MIN_W - hits_w)
            )
            details_w = max(0, details_w)
            hits_w = max(1, w - cat_w - details_w - 2 * (1 + SEP_PAD))
    
        if hits_w < HITS_MIN_W:
            details_w = 0
            self.details_visible = False
            hits_w = w - cat_w - (1 + SEP_PAD)
    
        # ---------- X positions ----------
        sep1_x = cat_x + cat_w + SEP_PAD
        hits_x = sep1_x + 1 + SEP_PAD
    
        sep2_x = hits_x + hits_w + SEP_PAD if details_w else None
        details_x = sep2_x + 1 + SEP_PAD if sep2_x is not None else None
    
        # ---------- Compute hits ----------
        hits = self.filtered_hits() or []
        if self.hit_i >= len(hits):
            self.hit_i = max(0, len(hits) - 1)
    
        # ---------- Clear panes ----------
        for y in range(0, h - 1):
            if cat_x + cat_w <= w:
                self.stdscr.addstr(y, cat_x, " " * cat_w)
            if hits_x + hits_w <= w:
                self.stdscr.addstr(y, hits_x, " " * hits_w)
            if self.details_visible and details_w > 0 and details_x + details_w <= w:
                self.stdscr.addstr(y, details_x, " " * details_w)
    
        # ---------- Vertical separators ----------
        for y in range(0, h - 1):
            if sep1_x < w:
                self.stdscr.addch(y, sep1_x, self.box["v"])
            if self.details_visible and sep2_x is not None and sep2_x < w:
                self.stdscr.addch(y, sep2_x, self.box["v"])
    
        # ---------- Top Header ----------
        header = " " + self.format_top_header()
        self.draw_top_header(header)
    
        # ==========================================================
        # Categories (WITH SCROLLING)
        # ==========================================================
        rows = self.visible_category_rows()
        cat_height = h - 3  # top header + pane header + status bar

        dw = self.count_widths['domain']
        sw = self.count_widths['subcategory']
        kw = self.count_widths['keyword']
    
        # ---- Scroll handling (NEW) ----
        if self.cat_i < self.cat_offset:
            self.cat_offset = self.cat_i
        elif self.cat_i >= self.cat_offset + cat_height:
            self.cat_offset = self.cat_i - cat_height + 1
    
        # Header
        self.draw_header(1, cat_x, cat_w, "Categories")
    
        for row in range(cat_height):
            idx = self.cat_offset + row
            if idx >= len(rows):
                break
    
            node = rows[idx]

            # ---- default attributes (always defined) ----
            attr = curses.color_pair(COLOR_CAT)
            label = ""
            
            if node["type"] == "domain":
                arrow = (
                    self.arrows["expanded"]
                    if node["expanded"]
                    else self.arrows["collapsed"]
                )

                label = f"{arrow} [{node['count']:>{dw}}] {node['display']}"
                attr |= curses.A_BOLD
            
            elif node["type"] == "subcategory":
                arrow = (
                    self.arrows["expanded"]
                    if node["expanded"]
                    else self.arrows["collapsed"]
                )

                label = f"  {arrow} [{node['count']:>{sw}}] {node['display']}"
            
            elif node["type"] == "keyword":
                label = f"      [{node['count']:>{kw}}] {node['name']}"
                attr |= curses.A_ITALIC
            
            if idx == self.cat_i and self.pane == 0:
                attr |= curses.A_REVERSE
            
            # ---- selection highlight ----
            if idx == self.cat_i and self.pane == 0:
                attr |= curses.A_REVERSE
            
            self.stdscr.addstr(
                row + 2,
                cat_x,
                label[:cat_w].ljust(cat_w),
                attr
            )

        # ==========================================================
        # Hits (unchanged)
        # ==========================================================
        sel = self.current_category_selection()

        if not sel:
            title = "Hits"

        elif sel["mode"] == "domain":
            title = f"Hits — {sel['domain'].capitalize()}"

        elif sel["mode"] == "subcategory":
            title = f"Hits — {sel['category'].capitalize()}"

        elif sel["mode"] == "keyword":
            title = (
                f"Hits — {sel['category'].capitalize()} / {sel['keyword']}"
            )

        else:
            title = "Hits"
    
        self.draw_header(1, hits_x, hits_w, title)
    
        hit_height = h - 3
    
        if self.hit_i < self.hit_offset:
            self.hit_offset = self.hit_i
        elif self.hit_i >= self.hit_offset + hit_height:
            self.hit_offset = self.hit_i - hit_height + 1
    
        for i in range(hit_height):
            idx = self.hit_offset + i
            if idx >= len(hits):
                break
    
            hit = hits[idx]
            text = hit["string"]
            kw = hit["match_key"]
    
            attr_normal = (
                curses.A_REVERSE
                if self.pane == 1 and idx == self.hit_i
                else curses.color_pair(COLOR_HIT)
            )
    
            attr_highlight = curses.color_pair(COLOR_HIGHLIGHT) | curses.A_BOLD
    
            visible = text[:hits_w - 1]
            pos = visible.lower().find(kw.lower())
    
            if pos >= 0:
                self.stdscr.addstr(i + 2, hits_x, visible[:pos], attr_normal)
                self.stdscr.addstr(
                    i + 2,
                    hits_x + pos,
                    visible[pos:pos + len(kw)],
                    attr_highlight
                )
                self.stdscr.addstr(
                    i + 2,
                    hits_x + pos + len(kw),
                    visible[pos + len(kw):].ljust(hits_w - pos - len(kw) - 1),
                    attr_normal
                )
            else:
                self.stdscr.addstr(
                    i + 2,
                    hits_x,
                    visible.ljust(hits_w - 1),
                    attr_normal
                )
    
        # ==========================================================
        # Details (unchanged)
        # ==========================================================
        if self.details_visible and details_w > 0:
            SAFE_W = max(1, details_w - 2)
            self.draw_header(1, details_x, details_w - 2, "Details")
    
            if hits:
                hit = hits[self.hit_i]
                offset = hit["context"]["offset"]
    
                od_lines = od_bc_view(
                    self.binary,
                    offset,
                    hit["match_key"],
                    context=32
                )
    
                for i, line in enumerate(od_lines[:h - 2]):
                    self.stdscr.addstr(
                        i + 2,
                        details_x,
                        line[:SAFE_W].ljust(SAFE_W),
                        curses.color_pair(COLOR_CAT)
                    )
    
        # ---------- Status bar ----------
        status = (
            "Tab pane | ↑↓ move | Enter expand/view | / filter | "
            "d toggle details | [ ] resize | e export | h help | q quit"
        )
    
        if w > 1:
            self.stdscr.addstr(
                h - 1,
                0,
                status[:w - 1].ljust(w - 1),
                curses.color_pair(COLOR_STATUS) | curses.A_BOLD
            )
    
        self.stdscr.refresh()

    # ---------------- MAIN LOOP -----------------
    def main_loop(self):
        while True:
            self.draw()
            key = self.stdscr.getch()
    
            # ==================================================
            # GLOBAL ACTIONS
            # ==================================================
            if key == ord("q"):
                if self.confirm_quit():
                    break
    
            elif key == ord("h"):
                self.show_help()

            # ==================================================
            # EXPAND / COLLAPSE ALL
            # ==================================================
            elif key == ord("+"):
                if self.pane == 0:
                    self.expand_all()
                    self.clamp_category_index()
                    self.clamp_category_scroll()
            
            elif key == ord("-"):
                if self.pane == 0:
                    self.collapse_all()
                    self.clamp_category_index()
                    self.clamp_category_scroll()
    
            # ==================================================
            # CATEGORY LEFT RIGHT NAVIGATION
            # ==================================================
            if self.pane == 0 and key in ( curses.KEY_RIGHT, curses.KEY_LEFT):
                rows = self.visible_category_rows()
                if not rows:
                    continue
            
                node = rows[self.cat_i]
            
                # RIGHT = expand
                if key == curses.KEY_RIGHT:
                    if node["type"] in ("domain", "subcategory") and not node["expanded"]:
                        node["expanded"] = True
            
                        # Restore last keyword position for subcategory
                        if node["type"] == "subcategory":
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                                self.cat_i = self.subcategory_keyword_state[key_id]
            
                        self.clamp_category_index()
                        self.clamp_category_scroll()
            
                # LEFT = collapse
                elif key == curses.KEY_LEFT:
                    if node["type"] in ("domain", "subcategory") and node["expanded"]:
                        node["expanded"] = False
                        self.clamp_category_index()
                        self.clamp_category_scroll()
            
                    elif node["type"] == "keyword":
                        # Collapse keyword → go to parent subcategory
                        parent = node["parent"]
                        domain, subcat = parent.split("/", 1)
            
                        self.subcategory_keyword_state[parent] = self.cat_i
            
                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx
            
                        self.clamp_category_index()
                        self.clamp_category_scroll()

            # ==================================================
            # ENTER — ACTIVATE / TOGGLE (MUST BE EARLY)
            # ==================================================
            elif key in (10, 13, curses.KEY_ENTER):
                if self.pane == 0:
                    rows = self.visible_category_rows()
                    if not rows:
                        continue
    
                    node = rows[self.cat_i]
    
                    # ---- Domain / Subcategory toggle ----
                    if node["type"] in ("domain", "subcategory"):
                        node["expanded"] = not node["expanded"]
    
                        # restore keyword position when expanding subcategory
                        if node["expanded"] and node["type"] == "subcategory":
                            key_id = f"{node['parent']}/{node['name']}"
                            if key_id in self.subcategory_keyword_state:
                                self.cat_i = self.subcategory_keyword_state[key_id]
    
                    # ---- Keyword → collapse back to subcategory ----
                    elif node["type"] == "keyword":
                        parent_cat = node["parent"]
                        domain, subcat = parent_cat.split("/", 1)
    
                        # remember keyword cursor position
                        self.subcategory_keyword_state[parent_cat] = self.cat_i
    
                        # collapse subcategory
                        for n in rows:
                            if (
                                n["type"] == "subcategory"
                                and n["parent"] == domain
                                and n["name"] == subcat
                            ):
                                n["expanded"] = False
                                break
    
                        # jump cursor to subcategory
                        idx = self.find_subcategory_row_index(domain, subcat)
                        if idx is not None:
                            self.cat_i = idx
    
                    self.clamp_category_index()
                    self.clamp_category_scroll()
    
                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.show_hit_modal(hits, self.hit_i)
    
            # ==================================================
            # TAB — SWITCH PANE
            # ==================================================
            elif key == 9:  # TAB
                self.pane = 1 if self.pane == 0 else 0
    
            # ==================================================
            # NAVIGATION
            # ==================================================
            elif key == curses.KEY_DOWN:
                if self.pane == 0:
                    self.cat_i += 1
                    self.clamp_category_index()
                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.hit_i = min(self.hit_i + 1, len(hits) - 1)
    
            elif key == curses.KEY_UP:
                if self.pane == 0:
                    self.cat_i -= 1
                    self.clamp_category_index()
                elif self.pane == 1:
                    hits = self.filtered_hits()
                    if hits:
                        self.hit_i = max(self.hit_i - 1, 0)
    
            # ==================================================
            # FILTER
            # ==================================================
            elif key == ord("/"):
                curses.echo()
                self.stdscr.addstr(0, 0, "Filter: ")
                self.tree_filter = self.stdscr.getstr().decode().strip()
                curses.noecho()
    
                # rebuild tree with filter applied
                self.category_tree = self.build_domain_tree()
                self.recompute_count_widths()
                self.cat_i = 0
                self.cat_offset = 0
                self.hit_i = 0
                self.hit_offset = 0
    
            # ==================================================
            # SUMMARY / EXPORT
            # ==================================================
            elif key == ord("s"):
                self.show_summary()
    
            elif key == ord("e"):
                fname = f"hexwalk_{self.safe_basename()}_export.json"
                with open(fname, "w") as f:
                    json.dump(self.exportable_findings(), f, indent=2)
    
                h, w = self.stdscr.getmaxyx()
                msg = f"Exported to {fname}"
                self.stdscr.addstr(
                    h - 2,
                    0,
                    msg[:w - 1],
                    curses.A_BOLD | curses.color_pair(COLOR_STATUS),
                )
                self.stdscr.refresh()
                curses.napms(800)
    
            # ==================================================
            # DETAILS PANE TOGGLES
            # ==================================================
            elif key == ord("d"):
                self.details_visible = not self.details_visible
    
            elif key == ord("["):
                self.details_width = max(20, self.details_width - 4)
    
            elif key == ord("]"):
                self.details_width = min(120, self.details_width + 4)

# ---------------- PROGRESS BAR -----------------

def print_progress(pct):
    width = 40
    filled = int(width * pct)
    bar = "#" * filled + "-" * (width - filled)
    print(f"\rScanning: [{bar}] {pct*100:5.1f}%", end="", flush=True)

# ---------------- MAIN -----------------
def main():
    parser = argparse.ArgumentParser(
        description="Hexwalk – binary keyword scanner"
    )

    parser.add_argument(
        "file",
        help="File to analyze (binary or Intel HEX)",
    )

    parser.add_argument(
        "--summary",
        action="store_true",
        help="Write summary file and exit (no TUI)",
    )

    parser.add_argument(
        "--export",
        action="store_true",
        help="Write JSON export file and exit (no TUI)",
    )

    parser.add_argument(
        "--show-all",
        action="store_true",
        help="Show all domains, subcategories, and keywords even if no hits are found",
    )

    args = parser.parse_args()

    file_path = args.file
    filename = os.path.basename(file_path)

    # ---------- Load binary ----------
    if is_hex_file(file_path):
        binary = hex_to_bin(file_path)
    else:
        binary = load_binary(file_path)

    # ==================================================
    # NON-INTERACTIVE MODE (NO CURSES)
    # ==================================================
    if args.summary or args.export:
        matches = search_keywords(binary, progress_cb=None)

        if not matches:
            print("No matches found.")
            sys.exit(0)

        if args.export:
            out = write_export(matches, filename, file_path)
            print(f"Wrote export: {out}")

        if args.summary:
            summary = generate_summary_text(matches, filename, file_path)
            out = write_summary(summary, filename)
            print(f"Wrote summary: {out}")

        sys.exit(0)

    # ==================================================
    # INTERACTIVE MODE (TUI-FIRST)
    # ==================================================
    curses.wrapper(
        lambda stdscr: HexwalkTUI(
            stdscr,
            binary=binary,
            filename=filename,
            file_path=file_path,
            show_all=args.show_all
        )
    )

    

if __name__=="__main__":
    main()

